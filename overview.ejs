<%
  // OVERVIEW — full left-sidebar layout matching the mock, warm beige/mustard theme.
  // Self-contained (its own sidebar + top bar, not the shared head/foot) — this is the
  // pilot for the sidebar shell we'll roll out to the other pages.
  // Data: cases, me, money() (from res.locals). Proximity-style bits run off case STAGE
  // (real closeness would leak the other side's figure).
  const openCases = cases.filter(c => !['settled','declined','closed'].includes(c.status));
  const settled   = cases.filter(c => c.status === 'settled');
  const noDeal    = cases.filter(c => ['closed','declined'].includes(c.status));
  const awaitingN = cases.filter(c => c.stage === 'awaiting').length;
  const biddingN  = cases.filter(c => c.stage === 'bidding').length;
  const mineC     = cases.filter(c => c.claimant_id === me.id);
  const sum = (a, k) => a.reduce((x, c) => x + (c[k] || 0), 0);
  const valueSettled = sum(settled, 'settled_value');
  const inPlay = sum(openCases, 'amount');
  const _cc = {}; cases.forEach(c => { const k = c.currency || 'GBP'; _cc[k] = (_cc[k]||0)+1; });
  const cur = Object.keys(_cc).sort((a,b) => _cc[b]-_cc[a])[0] || 'GBP';
  const decided = settled.length + noDeal.length;
  const settleRate = decided ? Math.round(settled.length / decided * 100) : 0;
  const now = new Date();
  const daysAgo = (d) => d ? (now - new Date(d)) / 86400000 : Infinity;
  const inMonth = (d) => { if (!d) return false; const t = new Date(d); return t.getMonth() === now.getMonth() && t.getFullYear() === now.getFullYear(); };
  const newThisWeek  = cases.filter(c => daysAgo(c.created_at) <= 7).length;
  const settled30    = settled.filter(c => daysAgo(c.settled_at) <= 30).length;
  const openedMonth  = cases.filter(c => inMonth(c.created_at)).length;
  const settledMonth = settled.filter(c => inMonth(c.settled_at)).length;
  const valueMonth   = sum(settled.filter(c => inMonth(c.settled_at)), 'settled_value');
  const days = settled.map(c => (c.settled_at && c.created_at) ? (new Date(c.settled_at) - new Date(c.created_at)) / 86400000 : null).filter(x => x != null && x >= 0);
  const avgDays = days.length ? (days.reduce((a,b) => a+b, 0) / days.length).toFixed(1) : null;
  const priority = openCases.slice().sort((a,b) => (b.amount||0)-(a.amount||0)).concat(settled).slice(0, 5);
  const openTop  = openCases.slice().sort((a,b) => (b.amount||0)-(a.amount||0)).slice(0, 4);
  const uname = (me && (me.company_name || me.username || me.name)) || 'Account';
  const initials = uname.replace(/[^A-Za-z ]/g,'').split(' ').filter(Boolean).slice(0,2).map(s => s[0].toUpperCase()).join('') || 'M';
  const activity = cases.slice().sort((a,b) => (b.id||0)-(a.id||0)).slice(0, 4).map(function (c) {
    if (c.status === 'settled') return {tone:'green', t:'Settled — ' + c.title, s:'Locked at the midpoint' + (c.settled_value != null ? ' · ' + money(c.settled_value, c.currency) : '')};
    if (c.stage === 'bidding')  return {tone:'cobalt', t:'Bidding open — ' + c.title, s:'Both sides submitting sealed figures'};
    if (c.stage === 'awaiting') return {tone:'amber', t:'Invitation sent — ' + c.title, s:'Waiting for the other side to join'};
    return {tone:'muted', t:c.title, s:'MB-' + c.id};
  });
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MidBid · Overview</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Hanken+Grotesk:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --paper:#fffdf6;--ink:#1f2540;--navy:#16213f;--muted:#6d6650;--faint:#9a8f72;--line:#e9dcbc;
    --cobalt:#2b54e6;--cobsoft:#edeffb;--green:#2f9e5f;--greend:#2a8a53;--greensoft:#e6f3e9;
    --amber:#cf8a1f;--ambersoft:#f6ebcf;--gold:#c69632;
    --side:#241f12;--side-2:#2f2716;
  }
  body{font-family:"Hanken Grotesk",system-ui,sans-serif;color:var(--ink);
    background:radial-gradient(1100px 500px at 60% -8%, #f9efc9 0%, #f3e8cd 55%, #eee1c0 100%);background-attachment:fixed;min-height:100vh;display:flex}
  .seam{position:fixed;top:0;left:0;right:0;height:3px;z-index:50;background:linear-gradient(90deg,#2b54e6,#2f9e5f 45%,#c69632)}

  /* Sidebar */
  .side{width:220px;flex:none;background:linear-gradient(180deg,var(--side),var(--side-2));color:#efe6cf;
    display:flex;flex-direction:column;position:sticky;top:0;height:100vh;border-right:1px solid #3a3320}
  .side .brand{display:flex;align-items:center;gap:11px;padding:20px 18px;border-bottom:1px solid #3a3320}
  .side .brand .m{width:30px;height:26px;position:relative;flex:none}
  .side .brand .m::before,.side .brand .m::after{content:"";position:absolute;top:2px;width:22px;height:22px;border-radius:50%;mix-blend-mode:screen}
  .side .brand .m::before{left:0;background:#4f78ff}
  .side .brand .m::after{right:0;background:#e8b23e}
  .side .brand span{font:600 1.15rem/1 "Fraunces",Georgia,serif;color:#fff}
  .side nav{flex:1;padding:14px 12px;display:flex;flex-direction:column;gap:4px}
  .side nav a{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;text-decoration:none;color:#c9bd9f;font:600 .88rem/1 "Hanken Grotesk",sans-serif;transition:background .15s,color .15s}
  .side nav a svg{width:19px;height:19px;flex:none}
  .side nav a:hover{background:rgba(230,201,120,.1);color:#fff}
  .side nav a.on{background:rgba(230,201,120,.16);color:#f4e6c0}
  .side .sep{height:1px;background:#3a3320;margin:10px 6px}
  .side .who{display:flex;align-items:center;gap:11px;padding:14px 16px;border-top:1px solid #3a3320}
  .side .who .av{width:34px;height:34px;border-radius:50%;background:rgba(230,201,120,.18);color:#e8cf8f;display:flex;align-items:center;justify-content:center;font:700 .8rem/1 "Spline Sans Mono",monospace;flex:none}
  .side .who .nm{font:600 .84rem/1.1 "Hanken Grotesk",sans-serif;color:#fff}
  .side .who .rl{font:400 .72rem/1 "Spline Sans Mono",monospace;color:#a79a78;margin-top:3px;text-transform:capitalize}
  .side form{margin:0}

  /* Main */
  .main{flex:1;min-width:0;display:flex;flex-direction:column}
  .topbar{display:flex;align-items:center;gap:14px;padding:14px 26px;border-bottom:1px solid var(--line);background:rgba(255,253,246,.6);backdrop-filter:blur(6px)}
  .search{flex:1;max-width:440px;position:relative}
  .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--faint)}
  .search input{width:100%;border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:9px 14px 9px 36px;font:inherit;font-size:.86rem;color:var(--ink)}
  .search input:focus{outline:none;border-color:var(--gold)}
  .tb-sp{flex:1}
  .exp{font:600 .74rem/1 "Spline Sans Mono",monospace;padding:9px 14px;border-radius:9px;border:1px solid #d8cba6;background:var(--paper);color:var(--muted);cursor:pointer}
  .exp:hover{border-color:var(--gold);color:#946e18}
  .newc{font:600 .78rem/1 "Hanken Grotesk",sans-serif;padding:9px 15px;border-radius:9px;background:var(--cobalt);color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--cobalt)}
  .newc:hover{background:#1e4fd0}.newc svg{width:15px;height:15px}

  .content{padding:22px 26px 40px;max-width:1240px;width:100%}
  .phead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:20px}
  .phead h1{font:500 1.75rem/1.1 "Fraunces",Georgia,serif;color:var(--navy);letter-spacing:-.01em}
  .phead p{color:var(--muted);font-size:.9rem;margin-top:6px}

  .kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:22px}
  .kpi{background:var(--paper);border:1px solid var(--line);border-top:3px solid var(--line);border-radius:14px;padding:15px 16px}
  .kpi.b{border-top-color:var(--cobalt)}.kpi.g{border-top-color:var(--green)}.kpi.m{border-top-color:var(--gold)}.kpi.n{border-top-color:#d8cba6}
  .kl{font:700 .58rem/1 "Spline Sans Mono",monospace;letter-spacing:.07em;text-transform:uppercase;color:var(--faint);margin-bottom:9px}
  .kv{font:600 1.6rem/1 "Fraunces",Georgia,serif;letter-spacing:-.01em;color:var(--navy);font-variant-numeric:tabular-nums}
  .kpi.b .kv{color:var(--cobalt)}.kpi.g .kv{color:var(--greend)}.kpi.m .kv{color:#a6791b}
  .ks{font-size:.73rem;color:var(--muted);margin-top:6px}

  .grid{display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start}
  .col{display:flex;flex-direction:column;gap:16px}
  .panel{background:var(--paper);border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .ph{display:flex;justify-content:space-between;align-items:center;padding:16px 18px 12px}
  .ph h2{font:500 1.05rem/1.2 "Fraunces",Georgia,serif;color:var(--navy)}
  .ph a{font:600 .72rem/1 "Hanken Grotesk",sans-serif;color:var(--cobalt);text-decoration:none}.ph a:hover{text-decoration:underline}
  .ph .priv{font:400 .72rem/1 "Spline Sans Mono",monospace;color:var(--faint)}
  .pb{padding:4px 18px 14px}

  .prow{display:flex;align-items:center;gap:14px;padding:14px 0;border-top:1px solid #f1e8cf}
  .prow:first-child{border-top:none}
  .spine{width:5px;height:42px;border-radius:999px;flex:none}
  .spine.awaiting{background:var(--amber)}.spine.bidding{background:var(--cobalt)}.spine.draft{background:#d8cba6}.spine.green{background:var(--green)}
  .pinfo{flex:1;min-width:0}
  .ptitle{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .ptitle .nm{font:500 1rem/1.2 "Fraunces",Georgia,serif;color:var(--navy)}
  .tag{font:700 .58rem/1 "Spline Sans Mono",monospace;letter-spacing:.05em;text-transform:uppercase;padding:4px 8px;border-radius:999px}
  .tag.awaiting{background:var(--ambersoft);color:#96640f}.tag.bidding{background:var(--cobsoft);color:var(--cobalt)}.tag.draft{background:#f0e8d2;color:var(--muted)}.tag.settled{background:var(--greensoft);color:var(--greend)}
  .pmeta{font:500 .78rem/1 "Spline Sans Mono",monospace;color:var(--muted);margin-top:6px}
  .pright{text-align:right;flex:none;display:none}
  .pright .a{font:500 .82rem/1.2 "Hanken Grotesk",sans-serif;color:var(--ink)}
  .pright .b{font:400 .72rem/1.2 "Spline Sans Mono",monospace;color:var(--faint);margin-top:3px}
  .pbtn{font:600 .68rem/1 "Hanken Grotesk",sans-serif;padding:7px 13px;border-radius:8px;border:1px solid #d8cba6;background:var(--paper);color:var(--cobalt);text-decoration:none;flex:none}
  .pbtn:hover{border-color:var(--cobalt)}
  .pbtn.go{background:var(--green);border-color:var(--green);color:#fff}.pbtn.go:hover{background:#268a4f}
  @media(min-width:640px){.pright{display:block}}

  .act{display:flex;gap:12px;padding:12px 0;border-top:1px solid #f1e8cf}.act:first-child{border-top:none}
  .adot{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex:none}.adot svg{width:17px;height:17px}
  .adot.green{background:var(--greensoft);color:var(--greend)}.adot.cobalt{background:var(--cobsoft);color:var(--cobalt)}.adot.amber{background:var(--ambersoft);color:#96640f}.adot.muted{background:#f0e8d2;color:var(--muted)}
  .at{font-size:.9rem;color:var(--ink)}.as{font:400 .76rem/1.3 "Spline Sans Mono",monospace;color:var(--faint);margin-top:3px}

  .scale .subt{font-size:.8rem;color:var(--muted);margin:0 0 14px;line-height:1.45}
  .prog{margin-bottom:13px}.prog:last-child{margin-bottom:0}
  .pl{display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:6px}
  .pl .lab{color:var(--muted);max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pl .st.c-cobalt{color:var(--cobalt);font-weight:600}.pl .st.c-amber{color:#96640f;font-weight:600}
  .bt{height:8px;border-radius:999px;background:#f1e8cf;overflow:hidden}.bt span{display:block;height:100%;border-radius:999px}
  .f-cobalt{background:linear-gradient(90deg,#5f80ee,var(--cobalt))}.f-amber{background:linear-gradient(90deg,#e6b25a,var(--amber))}
  .scale .go{margin-top:14px;display:block;text-align:center;font:600 .78rem/1 "Hanken Grotesk",sans-serif;color:var(--cobalt);text-decoration:none;padding:8px}

  .srow{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid #f1e8cf}.srow:first-child{border-top:none}
  .srow .sk{font-size:.86rem;color:var(--muted)}.srow .sv{font:600 .92rem/1 "Hanken Grotesk",sans-serif;color:var(--navy);font-variant-numeric:tabular-nums}.srow .sv.green{color:var(--greend)}

  .cta{background:linear-gradient(160deg,#2a2410,#4a3d17);border-radius:16px;padding:20px 22px;color:#fdf6e3}
  .cta h3{font:500 1.1rem/1.2 "Fraunces",Georgia,serif;margin-bottom:6px}
  .cta p{font-size:.86rem;color:rgba(253,246,227,.8);line-height:1.5;margin-bottom:14px}
  .cta a{display:block;text-align:center;font:600 .78rem/1 "Hanken Grotesk",sans-serif;padding:11px;border-radius:10px;background:var(--gold);color:#2a2410;text-decoration:none}.cta a:hover{background:#d8a83f}
  .empty{padding:26px 0;text-align:center;color:var(--muted);font-size:.9rem}.empty a{color:var(--cobalt);font-weight:600;text-decoration:none}

  @media(max-width:1000px){.kpis{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}
  @media(max-width:820px){
    .side{width:64px}.side .brand span,.side nav a .lbl,.side .who .nm,.side .who .rl{display:none}
    .side .brand{justify-content:center;padding:18px 0}.side nav a{justify-content:center}.side .who{justify-content:center}
    .search{display:none}
  }
</style>
</head>
<body>
<div class="seam"></div>

<aside class="side">
  <div class="brand"><span class="m"></span><span>MidBid</span></div>
  <nav>
    <a href="/overview" class="on"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span class="lbl">Overview</span></a>
    <a href="/analytics"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-6M22 20H2"/></svg><span class="lbl">Analytics</span></a>
    <div class="sep"></div>
    <a href="/account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg><span class="lbl">My account</span></a>
    <a href="/logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="lbl">Log out</span></a>
  </nav>
  <div class="who"><div class="av"><%= initials %></div><div><div class="nm"><%= uname %></div><div class="rl"><%= (me && me.account_type) ? me.account_type : 'individual' %></div></div></div>
</aside>

<div class="main">
  <div class="topbar">
    <div class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input type="text" placeholder="Search cases or counterparties…"></div>
    <div class="tb-sp"></div>
    <% if (mineC.length) { %><button type="button" class="exp" onclick="downloadMine()">&#8595; Export</button><% } %>
    <a class="newc" href="/cases/new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Open new case</a>
  </div>

  <div class="content">
    <div class="phead">
      <div><h1>Overview</h1><p>Your private settlement pipeline · Nothing leaks until figures meet.</p></div>
    </div>

    <div class="kpis">
      <div class="kpi b"><div class="kl">Active cases</div><div class="kv"><%= openCases.length %></div><div class="ks"><%= newThisWeek ? ('+' + newThisWeek + ' this week') : (awaitingN + ' awaiting · ' + biddingN + ' bidding') %></div></div>
      <div class="kpi g"><div class="kl">Settled (30d)</div><div class="kv"><%= settled30 %></div><div class="ks"><%= settleRate %>% success rate</div></div>
      <div class="kpi g"><div class="kl">Value settled</div><div class="kv"><%= money(valueSettled, cur) %></div><div class="ks">to date</div></div>
      <div class="kpi n"><div class="kl">Avg. days to settle</div><div class="kv"><%= avgDays != null ? avgDays : '—' %></div><div class="ks">from case opened</div></div>
      <div class="kpi m"><div class="kl">In bidding</div><div class="kv"><%= biddingN %></div><div class="ks">rounds in play</div></div>
    </div>

    <div class="grid">
      <div class="col">
        <div class="panel">
          <div class="ph"><h2>Priority cases</h2><a href="/cases">View all &rarr;</a></div>
          <div class="pb">
            <% if (priority.length === 0) { %><div class="empty">No cases yet — <a href="/cases/new">open your first dispute →</a></div><% } %>
            <% priority.forEach(function(c){
                 const settledRow = c.status === 'settled';
                 const mine = c.claimant_id === me.id;
                 let spine, tagCls, tag, rA, rB, act, actCls;
                 if (settledRow) { spine='green'; tagCls='settled'; tag='Settled'; rA=money(c.settled_value != null ? c.settled_value : c.amount, c.currency); rB='midpoint'; act = mine ? 'View' : 'Pay'; actCls = mine ? '' : 'go'; }
                 else if (c.stage === 'bidding') { spine='bidding'; tagCls='bidding'; tag='In bidding'; rA='Figures in play'; rB='adjust any time'; act='Open'; actCls=''; }
                 else if (c.stage === 'draft') { spine='draft'; tagCls='draft'; tag='Draft'; rA='Not sent yet'; rB=''; act='Open'; actCls=''; }
                 else { spine='awaiting'; tagCls='awaiting'; tag='Awaiting'; rA='Invitation sent'; rB='waiting to join'; act='Open'; actCls=''; }
                 const meta = settledRow ? ('MB-' + c.id + ' · settled at ' + money(c.settled_value != null ? c.settled_value : c.amount, c.currency)) : ('MB-' + c.id + ' · ' + money(c.amount, c.currency) + ' in dispute'); %>
              <div class="prow">
                <span class="spine <%= spine %>"></span>
                <div class="pinfo"><div class="ptitle"><span class="nm"><%= c.title %></span><span class="tag <%= tagCls %>"><%= tag %></span></div><div class="pmeta"><%= meta %></div></div>
                <div class="pright"><div class="a"><%= rA %></div><% if (rB) { %><div class="b"><%= rB %></div><% } %></div>
                <a class="pbtn <%= actCls %>" href="/cases/<%= c.id %>"><%= act %></a>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="panel">
          <div class="ph"><h2>Recent activity</h2></div>
          <div class="pb">
            <% if (activity.length === 0) { %><div class="empty">Activity will appear here as cases progress.</div><% } %>
            <% activity.forEach(function(a){ %>
              <div class="act">
                <span class="adot <%= a.tone %>">
                  <% if (a.tone === 'green') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4 4 10-10"/></svg>
                  <% } else if (a.tone === 'cobalt') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>
                  <% } else if (a.tone === 'amber') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                  <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg><% } %>
                </span>
                <div><p class="at"><%= a.t %></p><p class="as"><%= a.s %></p></div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="panel scale">
          <div class="ph"><h2>Your settlement scale</h2><span class="priv">Private</span></div>
          <div class="pb">
            <p class="subt">Only you see your figure. A case&rsquo;s colour follows its stage — never how close the other side is.</p>
            <% if (openTop.length === 0) { %><div class="empty">No open cases right now.</div><% } %>
            <% openTop.forEach(function(c){ const bidding = c.stage === 'bidding'; %>
              <div class="prog">
                <div class="pl"><span class="lab"><%= c.title %></span><span class="st <%= bidding ? 'c-cobalt' : 'c-amber' %>"><%= bidding ? 'In bidding' : 'Awaiting' %></span></div>
                <div class="bt"><span class="<%= bidding ? 'f-cobalt' : 'f-amber' %>" style="width:<%= bidding ? '64%' : '30%' %>"></span></div>
              </div>
            <% }); %>
            <% if (openTop.length) { %><a class="go" href="/cases/<%= openTop[0].id %>">Open active case &rarr;</a><% } %>
          </div>
        </div>

        <div class="panel">
          <div class="ph"><h2>This month</h2></div>
          <div class="pb">
            <div class="srow"><span class="sk">Cases opened</span><span class="sv"><%= openedMonth %></span></div>
            <div class="srow"><span class="sk">Settled</span><span class="sv green"><%= settledMonth %></span></div>
            <div class="srow"><span class="sk">Value settled</span><span class="sv green"><%= money(valueMonth, cur) %></span></div>
            <div class="srow"><span class="sk">In bidding now</span><span class="sv"><%= biddingN %></span></div>
          </div>
        </div>

        <div class="cta">
          <h3>Got a whole ledger?</h3>
          <p>Import disputes in bulk, set one bid bar across the lot, and let MidBid chase the quiet ones.</p>
          <a href="/cases">Open the ledger &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (mineC.length) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE), wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases'); XLSX.writeFile(wb,'midbid-overview.xlsx');
}
</script>
<% } %>
</body>
</html>

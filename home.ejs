  max-width: 56ch; margin-left: auto; margin-right: auto; line-height: var(--leading-normal);
}

.quotes { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
.quote {
  padding: 22px 18px; border-radius: 18px;
  background: var(--white); border: 1px solid var(--line);
}
.quote p {
  font-size: var(--text-base); line-height: var(--leading-normal); color: var(--ink2); margin-bottom: 14px;
  font-family: var(--font-display); font-weight: 500;
}
.quote .who { font-size: var(--text-sm); font-weight: 700; color: var(--ink); }
.quote .role { font-size: var(--text-sm); color: var(--mut2); }

.final {
  text-align: center; padding: 40px 28px; border-radius: 24px; margin-top: 56px;
  background: linear-gradient(145deg, #2c2620 0%, #3d5a80 55%, #4a6a8a 100%);

<script>
(function () {
  var bar = document.getElementById('valuebar');
  var scroller = document.getElementById('scroll');
  if (!bar || !scroller) return;
  var lastY = scroller.scrollTop || 0;
  var dock = 'bottom';         // start docked at the bottom
  var ticking = false;
  function setDock(next) {
    if (next === dock) return;
    dock = next;
    bar.classList.add('swap'); // fade out
    window.setTimeout(function () {
      bar.classList.toggle('dock-top', dock === 'top');
      bar.classList.toggle('dock-bottom', dock === 'bottom');
      bar.classList.remove('swap'); // fade back in at the new edge
    }, 150);
  }
  function onScroll() {
    var y = scroller.scrollTop;
    if (y < 0) y = 0;
    if (Math.abs(y - lastY) > 6) {          // small threshold to avoid jitter
      setDock(y > lastY ? 'bottom' : 'top'); // scrolling down -> bottom, up -> top
      lastY = y;
    }
    ticking = false;
  }
  scroller.addEventListener('scroll', function () {
    if (!ticking) { window.requestAnimationFrame(onScroll); ticking = true; }
  }, { passive: true });
})();
</script>

<script>
(function () {
  var MAX = 80000, MIN = 0;
  var track = document.getElementById('scale-track');
  var band = document.getElementById('scale-band');
  var hOwed = document.getElementById('handle-owed');
  var hOwe = document.getElementById('handle-owe');
  var amtOwed = document.getElementById('amt-owed');
  var amtOwe = document.getElementById('amt-owe');
  var meter = document.getElementById('scale-meter');
  var signal = document.getElementById('scale-signal');
  var signalText = document.getElementById('signal-text');
  if (!track || !hOwed || !hOwe) return;

  var valOwed = 58000, valOwe = 30000;

  function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
  function fmt(n) { return '£' + Math.round(n).toLocaleString('en-GB'); }
  function pct(v) { return (clamp(v, MIN, MAX) / MAX) * 100; }
  function validate(proposed) {
    return clamp(Math.round(clamp(proposed, MIN, MAX) / 100) * 100, MIN, MAX);
  }
  function analyse() {
    var accept = valOwed, pay = valOwe;
    var gap = accept - pay; // positive when still apart
    var absGap = Math.abs(accept - pay);
    var mid = (accept + pay) / 2;
    var relativeGap = mid > 0 ? absGap / mid : 0;
    var meets = accept <= pay; // figures meet / ranges overlap
    var close = !meets && relativeGap <= 0.12; // UI proximity signal only
    var state = meets ? 'meet' : (close ? 'close' : 'far');
    return { gap: absGap, relativeGap: relativeGap, midpoint: mid, meets: meets, state: state };
  }
  var scaleEl = document.querySelector('.scale');
  var boxOwed = document.querySelector('.side-box.owed');
  var boxOwe = document.querySelector('.side-box.owe');
  var lastOwed = valOwed, lastOwe = valOwe;

  function render() {
    var a = analyse();
    hOwed.style.left = pct(valOwed) + '%';
    hOwe.style.left = pct(valOwe) + '%';
    hOwed.setAttribute('aria-valuenow', Math.round(valOwed));
    hOwe.setAttribute('aria-valuenow', Math.round(valOwe));
    if (amtOwed.textContent !== fmt(valOwed)) {
      amtOwed.textContent = fmt(valOwed);
      amtOwed.classList.remove('tick'); void amtOwed.offsetWidth; amtOwed.classList.add('tick');
    }
    if (amtOwe.textContent !== fmt(valOwe)) {
      amtOwe.textContent = fmt(valOwe);
      amtOwe.classList.remove('tick'); void amtOwe.offsetWidth; amtOwe.classList.add('tick');
    }
    if (scaleEl) {
      scaleEl.classList.toggle('is-close', a.state === 'close');
      scaleEl.classList.toggle('is-meet', a.state === 'meet');
    }
    var lo = Math.min(pct(valOwed), pct(valOwe));
    var hi = Math.max(pct(valOwed), pct(valOwe));
    band.style.left = lo + '%';
    band.style.width = Math.max(1.5, hi - lo) + '%';
    band.classList.toggle('meet', a.meets);
    meter.querySelectorAll('span').forEach(function (el) {
      el.classList.remove('active', 'active-far', 'active-close', 'active-meet');
      if (el.getAttribute('data-state') === a.state) el.classList.add('active', 'active-' + a.state);
    });
    signal.className = 'signal ' + a.state;
    if (a.state === 'far') signalText.textContent = 'Far apart — gap ' + fmt(a.gap) + '. Nothing is disclosed.';
    else if (a.state === 'close') signalText.textContent = 'Getting close — gap ' + fmt(a.gap) + '. Still private.';
    else signalText.textContent = 'Figures meet — demo settlement at midpoint ' + fmt(a.midpoint) + '.';
  }
  function valueFromEvent(e) {
    var rect = track.getBoundingClientRect();
    var clientX = (e.touches && e.touches[0] ? e.touches[0].clientX : e.clientX);
    return clamp((clientX - rect.left) / rect.width, 0, 1) * MAX;
  }
  function bind(handle, which) {
    var dragging = false;
    function start(e) {
      e.preventDefault();
      dragging = true;
      handle.classList.add('dragging');
      if (boxOwed && boxOwe) {
        boxOwed.classList.toggle('active', which === 'owed');
        boxOwe.classList.toggle('active', which === 'owe');
      }
      move(e);
    }
    function move(e) {
      if (!dragging) return;
      if (e.cancelable) e.preventDefault();
      var next = validate(valueFromEvent(e));
      if (which === 'owed') valOwed = next; else valOwe = next;
      render();
    }
    function end() {
      dragging = false;
      handle.classList.remove('dragging');
      if (boxOwed) boxOwed.classList.remove('active');
      if (boxOwe) boxOwe.classList.remove('active');
      render();
    }
    handle.addEventListener('mousedown', start);
    handle.addEventListener('touchstart', start, { passive: false });
    window.addEventListener('mousemove', move);
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('mouseup', end);
    window.addEventListener('touchend', end);
    handle.addEventListener('keydown', function (e) {
      var step = e.shiftKey ? 2000 : 500, delta = 0;
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') delta = step;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') delta = -step;
      if (!delta) return;
      e.preventDefault();
      if (which === 'owed') valOwed = validate(valOwed + delta);
      else valOwe = validate(valOwe + delta);
      render();
    });
  }
  bind(hOwed, 'owed');
  bind(hOwe, 'owe');

  track.addEventListener('pointerdown', function (e) {
    if (e.target.classList.contains('handle')) return;
    var v = validate(valueFromEvent(e));
    var dOwed = Math.abs(v - valOwed);
    var dOwe = Math.abs(v - valOwe);
    if (dOwed <= dOwe) valOwed = v; else valOwe = v;
    render();
  });
  render();
})();
</script>
</body>
</html>

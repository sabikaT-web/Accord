<%# home.ejs — self-contained view (no partial includes), deploy to repo root, commit to main.
    Contains the new TOP of the homepage: nav + hero (with the private-figures scale on the right) + the guarantee card.
    Your existing sections (intro slider / value bar / industries / how-it-works / footer) drop into the marked slots below. %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MidBid — Bid blind. Settle on your terms.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#e8e6e0; --surface:#f7f3eb; --surface-2:#fbf8f1;
    --ink:#232019; --muted:#6f685c; --slate:#3d5a80;
    --gold:#c27803; --green:#4d7c5a; --line:#d9d3c6; --line-soft:#e6e0d4;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,sans-serif;line-height:1.55;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1200px;margin:0 auto;padding:0 44px}
  a{color:inherit;text-decoration:none}
  .eyebrow{font-family:"IBM Plex Mono",monospace;font-size:12.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
  .btn{display:inline-flex;align-items:center;gap:8px;font:inherit;font-size:14.5px;cursor:pointer;border-radius:10px;padding:11px 20px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
  .btn-primary{background:var(--slate);border-color:var(--slate);color:#fff;font-weight:600}
  .dotg{width:9px;height:9px;border-radius:999px;background:var(--green);display:inline-block}

  /* nav */
  .nav{display:flex;align-items:center;justify-content:space-between;padding:26px 0 0}
  .brand{display:flex;align-items:center;gap:11px;font-family:"Fraunces",serif;font-size:21px;font-weight:600}
  .brand svg{width:34px;height:29px}
  .navlinks{display:flex;align-items:center;gap:30px;font-size:14.5px;color:var(--muted)}
  .navlinks a:hover{color:var(--ink)}

  /* hero */
  .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;padding:56px 0 20px}
  .hero .eyebrow{display:block;margin:0 0 20px}
  .hero h1{font-family:"Fraunces",serif;font-weight:500;font-size:54px;line-height:1.04;letter-spacing:-.02em;margin:0 0 22px}
  .hero .lead{font-size:17px;color:var(--muted);margin:0 0 28px;max-width:500px}
  .hero .cta{display:flex;gap:12px}

  /* hero scale panel */
  .panel{background:linear-gradient(160deg,var(--surface-2),var(--surface));border:1px solid var(--line);border-radius:20px;padding:28px 30px;box-shadow:0 26px 50px -34px rgba(50,42,28,.5)}
  .panel .top{display:flex;justify-content:space-between;align-items:center}
  .p-tag{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .p-status{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--green);display:flex;align-items:center;gap:7px}
  .conv{position:relative;height:150px;margin:16px 0 6px}
  .conv .rail{position:absolute;left:8%;right:8%;top:50%;height:5px;border-radius:5px;background:#e7e0d1;transform:translateY(-50%)}
  .settle{position:absolute;top:50%;left:60%;width:24px;height:24px;border-radius:999px;transform:translate(-50%,-50%);
    background:rgba(77,124,90,.16);border:2px solid var(--green);opacity:0;transition:opacity .45s ease;box-shadow:0 0 0 8px rgba(77,124,90,.10)}
  .cdot{position:absolute;top:50%;width:20px;height:20px;border-radius:999px;transform:translate(-50%,-50%);left:16%}
  .cdot.a{background:var(--slate)}
  .cdot.b{background:var(--gold);left:84%}
  .p-legend{display:flex;justify-content:space-between;font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--muted);border-top:1px solid var(--line-soft);padding-top:16px;margin-top:8px}
  .p-caption{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.03em;color:#9a9280;margin-top:9px;text-align:center}

  /* guarantees */
  .guarantees{padding:64px 0}
  .gcard{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:14px 46px 20px;display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:center}
  .thesis{padding:30px 0}
  .thesis .eyebrow{display:block;margin:0 0 18px}
  .thesis h2{font-family:"Fraunces",serif;font-weight:500;font-size:33px;line-height:1.18;margin:0;letter-spacing:-.01em}
  .thesis h2 .soft{color:var(--muted)}
  .g-row{display:grid;grid-template-columns:104px 1fr;gap:28px;align-items:center;padding:24px 0;border-top:1px solid var(--line-soft)}
  .g-row:last-child{border-bottom:1px solid var(--line-soft)}
  .g-art{width:104px;height:56px}
  .g-kicker{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);margin:0 0 7px}
  .g-row p.g-text{font-family:"Fraunces",serif;font-weight:400;font-size:19px;line-height:1.4;margin:0;color:var(--ink)}
  .g-text b{font-weight:600}

  /* placeholder footer — replace with your existing footer */
  .foot{border-top:1px solid var(--line);margin-top:8px}
  .foot .wrap{display:flex;justify-content:space-between;align-items:center;padding-top:34px;padding-bottom:44px;color:var(--muted);font-size:13.5px}
  .foot .brand{font-size:18px}

  @media (max-width:900px){
    .wrap{padding:0 22px}
    .navlinks a:not(.btn){display:none}
    .hero,.gcard{grid-template-columns:1fr;gap:34px}
    .gcard{padding:26px 26px 10px}
    .g-row{grid-template-columns:1fr;gap:12px}
    .g-art{order:2}
    .hero h1{font-size:40px}
  }
  @media (prefers-reduced-motion:reduce){.settle{transition:none}}
</style>
</head>
<body>

  <%# logo mark — unique clipPath id to avoid colliding with any other logo in the page %>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="mb-logo" viewBox="0 0 48 40">
      <clipPath id="mb-lens-hero"><circle cx="19" cy="21" r="11"/></clipPath>
      <g clip-path="url(#mb-lens-hero)"><circle cx="29" cy="21" r="11" fill="#15B877" opacity="0.9"/></g>
      <circle cx="19" cy="21" r="11" fill="none" stroke="#2F6BFF" stroke-width="2.4"/>
      <circle cx="29" cy="21" r="11" fill="none" stroke="#F5B312" stroke-width="2.4"/>
      <circle cx="24" cy="6" r="2.3" fill="#2F6BFF"/><circle cx="24" cy="36" r="2.3" fill="#F5B312"/>
    </symbol>
  </svg>

  <%# ===== NAV ===== (point links at your real routes) %>
  <div class="wrap"><nav class="nav">
    <div class="brand"><svg><use href="#mb-logo"/></svg> MidBid</div>
    <div class="navlinks">
      <a href="#how">How it works</a>
      <a href="/fees">Pricing</a>
      <a href="/login">Log in</a>
      <a class="btn btn-primary" href="/cases/new">Open a case</a>
    </div>
  </nav></div>

  <%# ===== HERO ===== %>
  <header class="hero wrap">
    <div>
      <span class="eyebrow">Online mediation</span>
      <h1>Bid blind.<br>Settle on your terms.</h1>
      <p class="lead">Each party submits private figures the other never sees, round after round. The case settles the moment your figures meet — no lawyers, no courtroom, no showing your hand.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/cases/new">Open a case</a>
        <a class="btn" href="#how">See how it works</a>
      </div>
    </div>
    <div class="panel">
      <div class="top"><span class="p-tag">Round 3 · live</span><span class="p-status"><span class="dotg"></span> closing in</span></div>
      <div class="conv"><div class="rail"></div><div class="settle" id="settle"></div><div class="cdot a" id="dotA"></div><div class="cdot b" id="dotB"></div></div>
      <div class="p-legend"><span>You</span><span>Them</span></div>
      <div class="p-caption">Settles wherever your figures cross</div>
    </div>
  </header>

  <%# ===== GUARANTEES ===== %>
  <section class="guarantees wrap" id="how">
    <div class="gcard">
      <div class="thesis">
        <span class="eyebrow">Why it's fair</span>
        <h2>No tactics to learn, no leverage to lose. <span class="soft">Three fixed guarantees do the negotiating for you.</span></h2>
      </div>
      <div class="proof">
        <div class="g-row">
          <svg class="g-art" viewBox="0 0 104 56" fill="none" aria-hidden="true">
            <line x1="12" y1="28" x2="92" y2="28" stroke="#d9d3c6" stroke-width="2"/>
            <circle cx="42" cy="28" r="13" fill="#4d7c5a" opacity="0.14"/><circle cx="64" cy="28" r="13" fill="#4d7c5a" opacity="0.14"/>
            <circle cx="42" cy="28" r="5.4" fill="#3d5a80"/><circle cx="64" cy="28" r="5.4" fill="#c27803"/>
          </svg>
          <div><p class="g-kicker">Privacy</p><p class="g-text">Neither side sees the other's figure — only a <b>shared colour signal</b> when you're close.</p></div>
        </div>
        <div class="g-row">
          <svg class="g-art" viewBox="0 0 104 56" fill="none" aria-hidden="true">
            <rect x="33" y="15" width="38" height="28" rx="5" fill="#f7f3eb" stroke="#3d5a80" stroke-width="2"/>
            <path d="M43 15v-2.4a9 9 0 0 1 18 0V15" stroke="#3d5a80" stroke-width="2" fill="none"/>
            <circle cx="52" cy="29" r="3" fill="#c27803"/><rect x="50.6" y="30.6" width="2.8" height="7" rx="1.4" fill="#c27803"/>
          </svg>
          <div><p class="g-kicker">The bid</p><p class="g-text">One <b>sealed bid</b> per round — no probing, no anchoring, no games.</p></div>
        </div>
        <div class="g-row">
          <svg class="g-art" viewBox="0 0 104 56" fill="none" aria-hidden="true">
            <circle cx="40" cy="28" r="12" fill="none" stroke="#b9b1a1" stroke-width="2" stroke-dasharray="3 4"/>
            <circle cx="66" cy="28" r="12" fill="#c27803" opacity="0.12"/><circle cx="66" cy="28" r="12" fill="none" stroke="#c27803" stroke-width="2"/>
            <text x="66" y="32.5" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#c27803">£</text>
          </svg>
          <div><p class="g-kicker">The fee</p><p class="g-text">No settlement, no success fee — a modest fee to open a case, the rest <b>only if it resolves.</b></p></div>
        </div>
      </div>
    </div>
  </section>

  <%# ============================================================
      YOUR EXISTING SECTIONS GO HERE
      Paste the rest of your current home.ejs below this line —
      the industries section, how-it-works steps, final CTA, etc.
      (The intro slider + docking value bar live near the top of your
      current file; keep those as they are — they aren't in this file.)
      ============================================================ %>

  <%# ===== FOOTER (placeholder — swap for your existing footer) ===== %>
  <footer class="foot">
    <div class="wrap">
      <div class="brand"><svg style="width:26px;height:22px"><use href="#mb-logo"/></svg> MidBid</div>
      <div>Bid blind. Settle on your terms.</div>
    </div>
  </footer>

<script>
(function(){
  var A=document.getElementById('dotA'),B=document.getElementById('dotB'),S=document.getElementById('settle');
  if(!A) return;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){A.style.left='58%';B.style.left='63%';S.style.left='60%';S.style.opacity=1;return;}
  var targets=[37,66,45,72,54,29];  /* varied crossing points — never the same, rarely centre */
  var i=0;
  function cycle(){
    var t=targets[i%targets.length]; i++;
    A.style.transition='none'; B.style.transition='none'; S.style.opacity=0;
    A.style.left='16%'; B.style.left='84%';
    void A.offsetWidth;
    A.style.transition=B.style.transition='left 1.7s cubic-bezier(.45,0,.15,1)';
    requestAnimationFrame(function(){ A.style.left=t+'%'; B.style.left=t+'%'; });
    setTimeout(function(){ S.style.left=t+'%'; S.style.opacity=1; }, 1650);
    setTimeout(cycle, 4400);
  }
  cycle();
})();
</script>
</body>
</html>

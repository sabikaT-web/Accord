<%#
  MidBid homepage
  Usage (Express):  res.render('home', { title: 'MidBid — Bid blind. Settle on your terms.' })
  Optional locals:  signupUrl, businessUrl, privacyUrl, termsUrl, cookiesUrl, contactEmail
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== "undefined" && title ? title : "MidBid — Bid blind. Settle on your terms." %></title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #e8e6e0;
  --ink: #1a1612;
  --ink2: #2c2620;
  --mut: #6a6358;
  --mut2: #8a8278;
  --blue: #3d5a80;
  --blue-deep: #2c4a6e;
  --blue-soft: #e4eaf2;
  --gold: #c27803;
  --gold2: #e8a317;
  --gold-soft: #fef6e4;
  --green: #4d7c5a;
  --green2: #5f9a6e;
  --green-soft: #e8f0ea;
  --line: #ddd6c8;
  --white: #faf8f4;

  /* Type theme — 3 roles only */
  --font-sans: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-mono: "IBM Plex Mono", ui-monospace, monospace;

  /* Type scale (root 16px). Minimum readable UI: 14px; body: 16px */
  --text-xs: 0.75rem;    /* 12px — labels, uppercase only */
  --text-sm: 0.875rem;   /* 14px — secondary UI */
  --text-base: 1rem;     /* 16px — body */
  --text-md: 1.125rem;   /* 18px — lead */
  --text-lg: 1.25rem;    /* 20px — card titles */
  --text-xl: 1.5rem;     /* 24px — section sub */
  --text-2xl: clamp(1.75rem, 3vw, 2.25rem);  /* ~28–36 */
  --text-3xl: clamp(2rem, 4vw, 2.5rem);      /* hero */

  --leading-tight: 1.2;
  --leading-snug: 1.35;
  --leading-normal: 1.55;
  --leading-relaxed: 1.65;
  --tracking-label: 0.12em;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-sans);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  -webkit-font-smoothing: antialiased;
  overflow: hidden;              /* the inner .scroll region scrolls, not the page */
  --vb-h: 48px;
}
/* App shell: fixed nav, a scrolling content region, and the value bar as a real slot
   that reorders between top and bottom — so it never overlaps the content. */
.shell {
  height: 100vh; height: 100dvh;
  display: flex; flex-direction: column; overflow: hidden;
  position: relative; z-index: 1;
}
.scroll {
  order: 2; flex: 1 1 auto; min-height: 0;
  overflow-y: auto; overflow-x: hidden;
  scroll-behavior: smooth;
}
/* Value bar: a real flex slot (not an overlay). Docks bottom while scrolling down,
   flips above the content while scrolling up. Never overlaps content. */
.valuebar {
  flex: none; order: 3; height: var(--vb-h); z-index: 2;
  background: rgba(250,248,244,0.94);
  -webkit-backdrop-filter: saturate(1.1) blur(10px);
  backdrop-filter: saturate(1.1) blur(10px);
  transition: opacity 0.16s ease;
  will-change: opacity;
}
.valuebar.dock-bottom {
  order: 3;
  border-top: 1px solid var(--line);
  box-shadow: 0 -8px 24px -18px rgba(40,35,25,0.35);
}
.valuebar.dock-top {
  order: 1;
  border-bottom: 1px solid var(--line);
  box-shadow: 0 8px 24px -18px rgba(40,35,25,0.35);
}
.valuebar.swap { opacity: 0; }
.vb-inner {
  max-width: 1200px; height: 100%; margin: 0 auto; padding: 0 24px;
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.vb-item {
  display: flex; align-items: center; gap: 9px;
  font-size: var(--text-sm); font-weight: 600; color: var(--mut);
  white-space: nowrap;
}
.vb-item .vb-dot { width: 6px; height: 6px; border-radius: 50%; flex: none; background: var(--mut2); }
.vb-item:nth-child(1) .vb-dot { background: var(--blue); }
.vb-item:nth-child(2) .vb-dot { background: var(--gold2); }
.vb-item:nth-child(3) .vb-dot { background: var(--blue); }
.vb-item:nth-child(4) .vb-dot { background: var(--gold2); }
.vb-sep { width: 1px; height: 16px; background: var(--line); flex: none; }
@media (max-width: 760px) {
  body { --vb-h: 74px; }              /* taller band on mobile where items wrap to two rows */
  .valuebar { height: var(--vb-h); }
  .vb-sep { display: none; }
  .vb-inner { flex-wrap: wrap; justify-content: center; align-content: center; gap: 6px 18px; padding: 0 18px; }
  .vb-item { font-size: var(--text-xs); }
}
.stage { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.blob { position: absolute; border-radius: 50%; filter: blur(90px); }
.b1 { width: 480px; height: 480px; left: -12%; top: -14%; background: #d4c4a8; opacity: 0.42; }
.b2 { width: 380px; height: 380px; right: -10%; top: 18%; background: #a8b8d0; opacity: 0.3; }
.b3 { width: 300px; height: 300px; left: 30%; bottom: -8%; background: #e8c878; opacity: 0.26; }

.nav {
  order: 0; flex: none;
  position: relative; z-index: 20;
  width: 100%; max-width: 1200px; margin: 0 auto; padding: 16px 24px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}
.logo {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-display); font-weight: 600; font-size: var(--text-lg);
  letter-spacing: -0.02em; text-decoration: none; color: var(--ink);
}
.logo-mark { display: block; width: 40px; height: 34px; flex: none; }
.logo-mark svg { display: block; width: 100%; height: 100%; overflow: visible; }
.foot-logo-mark { width: 34px; height: 29px; flex: none; }
.foot-logo-mark svg { display: block; width: 100%; height: 100%; overflow: visible; }
.nav-links { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
.nav-links a {
  font-size: var(--text-sm); font-weight: 600; text-decoration: none; color: var(--mut);
  padding: 8px 12px; border-radius: 9px;
}
.nav-links a:hover { color: var(--ink); background: rgba(255,255,255,0.7); }
.nav-links a.cta {
  color: #fff; background: var(--blue);
  padding: 9px 16px; margin-left: 6px;
  box-shadow: 0 8px 20px -6px rgba(61,90,128,0.4);
}
.nav-links a.cta:hover { background: var(--blue-deep); color: #fff; }

.app {
  position: relative; z-index: 1;
  max-width: 1200px; margin: 0 auto; padding: 0 24px 80px;
}
.nav {
  max-width: 1200px;
}

.btn {
  font-weight: 700; font-size: var(--text-sm); padding: 12px 20px; border-radius: 12px;
  text-decoration: none; display: inline-flex; align-items: center; border: none;
  cursor: pointer; transition: filter 0.15s, transform 0.15s;
}
.btn:hover { filter: brightness(1.05); transform: translateY(-1px); }
.btn-blue {
  background: linear-gradient(145deg, var(--blue-deep), var(--blue)); color: #fff;
  box-shadow: 0 10px 26px -8px rgba(44,74,110,0.45);
}
.btn-gold {
  background: linear-gradient(145deg, var(--gold), var(--gold2)); color: #1c1917;
  box-shadow: 0 10px 26px -8px rgba(194,120,3,0.35);
}
.btn-ghost {
  background: var(--white); color: var(--ink2); border: 1.5px solid var(--line);
}

/* Split hero */
.hero-split {
  display: grid;
  grid-template-columns: 1.02fr 0.98fr;
  gap: 48px;
  align-items: center;
  margin: 40px 0 44px;
  width: 100%;
}
.hero-copy .ey {
  font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase;
  font-weight: 700; color: var(--blue);
}
.hero-copy h1 {
  font-family: var(--font-display); font-weight: 600;
  font-size: var(--text-3xl); letter-spacing: -0.03em; line-height: var(--leading-tight);
  margin: 12px 0 14px;
}
.hero-copy .lead {
  color: var(--mut); font-size: var(--text-md); line-height: var(--leading-relaxed);
  margin-bottom: 22px; max-width: none;
}
.hero-actions {
  display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px;
}
.pills { display: flex; flex-wrap: wrap; gap: 8px; }
.hero-features {
  list-style: none; display: grid; gap: 12px; margin-top: 6px;
}
.hero-features li {
  display: flex; align-items: flex-start; gap: 11px;
  font-size: var(--text-base); color: var(--ink2); line-height: var(--leading-snug);
}
.hero-features .fx {
  flex: none; width: 22px; height: 22px; border-radius: 7px; margin-top: 1px;
  display: grid; place-items: center;
  background: var(--blue-soft); color: var(--blue-deep);
  font-size: 12px; font-weight: 800;
}
.hero-features li:nth-child(2) .fx { background: var(--gold-soft); color: #92400e; }
.hero-features li:nth-child(3) .fx { background: #ece9e3; color: var(--ink2); }
.hero-features li strong { font-weight: 700; }
.hero-features li span.ft-sub { color: var(--mut); font-weight: 400; }
.pill {
  font-size: var(--text-xs); font-weight: 700; padding: 7px 12px; border-radius: 999px;
}
.pill.b { background: var(--blue-soft); color: var(--blue-deep); }
.pill.g { background: var(--gold-soft); color: #92400e; }
.pill.n { background: var(--green-soft); color: #2d4a34; }
.pill.m { background: #f0eeeb; color: var(--mut); }

/* Scale on right — interactive product surface */
.scale {
  padding: 26px 24px 22px;
  border-radius: 22px;
  background: var(--white);
  border: 1px solid var(--line);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.9) inset,
    0 24px 48px -16px rgba(40,35,25,0.14),
    0 0 0 1px rgba(61,90,128,0.05);
  position: relative; overflow: hidden;
  transition: box-shadow 0.35s ease, border-color 0.35s ease;
}
.scale.is-close {
  border-color: #e8c878;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.9) inset,
    0 24px 48px -16px rgba(40,35,25,0.14),
    0 0 0 1px rgba(232,163,23,0.2),
    0 0 40px -12px rgba(232,163,23,0.25);
}
.scale.is-meet {
  border-color: #a3c9ae;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.9) inset,
    0 24px 48px -16px rgba(40,35,25,0.12),
    0 0 0 1px rgba(79,124,90,0.25),
    0 0 48px -10px rgba(79,124,90,0.35);
}
.scale::before {
  content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--gold2), var(--green2), var(--blue));
  background-size: 200% 100%;
  animation: flow 5s ease-in-out infinite;
}
.scale.is-meet::before {
  background: linear-gradient(90deg, var(--green2), #86efac, var(--green2));
  animation: flow 2.5s ease-in-out infinite;
}
@keyframes flow {
  0%,100% { background-position: 0% 0; }
  50% { background-position: 100% 0; }
}
.scale-head { margin-bottom: 16px; }
.scale-head h2 {
  font-family: var(--font-display); font-weight: 600;
  font-size: var(--text-lg); margin-bottom: 4px; letter-spacing: -0.02em;
  line-height: var(--leading-snug);
}
.scale-head p { font-size: var(--text-sm); color: var(--mut); line-height: var(--leading-normal); }

.scale-sides {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px;
}
.side-box {
  padding: 14px; border-radius: 14px;
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.2s;
}
.side-box.owed { background: #fef6e4; border: 1.5px solid #e8c878; }
.side-box.owe { background: var(--blue-soft); border: 1.5px solid #c5d0dc; }
.side-box.active {
  box-shadow: 0 0 0 2px rgba(61,90,128,0.15);
  transform: translateY(-1px);
}
.side-box.owed.active { box-shadow: 0 0 0 2px rgba(232,163,23,0.35); }
.side-box.owe.active { box-shadow: 0 0 0 2px rgba(61,90,128,0.3); }
.side-box .label {
  font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-label);
  text-transform: uppercase; color: var(--mut2);
}
.side-box .role { font-size: var(--text-sm); color: var(--mut); margin-top: 2px; }
.side-box .amount {
  font-family: var(--font-mono);
  font-size: var(--text-xl); font-weight: 600; margin-top: 6px;
  transition: color 0.25s, transform 0.15s;
}
.side-box .amount.tick {
  transform: scale(1.04);
}
.side-box.owed .amount { color: var(--gold); }
.side-box.owe .amount { color: var(--blue); }

.track {
  height: 16px; border-radius: 12px;
  background: linear-gradient(180deg, #e8e4dc, #f5f2eb);
  border: 1px solid var(--line);
  position: relative; margin-bottom: 6px;
  box-shadow: inset 0 1px 3px rgba(40,35,25,0.08);
  cursor: pointer;
}
.band {
  position: absolute; left: 34%; width: 28%; height: 100%; border-radius: 12px;
  background: linear-gradient(90deg,
    rgba(232,163,23,0.55),
    rgba(95,154,110,0.5),
    rgba(61,90,128,0.5));
  transition: left 0.06s linear, width 0.06s linear, background 0.3s, box-shadow 0.3s;
}
.band.meet {
  background: linear-gradient(90deg, #5f9a6e, #86efac, #5f9a6e);
  background-size: 200% 100%;
  animation: bandShine 1.8s ease-in-out infinite;
  box-shadow: 0 0 20px rgba(79,124,90,0.45);
}
@keyframes bandShine {
  0%,100% { background-position: 0% 0; }
  50% { background-position: 100% 0; }
}
.handle {
  position: absolute; top: 50%; transform: translate(-50%, -50%);
  width: 28px; height: 28px; border-radius: 50%;
  border: 3px solid #fff;
  cursor: grab; touch-action: none; z-index: 2;
  transition: transform 0.12s ease, box-shadow 0.2s;
}
.handle::after {
  content: ""; position: absolute; inset: -8px; border-radius: 50%;
  border: 2px solid transparent;
  transition: border-color 0.2s, transform 0.2s;
}
.handle:hover { transform: translate(-50%, -50%) scale(1.1); }
.handle:hover::after { border-color: rgba(40,35,25,0.12); }
.handle.dragging {
  cursor: grabbing; transform: translate(-50%, -50%) scale(1.18);
  z-index: 3;
}
.handle.a {
  left: 34%;
  background: radial-gradient(circle at 35% 30%, #fde68a, var(--gold2));
  box-shadow: 0 0 0 0 rgba(232,163,23,0.4), 0 4px 12px rgba(15,23,42,0.18);
}
.handle.a.dragging, .handle.a:hover {
  box-shadow: 0 0 0 6px rgba(232,163,23,0.2), 0 6px 16px rgba(15,23,42,0.2);
}
.handle.b {
  left: 62%;
  background: radial-gradient(circle at 35% 30%, #b8cce0, var(--blue));
  box-shadow: 0 0 0 0 rgba(61,90,128,0.35), 0 4px 12px rgba(15,23,42,0.18);
}
.handle.b.dragging, .handle.b:hover {
  box-shadow: 0 0 0 6px rgba(61,90,128,0.18), 0 6px 16px rgba(15,23,42,0.2);
}
.handle:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
}
.scale-labs {
  display: flex; justify-content: space-between;
  font-size: var(--text-xs); font-family: var(--font-mono); color: var(--mut2);
  margin-bottom: 14px;
}
.meter {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; margin-bottom: 10px;
}
.meter span {
  text-align: center; font-size: var(--text-xs); font-weight: 600;
  padding: 8px 4px; border-radius: 10px;
  color: var(--mut2); background: #f8f6f1; border: 1px solid var(--line);
}
.meter span.active-far {
  background: #fef2f2; border-color: #fecaca; color: #b91c1c;
}
.meter span.active-close {
  background: #fef6e4; border-color: #e8c878; color: #92400e;
}
.meter span.active-meet {
  background: var(--green-soft); border-color: #a3c9ae; color: #2d4a34;
}
.signal {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 12px 14px; border-radius: 12px;
  font-size: var(--text-sm); font-weight: 600; line-height: var(--leading-snug);
  transition: background 0.3s, border-color 0.3s, color 0.3s, transform 0.25s;
}
.signal.meet {
  transform: scale(1.01);
}
.signal .dot {
  width: 8px; height: 8px; border-radius: 50%; flex: none; margin-top: 4px;
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%,100% { opacity: 1; } 50% { opacity: 0.45; }
}
.signal.far { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
.signal.far .dot { background: #ef4444; box-shadow: 0 0 8px #ef4444; }
.signal.close { background: #fef6e4; border: 1px solid #e8c878; color: #92400e; }
.signal.close .dot { background: var(--gold2); box-shadow: 0 0 8px var(--gold2); }
.signal.meet { background: var(--green-soft); border: 1px solid #a3c9ae; color: #2d4a34; }
.signal.meet .dot { background: var(--green2); box-shadow: 0 0 8px var(--green2); }
.scale-note {
  margin-top: 10px; font-size: var(--text-sm); color: var(--mut); line-height: var(--leading-normal);
}
.scale-rules {
  margin-top: 8px; padding: 10px 12px; border-radius: 10px;
  background: #f5f2eb; border: 1px solid var(--line);
  font-size: var(--text-sm); line-height: var(--leading-normal);
}

.section { margin: 56px 0; }
.section .ey {
  text-align: center; font-size: var(--text-xs); letter-spacing: var(--tracking-label);
  text-transform: uppercase; font-weight: 700; color: var(--blue);
}
.section h2 {
  text-align: center; font-family: var(--font-display); font-weight: 600;
  font-size: var(--text-2xl); margin: 8px 0 10px; letter-spacing: -0.02em;
  line-height: var(--leading-tight);
}
.section .lead {
  text-align: center; color: var(--mut); font-size: var(--text-md); line-height: var(--leading-relaxed);
  max-width: 54ch; margin: 0 auto 28px;
}

.steps {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
}
.step {
  padding: 20px 16px; border-radius: 18px;
  background: var(--white); border: 1px solid var(--line);
  box-shadow: 0 8px 24px -12px rgba(40,35,25,0.06);
  border-top: 3px solid var(--blue);
}
.step:nth-child(2) { border-top-color: var(--gold2); }
.step:nth-child(3) { border-top-color: var(--green2); }
.step:nth-child(4) { border-top-color: var(--blue); }
.step .n {
  font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; margin-bottom: 8px;
}
.step:nth-child(1) .n { color: var(--blue); }
.step:nth-child(2) .n { color: var(--gold); }
.step:nth-child(3) .n { color: var(--green); }
.step:nth-child(4) .n { color: var(--blue); }
.step h3 { font-size: var(--text-base); font-weight: 700; margin-bottom: 6px; line-height: var(--leading-snug); }
.step p { font-size: var(--text-sm); color: var(--mut); line-height: var(--leading-normal); }

.why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.why .card {
  padding: 22px 18px; border-radius: 18px;
  background: var(--white); border: 1px solid var(--line);
}
.why h3 { font-size: var(--text-base); font-weight: 700; margin-bottom: 6px; line-height: var(--leading-snug); }
.why p { font-size: var(--text-sm); color: var(--mut); line-height: var(--leading-normal); }

.privacy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.privacy-card {
  padding: 20px 18px; border-radius: 16px;
  background: var(--white); border: 1px solid var(--line);
}
.privacy-card .tag {
  font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-label);
  text-transform: uppercase; color: var(--mut2); margin-bottom: 8px;
}
.privacy-card h3 { font-size: var(--text-base); font-weight: 700; margin-bottom: 6px; }
.privacy-card p { font-size: var(--text-sm); color: var(--mut); line-height: var(--leading-normal); }
.privacy-foot {
  margin-top: 16px; padding: 16px 18px; border-radius: 14px;
  background: #f5f2eb; border: 1px solid var(--line);
  font-size: var(--text-sm); color: var(--mut); line-height: var(--leading-normal);
}
.privacy-foot a { color: var(--blue); font-weight: 600; }

.split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.split .card { padding: 26px 24px; border-radius: 20px; }
.split .ind {
  background: linear-gradient(160deg, var(--blue-soft) 0%, var(--white) 60%);
  border: 1.5px solid #c5d0dc;
}
.split .biz {
  background: linear-gradient(160deg, #fef6e4 0%, var(--white) 60%);
  border: 1.5px solid #e8c878;
}
.split .tag {
  font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-label);
  text-transform: uppercase; display: block; margin-bottom: 8px;
}
.split .ind .tag { color: var(--blue); }
.split .biz .tag { color: var(--gold); }
.split h3 {
  font-family: var(--font-display); font-weight: 600;
  font-size: var(--text-xl); margin-bottom: 8px; line-height: var(--leading-snug);
}

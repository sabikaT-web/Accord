<%- include('partials/head') %>
<div class="nc-wide">
<h1 class="page serif">Start a case</h1>
<p class="sub">Tell us what the dispute is about and who's involved. Your figures stay private — the other party never sees them.</p>
<div class="card">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/cases/new" enctype="multipart/form-data" class="nc">

    <!-- ============ THE DISPUTE (horizontal) ============ -->
    <section class="nc-band">
      <div class="nc-sec-h"><h2 class="serif">The dispute</h2></div>

      <div class="nc-field">
        <label for="title">Subject</label>
        <input id="title" name="title" type="text" placeholder="e.g. Unpaid invoice #1042" required />
        <div class="help">A short label — this becomes the case name.</div>
      </div>

      <div class="nc-disp-row">
        <div class="nc-field">
          <label for="currency">Currency</label>
          <select id="currency" name="currency">
            <% Object.keys(currencies).forEach(function(code){ %>
              <option value="<%= code %>"<%= code === selectedCurrency ? ' selected' : '' %>><%= currencies[code].label %></option>
            <% }) %>
          </select>
        </div>
        <div class="nc-field nc-amount">
          <label for="amount">Amount (<span id="curSym"><%= currencies[selectedCurrency].symbol %></span>)</label>
          <span class="nc-cs"><%= currencies[selectedCurrency].symbol %></span>
          <input id="amount" name="amount" type="number" min="1" step="1" placeholder="80000" required />
        </div>
        <div class="nc-field">
          <label>Your position</label>
          <div class="radio-row nc-pos">
            <label><input type="radio" name="role" value="owed" required /> I'm owed money</label>
            <label><input type="radio" name="role" value="owe" /> I owe money</label>
          </div>
        </div>
      </div>

      <div class="help nc-curnote">The dispute, the scale, the settlement and the agreement are all shown in this currency. Both parties see the same currency.</div>
    </section>

    <!-- ============ THE PARTIES (side by side) ============ -->
    <section class="nc-band">
      <div class="nc-sec-h"><h2 class="serif">The parties</h2></div>
      <div class="nc-two">

        <div class="nc-party nc-claim">
          <div class="nc-party-h"><h3 class="serif">Your details</h3><span class="nc-tag">Claimant</span></div>
          <p class="nc-party-sub">We'll use these to reach you and to name you on the agreement.</p>
          <div class="nc-g2">
            <div class="nc-field"><label for="full_name">Full name <span class="nc-req">*</span></label><input id="full_name" name="full_name" type="text" maxlength="200" placeholder="On the agreement" required /></div>
            <div class="nc-field"><label for="phone">Phone <span class="nc-req">*</span></label><input id="phone" name="phone" type="tel" placeholder="+44 …" required /></div>
          </div>
          <div class="nc-field">
            <label for="claimant_email">Email</label>
            <input id="claimant_email" name="claimant_email" type="email" class="nc-readonly"
                   value="<%= (typeof me !== 'undefined' && me) ? me.email : '' %>" readonly />
            <div class="help nc-help-tight">The email on your MidBid account — this is where we'll reach you.</div>
          </div>
          <div class="nc-g2">
            <div class="nc-field"><label for="company">Company name <span class="opt">(optional)</span></label><input id="company" name="company" type="text" maxlength="200" placeholder="Your business, if any" /></div>
            <div class="nc-field"><label for="address">Address <span class="opt">(optional)</span></label><input id="address" name="address" type="text" maxlength="500" placeholder="Street, city, postcode" /></div>
          </div>
        </div>

        <div class="nc-party nc-resp">
          <div class="nc-party-h"><h3 class="serif">The other party</h3><span class="nc-tag">Respondent</span></div>
          <p class="nc-party-sub">Enough for us to invite them. They confirm the rest when they join.</p>
          <div class="nc-g2">
            <div class="nc-field"><label for="other_full_name">Full name <span class="nc-req">*</span></label><input id="other_full_name" name="other_full_name" type="text" maxlength="200" placeholder="Their full name" required /></div>
            <div class="nc-field"><label for="other_phone">Phone <span class="nc-req">*</span></label><input id="other_phone" name="other_phone" type="tel" placeholder="Their contact number" required /></div>
          </div>
          <div class="nc-field"><label for="other_email">Email <span class="nc-req">*</span></label><input id="other_email" name="other_email" type="email" placeholder="them@email.com" required /></div>
          <div class="nc-g2">
            <div class="nc-field"><label for="other_company">Company name <span class="opt">(optional)</span></label><input id="other_company" name="other_company" type="text" maxlength="200" placeholder="Their business, if any" /></div>
            <div class="nc-field"><label for="other_address">Address <span class="opt">(optional)</span></label><input id="other_address" name="other_address" type="text" maxlength="500" placeholder="Their address, if you have it" /></div>
          </div>
          <div class="nc-optnote"><strong>Company and address are optional here.</strong> The respondent holds the most up-to-date version, so they can confirm or correct these when they accept the invitation.</div>
        </div>

      </div>
    </section>

    <!-- ============ YOUR ACCOUNT & EVIDENCE (side by side) ============ -->
    <section class="nc-band">
      <div class="nc-sec-h"><h2 class="serif">Your account &amp; evidence <span class="opt">(optional)</span></h2></div>
      <div class="nc-two">

        <div class="nc-case-card">
          <div class="nc-field">
            <label for="case_details">About the case</label>
            <textarea id="case_details" name="case_details" rows="4" maxlength="4000"
              placeholder="Briefly, in your words — what happened, key dates, what's agreed and what's disputed."></textarea>
            <div class="help">Only you and a mediator (if it comes to that) can see this.</div>
          </div>
        </div>

        <div class="nc-doc-card">
          <input id="documents" name="documents" type="file" multiple
                 accept=".pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.xls,.xlsx,.txt,.csv" />
          <div class="help">Invoices, contracts, correspondence — up to 5 files, 5&nbsp;MB each.</div>
          <div class="doc-note"><strong>How your documents are used.</strong> Documents are only used as identifiers for the case. They are assessed solely for the purpose of mediation, and only where a human mediator is involved.</div>
          <div id="docList" class="doc-list" hidden></div>
        </div>

      </div>
    </section>

    <!-- ============ payments / mandate (unchanged) ============ -->
    <% if (paymentsEnabled) { %>
      <div class="help" id="feeNote" style="margin-top:1rem;padding:.7rem .85rem;background:rgba(47,107,255,.06);border:1px solid rgba(47,107,255,.2);border-radius:10px;color:#1e2a4a">
        A one-time <strong id="feeAmt"></strong> activation fee opens the case. You'll be taken to secure checkout next; the other party is only invited once payment is complete.
        <strong>This activation fee is deducted from the MidBid service charge if you go on to settle.</strong>
      </div>

      <div class="card card-flat" style="margin-top:1rem;box-shadow:none;border-color:var(--ochre-soft);background:rgba(245,179,18,.06)">
        <div class="eyebrow">Service charge authorisation</div>
        <p class="help" style="margin-top:.5rem">
          If both sides&rsquo; figures converge and both approve, a <strong>MidBid service charge</strong> becomes payable under the
          <a href="/fees" target="_blank" rel="noopener">Fee Schedule</a>. Your activation fee is deducted from it. You are responsible for
          <strong>half</strong> of what remains, unless either party chooses to cover it in full.
        </p>
        <p class="help">
          By continuing you authorise MidBid to charge the card you provide for your share, at that point.
          We will email you before taking any charge.
        </p>
        <p class="help">
          The service charge is payable because a settlement was reached. It is <strong>not</strong> a payment for the document,
          and it is not refundable if the other party later declines to sign.
          <strong>The settlement agreement is released only once the service charge has been paid in full.</strong>
        </p>
        <label style="display:flex;gap:.6em;align-items:flex-start;margin-top:.8rem;font-weight:400;color:var(--ink);text-transform:none;font-size:.88rem">
          <input type="checkbox" name="mandate" value="accepted" required style="width:auto;margin-top:.3em;accent-color:var(--go)" />
          <span>I have read and accept the <a href="/terms" target="_blank" rel="noopener">Platform Terms</a>, including the service charge and the payment authorisation above.</span>
        </label>
      </div>

      <div class="btn-block"><button class="btn btn-primary" type="submit" id="submitBtn">Continue to payment</button></div>
    <% } else { %>
      <div class="btn-block"><button class="btn btn-primary" type="submit">Create case</button></div>
    <% } %>
  </form>
</div>
</div>

<style>
  /* widen the page so it fills the screen instead of a narrow centre column */
  .nc-wide{width:min(1240px,94vw);margin-left:50%;transform:translateX(-50%)}
  .nc-wide > .card{max-width:none;width:100%;box-sizing:border-box}
  .nc input,.nc select,.nc textarea{width:100%;box-sizing:border-box;max-width:none}
  .opt{font-weight:400;color:#8a8f99}

  /* bands: short, wide, divided */
  .nc-band + .nc-band{margin-top:1.35rem;padding-top:1.35rem;border-top:1px solid #e6e9f1}
  .nc-sec-h{margin:0 0 .85rem}
  .nc-sec-h h2{margin:0;font-size:1.2rem;font-weight:500;color:#16306B}
  .nc-sec-h .opt{font-size:.9rem}
  .nc-field{margin-bottom:0}

  /* dispute row */
  .nc-disp-row{display:grid;grid-template-columns:1fr 1fr 1.1fr;gap:16px;align-items:end;margin-top:14px}
  .nc-amount{position:relative}
  .nc-amount .nc-cs{position:absolute;left:12px;top:37px;color:#55607d;font-weight:500;pointer-events:none}
  .nc-amount input{padding-left:30px}
  .nc-pos{display:flex;gap:16px;align-items:center;padding-top:6px}
  .nc-pos label{display:flex;gap:.4em;align-items:center;cursor:pointer;font-weight:400}
  .nc-pos input{width:auto}
  .nc-curnote{border-left:2px solid #f5b400;background:rgba(245,179,18,.08);border-radius:0 8px 8px 0;margin-top:12px}

  /* two-up rows / columns */
  .nc-two{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .nc-g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .nc-party .nc-g2 + .nc-field,.nc-party .nc-field + .nc-g2,.nc-party .nc-g2 + .nc-g2{margin-top:13px}

  .nc-party{position:relative;border:1px solid #e3e6ec;border-radius:13px;padding:18px 18px 20px}
  .nc-party::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:3px;border-radius:3px}
  .nc-claim{background:#f3f6ff}.nc-claim::before{background:#2b54e6}
  .nc-resp{background:#fbf5e6}.nc-resp::before{background:#c79320}
  .nc-party-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:.1rem}
  .nc-party-h h3{margin:0;font-size:1.02rem;font-weight:500;color:#16306B}
  .nc-tag{font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.35em .6em;border-radius:999px}
  .nc-claim .nc-tag{color:#2b54e6;background:rgba(43,84,230,.12)}
  .nc-resp .nc-tag{color:#9a6b00;background:rgba(199,147,32,.18)}
  .nc-party-sub{margin:.1rem 0 .9rem;font-size:.76rem;color:#5a5f6b;line-height:1.5}
  .nc-req{color:#b3801f;font-weight:700}
  .nc-readonly{background:#f4f6fa!important;color:#5a5f6b;cursor:default}
  .nc-help-tight{margin-top:.35rem}
  .nc-optnote{margin-top:.85rem;padding-top:.75rem;border-top:1px dashed #ddd3ba;font-size:.75rem;color:#6a6f7b;line-height:1.5}
  .nc-optnote strong{color:#3b4252;font-weight:600}

  /* account & evidence */
  .nc-case-card{background:#f5f7fc;border:1px solid #dde3ef;border-radius:13px;padding:18px}
  .nc-case-card textarea{background:#fff}
  .nc-doc-card{border:1px solid #e3e6ec;border-radius:13px;padding:18px}
  input[type=file]{display:block;width:100%;font:inherit;font-size:.9rem;padding:.55rem .7rem;border:1px dashed #c7cdda;border-radius:10px;background:#fbfcfe;cursor:pointer}
  input[type=file]::file-selector-button{font:inherit;font-weight:600;margin-right:.8rem;padding:.4rem .8rem;border:none;border-radius:999px;background:#16306B;color:#fff;cursor:pointer}
  .doc-note{margin-top:.7rem;font-size:.78rem;line-height:1.55;color:#5a5f6b}
  .doc-note strong{color:#1e2a4a}
  .doc-list{margin-top:.6rem;display:flex;flex-direction:column;gap:.35rem}
  .doc-item{display:flex;justify-content:space-between;gap:.8rem;font-size:.82rem;color:#3b4252;background:#f4f6fa;border:1px solid #e3e6ec;border-radius:8px;padding:.4rem .65rem}
  .doc-item.bad{background:#fff6ec;border-color:#f2dcc1;color:#7a4a18}
  .doc-size{color:#8a8f99;white-space:nowrap}

  @media (max-width:820px){.nc-two,.nc-g2,.nc-disp-row{grid-template-columns:1fr}}
</style>

<script>
  var MAX_DOCS = 5, MAX_BYTES = 5 * 1024 * 1024;
  var docInput = document.getElementById('documents');
  var docList = document.getElementById('docList');
  function human(b){ return b < 1024*1024 ? Math.max(1,Math.round(b/1024)) + ' KB' : (b/1048576).toFixed(1) + ' MB'; }
  if (docInput) docInput.addEventListener('change', function(){
    var files = Array.prototype.slice.call(docInput.files || []);
    docList.innerHTML = '';
    docList.hidden = files.length === 0;
    if (files.length > MAX_DOCS) {
      var w = document.createElement('div'); w.className = 'doc-item bad';
      w.textContent = 'Please choose no more than ' + MAX_DOCS + ' files.';
      docList.appendChild(w);
    }
    files.slice(0, MAX_DOCS).forEach(function(f){
      var row = document.createElement('div');
      row.className = 'doc-item' + (f.size > MAX_BYTES ? ' bad' : '');
      var n = document.createElement('span'); n.textContent = f.name;
      var s = document.createElement('span'); s.className = 'doc-size';
      s.textContent = f.size > MAX_BYTES ? human(f.size) + ' — too large' : human(f.size);
      row.appendChild(n); row.appendChild(s); docList.appendChild(row);
    });
  });

  var CURMAP = <%- JSON.stringify(Object.fromEntries(Object.keys(currencies).map(function(k){return [k,{symbol:currencies[k].symbol,start:currencies[k].start}];}))) %>;
  var sel = document.getElementById('currency');
  var sym = document.getElementById('curSym');
  var cs = document.querySelector('.nc-cs');
  var feeAmt = document.getElementById('feeAmt');
  var submitBtn = document.getElementById('submitBtn');
  function refresh(){
    var c = CURMAP[sel.value] || {symbol:'\u00a3',start:0};
    if(sym) sym.textContent = c.symbol;
    if(cs) cs.textContent = c.symbol;
    if(feeAmt){ feeAmt.textContent = c.symbol + Number(c.start).toLocaleString(); }
    if(submitBtn){ submitBtn.textContent = 'Continue to payment \u00b7 ' + c.symbol + Number(c.start).toLocaleString(); }
  }
  if(sel){ sel.addEventListener('change', refresh); refresh(); }
</script>
<%- include('partials/foot') %>

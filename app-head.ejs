<%
  // Shared APP SHELL (left sidebar) for all inside pages. Include this at the top of
  // a page, add the page style and a .content block, then include app-foot at the
  // end. Pass active (overview | analytics | account) and title. Uses res.locals me.
  // This file lives at the repo root; the boot step copies it into views/partials.
  const _u = (me && (me.company_name || me.username || me.name)) || 'Account';
  const _ini = _u.replace(/[^A-Za-z ]/g,'').split(' ').filter(Boolean).slice(0,2).map(s => s[0].toUpperCase()).join('') || 'M';
  const _act = (typeof active !== 'undefined') ? active : '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MidBid · <%= (typeof title !== 'undefined') ? title : 'MidBid' %></title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Hanken+Grotesk:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --paper:#fffdf6;--ink:#1f2540;--navy:#16213f;--muted:#6d6650;--faint:#9a8f72;--line:#e9dcbc;
    --cobalt:#2b54e6;--cobsoft:#edeffb;--green:#2f9e5f;--greend:#2a8a53;--greensoft:#e6f3e9;
    --amber:#cf8a1f;--ambersoft:#f6ebcf;--gold:#c69632;
  }
  body{font-family:"Hanken Grotesk",system-ui,sans-serif;color:var(--ink);
    background:radial-gradient(1100px 500px at 60% -8%, #f9efc9 0%, #f3e8cd 55%, #eee1c0 100%);background-attachment:fixed;min-height:100vh;display:flex}
  .seam{position:fixed;top:0;left:0;right:0;height:2px;z-index:50;background:linear-gradient(90deg,#3f63c9,#2f9e5f 50%,#c69632)}

  /* Sidebar — restrained, premium */
  .side{width:224px;flex:none;background:#1a1710;border-right:1px solid #332c1d}
  .side-in{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;overflow-y:auto}
  .side .brand{display:flex;align-items:center;gap:11px;padding:24px 22px 22px;border-bottom:1px solid #2a2418}
  .side .brand .m{position:relative;width:26px;height:22px;flex:none}
  .side .brand .m::before,.side .brand .m::after{content:"";position:absolute;top:1px;width:19px;height:19px;border-radius:50%}
  .side .brand .m::before{left:0;background:#3f63c9}
  .side .brand .m::after{right:1px;background:#c99a3a}
  .side .brand b{font:500 1.22rem/1 "Fraunces",Georgia,serif;color:#f1ebdd;letter-spacing:.004em}
  .side nav{flex:1;padding:16px 14px;display:flex;flex-direction:column;gap:2px}
  .side nav a{display:flex;align-items:center;gap:13px;padding:10px 13px;border-radius:8px;text-decoration:none;color:#a49a82;font:500 .875rem/1 "Hanken Grotesk",sans-serif;letter-spacing:.004em;border-left:2px solid transparent;transition:color .15s,background .15s}
  .side nav a svg{width:18px;height:18px;flex:none;opacity:.82}
  .side nav a:hover{color:#f1ebdd;background:rgba(241,235,221,.05)}
  .side nav a.on{color:#f4ecda;background:rgba(198,150,50,.1);border-left-color:#c69632}
  .side .sep{height:1px;background:#2a2418;margin:12px 14px}
  .side .who{display:flex;align-items:center;gap:11px;padding:16px 20px;border-top:1px solid #2a2418}
  .side .who .av{width:32px;height:32px;border-radius:50%;background:transparent;border:1px solid #4c4330;color:#c4b896;display:flex;align-items:center;justify-content:center;font:600 .74rem/1 "Spline Sans Mono",monospace;flex:none}
  .side .who .nm{font:500 .84rem/1.15 "Hanken Grotesk",sans-serif;color:#efe6cf}
  .side .who .rl{font:400 .7rem/1 "Spline Sans Mono",monospace;color:#877c61;margin-top:3px;text-transform:capitalize}
  .side .who form{margin:0}

  .main{flex:1;min-width:0;display:flex;flex-direction:column}
  .topbar{display:flex;align-items:center;gap:14px;padding:14px 26px;border-bottom:1px solid var(--line);background:rgba(255,253,246,.6);backdrop-filter:blur(6px)}
  .search{flex:1;max-width:440px;position:relative}
  .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--faint)}
  .search input{width:100%;border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:9px 14px 9px 36px;font:inherit;font-size:.86rem;color:var(--ink)}
  .search input:focus{outline:none;border-color:var(--gold)}
  .tb-sp{flex:1}
  .newc{font:600 .78rem/1 "Hanken Grotesk",sans-serif;padding:9px 15px;border-radius:9px;background:var(--cobalt);color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--cobalt)}
  .newc:hover{background:#1e4fd0}.newc svg{width:15px;height:15px}
  .exp{font:600 .74rem/1 "Spline Sans Mono",monospace;padding:9px 14px;border-radius:9px;border:1px solid #d8cba6;background:var(--paper);color:var(--muted);cursor:pointer}
  .exp:hover{border-color:var(--gold);color:#946e18}

  .content{padding:22px 26px 40px;max-width:1240px;width:100%}
  .phead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:20px}
  .phead h1{font:500 1.75rem/1.1 "Fraunces",Georgia,serif;color:var(--navy);letter-spacing:-.01em}
  .phead p{color:var(--muted);font-size:.9rem;margin-top:6px}
  .phead .acts{display:flex;gap:8px;flex:none}

  @media(max-width:820px){
    .side{width:64px}.side .brand b,.side nav a .lbl,.side .who .nm,.side .who .rl{display:none}
    .side .brand{justify-content:center;padding:20px 0}.side nav a{justify-content:center;border-left:none}.side .who{justify-content:center}
    .search{display:none}
  }
</style>
</head>
<body>
<div class="seam"></div>

<aside class="side">
  <div class="side-in">
  <div class="brand"><span class="m"></span><b>MidBid</b></div>
  <nav>
    <a href="/overview" class="<%= _act === 'overview' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span class="lbl">Overview</span></a>
    <a href="/analytics" class="<%= _act === 'analytics' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-6M22 20H2"/></svg><span class="lbl">Analytics</span></a>
    <div class="sep"></div>
    <a href="/account" class="<%= _act === 'account' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg><span class="lbl">My account</span></a>
    <a href="/logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="lbl">Log out</span></a>
  </nav>
  <div class="who"><div class="av"><%= _ini %></div><div><div class="nm"><%= _u %></div><div class="rl"><%= (me && me.account_type) ? me.account_type : 'individual' %></div></div></div>
  </div>
</aside>

<div class="main">

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MidBid</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/styles.css" />
<style>
/* Portal switch. Scoped here so styles.css needs no changes. */
.portal-seg{display:flex;background:#EAEFF7;border:1px solid #DCE3EF;border-radius:999px;padding:3px;font-size:.84rem;font-weight:600;margin:0 auto}
.portal-seg form{margin:0;display:flex}
.portal-seg button,.portal-seg a{border:none;background:none;font:inherit;font-weight:600;color:#586079;padding:.4em 1em;border-radius:999px;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-block}
.portal-seg button.on,.portal-seg a.on{background:#fff;color:#16306B;box-shadow:0 1px 3px rgba(22,48,107,.12)}
@media (max-width:760px){.portal-seg{font-size:.78rem;margin:0}.portal-seg button{padding:.35em .7em}}
.bar-right .acct-link{color:#586079;text-decoration:none;font-weight:600}
.bar-right .acct-link:hover{color:#16306B;text-decoration:underline}
</style>
</head>
<body>
<div class="seam-top"></div>
<header class="bar">
  <div class="bar-in">
    <a class="brand" href="/">
      <svg style="width:32px;height:32px;flex:none" viewBox="14 14 72 72" xmlns="http://www.w3.org/2000/svg">
        <defs><clipPath id="mkH"><circle cx="44" cy="50" r="18"/></clipPath></defs>
        <!-- the two parties -->
        <circle cx="50" cy="22" r="4" fill="#2F6BFF"/>
        <circle cx="50" cy="78" r="4" fill="#F5B312"/>
        <!-- overlapping circles; green lives ONLY in the overlap -->
        <circle cx="44" cy="50" r="18" fill="#2F6BFF"/>
        <circle cx="56" cy="50" r="18" fill="#F5B312"/>
        <g clip-path="url(#mkH)"><circle cx="56" cy="50" r="18" fill="#15B877"/></g>
      </svg>
      MidBid
    </a>

    <%# Individual / business switch. Only for signed-in users. %>
    <% if (me) { %>
      <%# Only business accounts see this, and it is now plain navigation. It used to
          POST /business/switch, which rewrote account_type — so clicking "For
          individuals" would revoke your own access and lock you out of the portal
          you were standing in. Which view you are looking at and what you are
          allowed to open are two different things. %>
      <% if (me.account_type === 'business') { %>
      <div class="portal-seg" role="group" aria-label="Choose portal">
        <a href="/dashboard" class="<%= (typeof currentPath !== 'undefined' && currentPath.indexOf('/business') === 0) ? '' : 'on' %>">For individuals</a>
        <a href="/business" class="<%= (typeof currentPath !== 'undefined' && currentPath.indexOf('/business') === 0) ? 'on' : '' %>">For business</a>
      </div>
      <% } %>
    <% } %>

    <div class="bar-right">
      <% if (me) { %>
        <% if (me.account_type === 'business') { %>
          <a href="/business">Disputes</a>
        <% } else { %>
          <a href="/dashboard">My cases</a>
        <% } %>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %><a href="/admin" class="admin-link">Admin</a><% } %>
        <a href="/account" class="acct-link">My account</a>
        <form method="POST" action="/logout"><button class="linkbtn" type="submit">Log out</button></form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/signup">Sign up</a>
      <% } %>
    </div>
  </div>
</header>
<main>
<%# Pages opt in to the navy banner by passing a pageHead object with eyebrow, title, sub. %>
<%# Pages that pass nothing render exactly as they did before. %>
<% if (typeof pageHead !== 'undefined' && pageHead) { %>
  <div class="page-head">
    <div class="wrap">
      <% if (pageHead.eyebrow) { %><div class="eyebrow"><%= pageHead.eyebrow %></div><% } %>
      <h1 class="page"><%= pageHead.title %></h1>
      <% if (pageHead.sub) { %><p class="sub"><%- pageHead.sub %></p><% } %>
    </div>
  </div>
<% } %>
<div class="wrap">

<%
  // Two states: empty (0 cases) → 3 onboarding tiles; has cases → KPI tiles + table.
  // No pageHead passed, so there is NO navy banner (that is where the email was showing).
  const openC   = cases.filter(c => !['settled','declined','closed'].includes(c.status));
  const settled = cases.filter(c => c.status === 'settled');
  const mineC   = cases.filter(c => c.claimant_id === me.id);
  const sum = (a, k) => a.reduce((x, c) => x + (c[k] || 0), 0);
  const recovered = sum(settled.filter(c => c.claimant_id === me.id), 'settled_value');
  const openValue = sum(openC, 'amount');
  const attentionCount = cases.filter(c => c.attention).length;
  const _cc = {}; cases.forEach(c => { const k = c.currency || 'GBP'; _cc[k] = (_cc[k]||0)+1; });
  const cur = Object.keys(_cc).sort((a,b) => _cc[b]-_cc[a])[0] || 'GBP';
%>
<%- include('partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />

<style>
main > .wrap{max-width:1500px}   /* content uses the screen, not a narrow box */
body{background:#eef1f7}

.dbx{--cobalt:#2b54e6;--cobsoft:#eaf0ff;--navy:#16213f;--ink:#101a3a;--muted:#586079;
  --line:#e4e9f4;--green:#23a259;--greend:#268a4f;--amber:#e0972a;
  color:var(--ink);font-family:"Hanken Grotesk",system-ui,sans-serif}
.dbx *{box-sizing:border-box}

/* header row */
.dbx .dhead{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin:20px 0 18px}
.dbx .dh-eye{font:700 .6rem/1 "Spline Sans Mono",monospace;letter-spacing:.14em;text-transform:uppercase;color:#8a93a8;margin-bottom:8px}
.dbx .dh-t{font:500 1.7rem/1.1 "Fraunces",Georgia,serif;color:var(--navy);margin:0;letter-spacing:-.01em}
.dbx .dh-s{margin:8px 0 0;color:var(--muted);font-size:.92rem}
.dbx .dh-r{display:flex;gap:8px}
.dbx .exp{font:600 .72rem/1 "Spline Sans Mono",monospace;padding:9px 14px;border-radius:9px;border:1px solid #c7cdda;background:#fff;color:var(--muted);cursor:pointer}
.dbx .exp:hover{border-color:var(--cobalt);color:var(--cobalt)}
.dbx .newc{font:600 .72rem/1 "Spline Sans Mono",monospace;padding:9px 15px;border-radius:9px;background:var(--cobalt);color:#fff;text-decoration:none;display:inline-block;border:1px solid var(--cobalt)}
.dbx .newc:hover{background:#1e4fd0}

/* onboarding tiles (empty state) */
.dbx .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.dbx .step{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 22px 20px;text-decoration:none;color:inherit;transition:transform .15s,box-shadow .15s,border-color .15s}
.dbx .step:hover{transform:translateY(-3px);box-shadow:0 16px 32px -18px rgba(22,33,63,.4);border-color:#cdd6ea}
.dbx .ic{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.dbx .ic svg{width:24px;height:24px}
.dbx .ic-b{background:var(--cobsoft);color:var(--cobalt)}
.dbx .ic-g{background:#e3f5ea;color:var(--greend)}
.dbx .sn{font:700 .58rem/1 "Spline Sans Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:#9aa3b6;margin-bottom:6px}
.dbx .st{font:500 1.18rem/1.2 "Fraunces",Georgia,serif;color:var(--navy);margin-bottom:6px}
.dbx .sd{font-size:.86rem;color:var(--muted);line-height:1.45}
.dbx .step .go{margin-top:16px;font:600 .72rem/1 "Spline Sans Mono",monospace;color:var(--cobalt)}

/* KPI tiles (populated state) */
.dbx .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px}
.dbx .kpi{background:#fff;border:1px solid var(--line);border-top:3px solid var(--line);border-radius:14px;padding:16px 18px}
.dbx .kpi.b{border-top-color:var(--cobalt)}
.dbx .kpi.a{border-top-color:var(--amber)}
.dbx .kpi.g{border-top-color:var(--green)}
.dbx .kl{font:700 .6rem/1 "Spline Sans Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:#8a93a8;margin-bottom:10px}
.dbx .kv{font:600 1.7rem/1 "Fraunces",Georgia,serif;letter-spacing:-.01em;font-variant-numeric:tabular-nums;color:var(--navy)}
.dbx .kpi.b .kv{color:var(--cobalt)}
.dbx .kpi.a .kv{color:#b26a0f}
.dbx .kpi.g .kv{color:var(--greend)}
.dbx .ks{font-size:.78rem;color:var(--muted);margin-top:6px}

/* cases table sheet */
.dbx .sheet{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}
.dbx .sheet-h{display:flex;justify-content:space-between;align-items:center;padding:16px 18px 12px}
.dbx .sheet-h h2{font:500 1.05rem/1.2 "Fraunces",Georgia,serif;color:var(--navy);margin:0}
.dbx .sheet-h .cnt{font:600 .68rem/1 "Spline Sans Mono",monospace;color:var(--muted)}
.dbx table{width:100%;border-collapse:collapse;font-size:.9rem}
.dbx thead th{text-align:left;font:500 .58rem/1 "Spline Sans Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:10px 18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#f7f9fe}
.dbx thead th.r{text-align:right}
.dbx tbody td{padding:15px 18px;border-bottom:1px solid #f0f3f8;vertical-align:middle}
.dbx tbody td.r{text-align:right}
.dbx tbody tr:last-child td{border-bottom:none}
.dbx tbody tr:hover{background:#f7f9fe}
.dbx .cn{font:500 1rem/1.2 "Newsreader",Georgia,serif;color:var(--ink)}
.dbx .cn a{color:var(--ink);text-decoration:none}.dbx .cn a:hover{color:var(--cobalt)}
.dbx .cr{font:600 .64rem/1 "Spline Sans Mono",monospace;color:var(--cobalt);margin-top:4px}
.dbx .amt{font:500 .95rem/1 "Fraunces",Georgia,serif;color:var(--navy);font-variant-numeric:tabular-nums}
.dbx .bid{font:400 .82rem/1 "Spline Sans Mono",monospace;color:var(--muted);font-variant-numeric:tabular-nums}
.dbx .bid .none{color:#95a0b8;font-style:italic;font-family:"Newsreader",Georgia,serif}
.dbx .pill{font:600 .62rem/1 "Spline Sans Mono",monospace;padding:5px 10px;border-radius:999px;white-space:nowrap;display:inline-block}
.dbx .pill.bidding,.dbx .pill.progress{background:var(--cobsoft);color:var(--cobalt)}
.dbx .pill.awaiting,.dbx .pill.draft{background:rgba(224,151,42,.14);color:#a9640f}
.dbx .pill.settled{background:#e3f5ea;color:var(--greend)}
.dbx .pill.declined,.dbx .pill.closed{background:#eef1f6;color:var(--muted)}
.dbx .btn{font:600 .72rem/1 "Spline Sans Mono",monospace;padding:8px 15px;border-radius:9px;text-decoration:none;display:inline-block;border:1px solid transparent}
.dbx .btn.go{background:var(--green);color:#fff}.dbx .btn.go:hover{background:#1c8a4b}
.dbx .btn.ghost{background:#fff;border-color:#c7cdda;color:var(--cobalt)}.dbx .btn.ghost:hover{border-color:var(--cobalt)}

/* business nudge */
.dbx .biz{display:flex;align-items:center;gap:.7em;margin-top:18px;padding:.85em 1.1em;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:.88rem;color:var(--muted)}
.dbx .biz.earned{border-color:#ecdfc4;background:#fffdf7;color:#b5790f}
.dbx .biz svg{width:16px;height:16px;flex:none;color:var(--cobalt)}
.dbx .biz.earned svg{color:#b5790f}
.dbx .biz b{color:var(--navy)}.dbx .biz .sp{flex:1}.dbx .biz form{margin:0}
.dbx .bizask{font:600 .78rem/1 "Spline Sans Mono",monospace;color:#b5790f;background:none;border:none;cursor:pointer;white-space:nowrap;padding:0}

@media(max-width:820px){
  .dbx .steps,.dbx .kpis{grid-template-columns:1fr}
  .dbx thead th.hide,.dbx tbody td.hide{display:none}
}
</style>

<div class="dbx">

  <div class="dhead">
    <div class="dh-l">
      <% if (cases.length === 0) { %>
        <div class="dh-eye">Getting started</div>
        <h1 class="dh-t">Welcome to MidBid</h1>
        <p class="dh-s">Three steps to a settlement — start by naming your dispute.</p>
      <% } else { %>
        <div class="dh-eye">Dashboard</div>
        <h1 class="dh-t">Your cases</h1>
      <% } %>
    </div>
    <% if (cases.length) { %>
      <div class="dh-r">
        <% if (mineC.length) { %><button type="button" class="exp" onclick="downloadMine()">&#8595; Export</button><% } %>
        <a class="newc" href="/cases/new">+ New case</a>
      </div>
    <% } %>
  </div>

  <% if (cases.length === 0) { %>

    <div class="steps">
      <a class="step" href="/cases/new">
        <span class="ic ic-b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M8 13h8M8 17h6"/></svg></span>
        <span class="sn">Step 1</span>
        <span class="st">Name the dispute</span>
        <span class="sd">Who&rsquo;s involved, what it&rsquo;s about, and the amount in play.</span>
        <span class="go">Start &rarr;</span>
      </a>
      <a class="step" href="/cases/new">
        <span class="ic ic-b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg></span>
        <span class="sn">Step 2</span>
        <span class="st">Set your private figure</span>
        <span class="sd">Your walk-away number, sealed. The other side never sees it.</span>
        <span class="go">Continue &rarr;</span>
      </a>
      <a class="step" href="/cases/new">
        <span class="ic ic-g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16 9"/></svg></span>
        <span class="sn">Step 3</span>
        <span class="st">Settle when they meet</span>
        <span class="sd">If both figures cross, it settles at the midpoint. No settlement, no fee.</span>
        <span class="go">Get started &rarr;</span>
      </a>
    </div>

  <% } else { %>

    <div class="kpis">
      <div class="kpi b"><div class="kl">In your favour</div><div class="kv"><%= money(openValue, cur) %></div><div class="ks">across <%= openC.length %> open</div></div>
      <div class="kpi a"><div class="kl">Attention required</div><div class="kv"><%= attentionCount %></div><div class="ks"><%= attentionCount ? 'waiting on you' : 'nothing waiting' %></div></div>
      <div class="kpi g"><div class="kl">Recovered</div><div class="kv"><%= money(recovered, cur) %></div><div class="ks">settled to date</div></div>
    </div>

    <div class="sheet">
      <div class="sheet-h">
        <h2>All cases</h2>
        <span class="cnt"><%= cases.length %> total &middot; <%= openC.length %> open</span>
      </div>
      <table>
        <thead>
          <tr>
            <th>Case</th>
            <th>Amount</th>
            <th class="hide">Your figure</th>
            <th>Status</th>
            <th class="r">Next</th>
          </tr>
        </thead>
        <tbody>
          <% cases.forEach(function(c){
               const mine = c.claimant_id === me.id;
               const pc = c.status === 'declined' ? 'declined' : (c.status === 'closed' ? 'closed' : c.stage);
               const pt = c.status === 'settled' ? 'Settled' : (c.stage === 'awaiting' ? 'Awaiting' : (c.stage === 'bidding' ? 'Bidding' : (c.stage === 'draft' ? 'Draft' : c.status))); %>
            <tr>
              <td><div class="cn"><a href="/cases/<%= c.id %>"><%= c.title %></a></div><div class="cr">MB-<%= c.id %></div></td>
              <td class="amt"><%= money(c.amount, c.currency) %></td>
              <td class="bid hide"><% if (c.myLastBid != null) { %><%= money(c.myLastBid, c.currency) %><% } else { %><span class="none">not set</span><% } %></td>
              <td><span class="pill <%= pc %>"><%= pt %></span></td>
              <td class="r"><% if (c.status === 'settled') { %><% if (!mine) { %><a class="btn go" href="/cases/<%= c.id %>">Pay</a><% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">View</a><% } %><% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">Open</a><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (me.account_type !== 'business') { %>
      <% if (me.business_requested) { %>
        <div class="biz"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span class="sp">Your <b>business portal</b> request is with us — we&rsquo;ll be in touch about a demo.</span></div>
      <% } else if (cases.length >= 3) { %>
        <div class="biz earned"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5"/></svg><span class="sp">You&rsquo;re handling <b><%= cases.length %> disputes</b>. The <b>business portal</b> adds spreadsheet import, one bid bar across the lot, and bulk invites.</span><form method="POST" action="/business/request"><button type="submit" class="bizask">Ask for a demo &rarr;</button></form></div>
      <% } %>
    <% } %>

  <% } %>

</div>

<% if (mineC.length) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE), wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases'); XLSX.writeFile(wb,'midbid-my-cases.xlsx');
}
</script>
<% } %>

<%- include('partials/foot') %>

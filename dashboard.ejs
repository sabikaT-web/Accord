<%
  // The same instruments as the business portal, asking an individual's questions.
  // Money side for THIS viewer on a case: 'owed', 'owe', or null (unconfirmed).
  // Reads the stored creator_owes (claimant-owes convention); null => no colour.
  const sideOf = (c) => {
    if (c.creator_owes === null || c.creator_owes === undefined) return null;
    const isClaimant = c.claimant_id === me.id;
    const claimantOwes = c.creator_owes === true;
    return (isClaimant ? claimantOwes : !claimantOwes) ? 'owe' : 'owed';
  };
  const openC   = cases.filter(c => !['settled','declined','closed'].includes(c.status));
  const mineC   = cases.filter(c => c.claimant_id === me.id);         // ones I raised
  const owedC   = openC.filter(c => c.claimant_id === me.id);
  const settled = cases.filter(c => c.status === 'settled');
  const sum = (arr, k) => arr.reduce((a, c) => a + (c[k] || 0), 0);

  const owed = sum(owedC, 'amount');
  const needs = cases.filter(c => c.stalled).length;
  const recovered = sum(settled.filter(c => c.claimant_id === me.id), 'settled_value');

  const spans = settled
    .filter(c => c.settled_at && c.created_at)
    .map(c => Math.max(0, Math.round((new Date(c.settled_at) - new Date(c.created_at)) / 86400000)));
  const typical = spans.length ? Math.round(spans.reduce((a, b) => a + b, 0) / spans.length) : null;

  // KPI totals only make sense within one currency; use the most common currency
  // across the viewer's cases so a single case in another currency can't flip the symbol.
  const _cc = {}; cases.forEach(function(c){ var k = c.currency || 'GBP'; _cc[k] = (_cc[k]||0)+1; });
  const cur = Object.keys(_cc).sort(function(a,b){ return _cc[b]-_cc[a]; })[0] || 'GBP';
  const STAGE_META = {
    draft:      { label: 'Draft',       color: '#B4B2A9' },
    awaiting:   { label: 'Awaiting',    color: '#F5B312' },
    progress:   { label: 'In progress', color: '#2F6BFF' },
    bidding:    { label: 'Bidding — rounds in play',  color: '#2F6BFF' },
    settled:    { label: 'Settled',     color: '#15B877' }
  };
  const STAGES = ['draft','awaiting','bidding','settled'];
  const countAt = (s) => cases.filter(c => c.stage === s).length;

  const filter = typeof f === 'undefined' ? (locals.filter || 'all') : f;
%>
<%- include('partials/head', { pageHead: null }) %>

<%# The case page's serif — head only ships Fraunces/Hanken/Spline, so add Newsreader here. %>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />

<style>
/* ===== Individual dashboard — case-page "Chambers" skin.
   Gold is confined to the facts ribbon; cobalt is the workhorse everywhere else.
   Scoped with cd- so styles.css needs no changes. ===== */
.cd-ribbon{background:linear-gradient(180deg,#fffdf7,#fbf5e9);border:1px solid #ecdfc4;border-radius:14px;
  padding:19px 22px 16px;margin:8px 0 18px;box-shadow:0 18px 46px -40px rgba(120,90,30,.5)}
.cd-rb-top{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:15px}
.cd-eyebrow{font-family:"Spline Sans Mono",monospace;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;
  color:#a9853a;display:flex;align-items:center;gap:7px;margin-bottom:6px}
.cd-dot{width:6px;height:6px;border-radius:50%;background:#cf9c34;flex:none}
.cd-h{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.5rem;letter-spacing:-.01em;color:#16213f}
.cd-acts{display:flex;gap:9px}
.cd-btn{font-family:"Spline Sans Mono",monospace;font-size:.72rem;padding:9px 14px;border-radius:8px;
  border:1px solid #c7cdda;background:#fff;color:#586079;text-decoration:none;cursor:pointer}
.cd-btn:hover{border-color:#2b54e6;color:#2b54e6;text-decoration:none}
.cd-btn.solid{background:#2b54e6;border-color:#2b54e6;color:#fff}
.cd-btn.solid:hover{background:#1e4fd0;border-color:#1e4fd0;color:#fff}
.cd-kpis{display:grid;grid-template-columns:repeat(4,1fr)}
.cd-kpi{padding:2px 20px;text-decoration:none;color:inherit;display:block}
.cd-kpi + .cd-kpi{border-left:1px solid #eadfc6}
.cd-kpi:first-child{padding-left:0}
a.cd-kpi{border-radius:8px;transition:background .16s}
a.cd-kpi:hover{background:rgba(207,156,52,.10);text-decoration:none}
.cd-k{font-family:"Spline Sans Mono",monospace;font-size:.6rem;letter-spacing:.13em;text-transform:uppercase;
  color:#a9853a;display:flex;align-items:center;gap:6px;margin-bottom:6px}
.cd-n{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.5rem;line-height:1;color:#16213f;font-variant-numeric:tabular-nums}
.cd-n.cobalt{color:#2b54e6}
.cd-n.green{color:#268a4f}
.cd-n .cd-u{font-size:.9rem;color:#8a8f99}
.cd-s{font-family:"Spline Sans Mono",monospace;font-size:.65rem;color:#8a8f99;margin-top:5px}

.cd-tools{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:13px}
.cd-chip{font-family:"Spline Sans Mono",monospace;font-size:.68rem;padding:7px 12px;border-radius:999px;
  border:1px solid #c7cdda;background:#fff;color:#586079;cursor:pointer;text-decoration:none;transition:.15s}
.cd-chip:hover{border-color:#16213f;color:#16213f;text-decoration:none}
.cd-chip.on{background:#16213f;color:#fff;border-color:#16213f}

.cd-sheet{background:#fff;border:1px solid #e4e9f4;border-radius:14px;overflow:hidden}
.cd-scroll{overflow-x:auto}
table.cdcases{width:100%;border-collapse:collapse;font-size:.9rem;min-width:720px}
table.cdcases thead th{text-align:left;font-family:"Spline Sans Mono",monospace;font-size:.6rem;letter-spacing:.1em;
  text-transform:uppercase;color:#586079;font-weight:500;padding:12px 16px;background:#f5f7fc;border-bottom:1px solid #e4e9f4;white-space:nowrap}
table.cdcases thead th.r{text-align:right}
table.cdcases tbody td{padding:14px 16px;border-bottom:1px solid #eef1f7;vertical-align:middle}
table.cdcases tbody td.r{text-align:right}
table.cdcases tbody tr:last-child td{border-bottom:none}
table.cdcases tbody tr:hover{background:#f7f9fe}
table.cdcases tbody tr.done{background:rgba(35,162,89,.05)}
tr.cd-b td:first-child{box-shadow:inset 4px 0 0 #2b54e6}
tr.cd-a td:first-child{box-shadow:inset 4px 0 0 #e0972a}
.cd-nm{font-family:"Newsreader",Georgia,serif;font-weight:500;font-size:1.02rem}
.cd-nm a{color:#101a3a;text-decoration:none}
.cd-nm a:hover{color:#2b54e6}
.cd-ref{font-family:"Spline Sans Mono",monospace;font-size:.66rem;color:#2b54e6;margin-top:2px}
.cd-subq{font-size:.78rem;color:#95a0b8;margin-top:2px}
.cd-amt{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1rem;color:#16213f;font-variant-numeric:tabular-nums;white-space:nowrap}
.cd-bid{font-family:"Spline Sans Mono",monospace;font-size:.82rem;color:#586079;font-variant-numeric:tabular-nums;white-space:nowrap}
.cd-bid .val{color:#16213f;font-weight:500}
.cd-bid .none{color:#95a0b8;font-style:italic;font-family:"Newsreader",Georgia,serif}
.cd-pill{font-family:"Spline Sans Mono",monospace;font-size:.64rem;padding:.32em .72em;border-radius:999px;white-space:nowrap;display:inline-block}
.cd-pill.draft{background:#eef1f6;color:#59637e}
.cd-pill.awaiting{background:rgba(224,151,42,.13);color:#a9640f}
.cd-pill.progress{background:#eaf0ff;color:#2b54e6}
.cd-pill.bidding{background:#eaf0ff;color:#2b54e6}
.cd-pill.settled{background:#e3f5ea;color:#268a4f}
.cd-pill.declined{background:#fbeae2;color:#8a3d1a}
.cd-pill.closed{background:#eef1f6;color:#59637e}
.cd-go,.cd-ghost{font-family:"Spline Sans Mono",monospace;font-size:.7rem;padding:7px 14px;border-radius:8px;
  text-decoration:none;white-space:nowrap;display:inline-block}
.cd-go{border:1px solid #23a259;background:#23a259;color:#fff}
.cd-go:hover{background:#1c8a4b;border-color:#1c8a4b;text-decoration:none}
.cd-ghost{border:1px solid #c7cdda;background:#fff;color:#2b54e6}
.cd-ghost:hover{border-color:#2b54e6;text-decoration:none}
.cd-empty{padding:30px;text-align:center;color:#78849e}
.cd-empty-wrap{background:#fff;border:1px solid #e4e9f4;border-radius:14px;padding:8px}

.cd-biz{display:flex;align-items:center;gap:.7em;margin-top:18px;padding:.8em 1.1em;border:1px solid #e4e9f4;
  border-radius:12px;background:#fff;font-size:.88rem;color:#5a6377}
.cd-biz.earned{border-color:#ecdfc4;background:#fffdf7;color:#8a5a0b}
.cd-biz.pending{background:#f7f9fd;color:#586079}
.cd-biz svg{width:16px;height:16px;flex:none;color:#2b54e6}
.cd-biz.earned svg{color:#b5790f}
.cd-biz.pending svg{color:#586079}
.cd-biz b{color:#16213f}
.cd-biz.earned b{color:#6e4708}
.cd-biz .sp{flex:1}
.cd-biz form{margin:0}
.cd-bizask{font-family:"Spline Sans Mono",monospace;font-size:.78rem;color:#2b54e6;background:none;border:none;
  cursor:pointer;white-space:nowrap;padding:0}
.cd-bizask:hover{text-decoration:underline}
.cd-biz.earned .cd-bizask{color:#b5790f}

@media(max-width:640px){
  .cd-kpis{grid-template-columns:1fr 1fr}
  .cd-kpi+.cd-kpi{border-left:none}
  .cd-kpi:nth-child(n+3){border-top:1px solid #eadfc6;padding-top:12px;margin-top:10px}
  table.cdcases thead th:nth-child(3),table.cdcases tbody td:nth-child(3){display:none}
}
</style>

<div class="cd-ribbon">
  <div class="cd-rb-top">
    <div>
      <div class="cd-eyebrow"><span class="cd-dot"></span>Your cases</div>
      <div class="cd-h"><%= cases.length ? (openC.length + ' open, ' + settled.length + ' settled') : 'No cases yet' %></div>
    </div>
    <% if (cases.length) { %>
    <div class="cd-acts">
      <button type="button" class="cd-btn" onclick="downloadMine()">&#8595; Export</button>
      <a class="cd-btn solid" href="/cases/new">New case</a>
    </div>
    <% } %>
  </div>
  <% if (cases.length) { %>
  <div class="cd-kpis">
    <div class="cd-kpi"><div class="cd-k"><span class="cd-dot"></span>In your favour</div><div class="cd-n cobalt"><%= money(owed, cur) %></div><div class="cd-s">across <%= owedC.length %> open</div></div>
    <a class="cd-kpi" href="/dashboard?filter=<%= filter === 'attn' ? 'all' : 'attn' %>"><div class="cd-k"><span class="cd-dot"></span>Attention required</div><div class="cd-n"><%= needs %></div><div class="cd-s"><%= needs ? 'waiting on you' : 'nothing waiting' %></div></a>
    <div class="cd-kpi"><div class="cd-k"><span class="cd-dot"></span>Recovered</div><div class="cd-n green"><%= money(recovered, cur) %></div><div class="cd-s">settled to date</div></div>
    <% if (typical !== null) { %><div class="cd-kpi"><div class="cd-k"><span class="cd-dot"></span>Typical settle</div><div class="cd-n"><%= typical %><span class="cd-u"> days</span></div><div class="cd-s">open to agreed</div></div><% } %>
  </div>
  <% } %>
</div>

<% if (cases.length === 0) { %>
  <div class="cd-empty-wrap">
    <div class="cd-empty">
      <p>No cases yet. Start one to invite the other party.</p>
      <a class="cd-btn solid" href="/cases/new" style="margin-top:14px;display:inline-block">Start a new case</a>
    </div>
  </div>
<% } else { %>

<div class="cd-tools">
  <% var stageChips = [['all','All']].concat(STAGES.map(function(st){return [st, STAGE_META[st].label];})); %>
  <% stageChips.forEach(function(sc){ %>
    <a class="cd-chip <%= filter === sc[0] ? 'on' : '' %>" href="/dashboard?filter=<%= sc[0] %>"><%= sc[1] %></a>
  <% }); %>
</div>

<%
  const visible = cases.filter(function (c) {
    if (filter === 'all') return true;
    if (filter === 'attn') return c.stalled;
    return c.stage === filter;
  });
%>
<div class="cd-sheet"><div class="cd-scroll">
  <table class="cdcases">
    <thead><tr><th>Case</th><th>Original amount</th><th>Last bid</th><th>Status</th><th class="r">Next step</th></tr></thead>
    <tbody>
    <% visible.forEach(function (c) {
         const mine = c.claimant_id === me.id;
         const side = sideOf(c);   // 'owed' | 'owe' | null
         const pillClass = c.status === 'declined' ? 'declined' : (c.status === 'closed' ? 'closed' : c.stage);
         let pillText = STAGE_META[c.stage] ? STAGE_META[c.stage].label : c.status;
         if (c.stage === 'draft') pillText = 'Draft — not invited';
         if (c.stage === 'awaiting') pillText = 'Awaiting other party';
         if (c.status === 'settled') pillText = 'Settled at ' + money(c.settled_value, c.currency);
         if (c.status === 'declined') pillText = 'Declined';
         if (c.status === 'closed') pillText = 'Closed';
    %>
      <tr class="<%= (c.status === 'settled' || c.status === 'closed') ? 'done' : '' %> <%= side === 'owed' ? 'cd-b' : (side === 'owe' ? 'cd-a' : '') %>">
        <td>
          <div class="cd-nm"><a href="/cases/<%= c.id %>"><%= c.title %></a></div>
          <div class="cd-ref">MB-<%= c.id %></div>
          <% if (c.stalled) { %><div class="cd-subq">Quiet for <%= c.age %> days</div><% } %>
        </td>
        <td class="cd-amt"><%= money(c.amount, c.currency) %></td>
        <td class="cd-bid">
          <% if (c.myLastBid != null) { %><span class="val"><%= money(c.myLastBid, c.currency) %></span>
          <% } else { %><span class="none">no bid yet</span><% } %>
        </td>
        <td><span class="cd-pill <%= pillClass %>"><%= pillText %></span></td>
        <td class="r">
          <% if (c.status === 'settled') { %>
            <% if (!mine) { %><a class="cd-go" href="/cases/<%= c.id %>">Pay</a>
            <% } else { %><a class="cd-ghost" href="/cases/<%= c.id %>">View</a><% } %>
          <% } else { %><a class="cd-ghost" href="/cases/<%= c.id %>">Open</a><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div></div>
<% if (!visible.length) { %><p class="cd-empty">No cases match this view.</p><% } %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
// Only cases you raised yourself can move workspace — ones you were invited into
// belong to you as a person, wherever they came from.
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Highest bid': c.highest == null ? '' : c.highest, 'Lowest bid': c.lowest == null ? '' : c.lowest,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE);
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases');
  XLSX.writeFile(wb,'midbid-my-cases.xlsx');
}
</script>

<% } %>
<% if (me.account_type !== 'business') { %>
  <% if (me.business_requested) { %>
    <div class="cd-biz pending">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <span class="sp">Your <b>business portal</b> request is with us — we'll be in touch about a demo.</span>
    </div>
  <% } else { %>
    <div class="cd-biz <%= cases.length >= 25 ? 'earned' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5"/></svg>
      <span class="sp">
        <% if (cases.length >= 25) { %>
          You're handling <b><%= cases.length %> disputes</b>. The <b>business portal</b> is built for exactly this — import them from a spreadsheet, set one bid bar across the lot, invite in bulk.
        <% } else { %>
          Handling <b>25 disputes or more</b>? There's a <b>business portal</b> for that — spreadsheet import, one bid bar across the lot, bulk invites.
        <% } %>
      </span>
      <form method="POST" action="/business/request">
        <button type="submit" class="cd-bizask">Ask for a demo &rarr;</button>
      </form>
    </div>
  <% } %>
<% } %>

<%- include('partials/foot') %>

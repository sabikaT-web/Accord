<%
  // ================= DATA (same instruments as before) =================
  const sideOf = (c) => {
    if (c.creator_owes === null || c.creator_owes === undefined) return null;
    const isClaimant = c.claimant_id === me.id;
    const claimantOwes = c.creator_owes === true;
    return (isClaimant ? claimantOwes : !claimantOwes) ? 'owe' : 'owed';
  };
  const openC   = cases.filter(c => !['settled','declined','closed'].includes(c.status));
  const mineC   = cases.filter(c => c.claimant_id === me.id);
  const settled = cases.filter(c => c.status === 'settled');
  const sum = (arr, k) => arr.reduce((a, c) => a + (c[k] || 0), 0);
  const recovered = sum(settled.filter(c => c.claimant_id === me.id), 'settled_value');
  const openValue = sum(openC, 'amount');

  const spans = settled.filter(c => c.settled_at && c.created_at)
    .map(c => Math.max(0, Math.round((new Date(c.settled_at) - new Date(c.created_at)) / 86400000)));
  const typical = spans.length ? Math.round(spans.reduce((a,b)=>a+b,0)/spans.length) : null;

  const _cc = {}; cases.forEach(c => { const k = c.currency || 'GBP'; _cc[k] = (_cc[k]||0)+1; });
  const cur = Object.keys(_cc).sort((a,b) => _cc[b]-_cc[a])[0] || 'GBP';

  const monthAgo = Date.now() - 30*86400000;
  const settledRecent = settled.filter(c => c.settled_at && new Date(c.settled_at).getTime() >= monthAgo);
  const recoveredRecent = settledRecent.filter(c => c.claimant_id === me.id).reduce((a,c)=>a+(c.settled_value||0),0);

  // stage tallies
  const nSettled  = settled.length;
  const nBidding  = cases.filter(c => c.stage === 'bidding').length;
  const nAwaiting = cases.filter(c => c.stage === 'awaiting' || c.stage === 'draft').length;
  const nDeclined = cases.filter(c => ['declined','closed'].includes(c.status)).length;
  const resolved  = nSettled + nDeclined;
  const settleRate = resolved ? Math.round(nSettled / resolved * 100) : 0;

  // recovered over 8 weeks (cumulative, your own settled money — no opponent data)
  const WEEKS = 8, WK = 7*86400000, tnow = Date.now();
  const weekEnds = []; for (let k = WEEKS-1; k >= 0; k--) weekEnds.push(tnow - k*WK);
  const cumRec = weekEnds.map(t => settled.filter(c => c.claimant_id === me.id && c.settled_at && new Date(c.settled_at).getTime() <= t).reduce((a,c)=>a+(c.settled_value||0),0));
  const maxRec = Math.max(1, ...cumRec);
  const AW = 260, AH = 54;
  const apts = cumRec.map((v,i) => [ Math.round(i/(WEEKS-1)*AW), Math.round(AH-6 - (v/maxRec)*(AH-12)) ]);
  const linePath = apts.map((p,i) => (i ? 'L' : 'M') + p[0] + ',' + p[1]).join(' ');
  const areaPath = 'M0,' + AH + ' ' + apts.map(p => 'L'+p[0]+','+p[1]).join(' ') + ' L' + AW + ',' + AH + ' Z';
  // donut (settlement rate) — r=52, C≈326.7
  const donutDash = (settleRate/100*326.7).toFixed(1);
  const donutGap  = (326.7 - donutDash).toFixed(1);

  // hero (most-live open case) + its age
  const heroCase = openC.find(c => c.stalled) || openC.find(c => c.stage === 'bidding')
    || openC.slice().sort((a,b) => new Date(b.created_at) - new Date(a.created_at))[0] || null;
  const heroAge = heroCase ? (heroCase.age != null ? heroCase.age
    : Math.max(0, Math.round((Date.now() - new Date(heroCase.created_at))/86400000))) : 0;

  // recent activity (derived from cases — no events table)
  let activity = [];
  settled.forEach(c => activity.push({ ic:'green', t:'Settlement signed — MB-'+c.id, s: money(c.settled_value||0, c.currency)+' recovered', w: c.settled_at ? new Date(c.settled_at).getTime() : 0 }));
  cases.filter(c => c.stalled).forEach(c => activity.push({ ic:'gold', t:'MB-'+c.id+' has gone quiet', s:'no reply · '+c.age+' days', w: Date.now() }));
  openC.filter(c => c.myLastBid != null).forEach(c => activity.push({ ic:'blue', t:'You sealed a figure — MB-'+c.id, s:'waiting on the other side', w: c.created_at ? new Date(c.created_at).getTime() : 0 }));
  activity.sort((a,b) => b.w - a.w); activity = activity.slice(0, 5);

  // triage — "needs you"
  let needs = [];
  cases.filter(c => c.stalled).forEach(c => needs.push({ k:'g', ic:'!', t:'MB-'+c.id+' has gone quiet', s:'no reply · '+c.age+' days', go:'Nudge', href:'/cases/'+c.id }));
  openC.filter(c => c.stage === 'bidding' && c.myLastBid == null).forEach(c => needs.push({ k:'c', ic:'2', t:'Set your figure — MB-'+c.id, s:'round in play', go:'Review', href:'/cases/'+c.id }));
  settled.filter(c => c.claimant_id === me.id).forEach(c => needs.push({ k:'c', ic:'£', t:'Payout ready — MB-'+c.id, s:money(c.settled_value, c.currency)+' settled', go:'Set up', href:'/cases/'+c.id }));
  settled.filter(c => c.claimant_id !== me.id).forEach(c => needs.push({ k:'c', ic:'£', t:'Payment due — MB-'+c.id, s:money(c.settled_value, c.currency), go:'Pay', href:'/cases/'+c.id }));
  needs = needs.slice(0, 4);

  const _h = new Date().getHours();
  const greet = _h < 12 ? 'Good morning' : (_h < 18 ? 'Good afternoon' : 'Good evening');
  const firstName = (me.name || 'there').split(' ')[0];

  // ================= MODE =================
  const DECK_AT = 6;                       // this many cases (or a business account) → operations deck
  const isEmpty = cases.length === 0;
  const mode = isEmpty ? 'empty'
    : ((me.account_type === 'business' || cases.length >= DECK_AT) ? 'deck' : 'focus');

  // top navy ribbon (head's full-bleed .page-head band) per mode
  let pageHeadData = null;
  if (mode === 'empty') {
    pageHeadData = { title: 'Your cases will live here',
      sub: "Open your first dispute and invite the other side. Both figures stay private until they meet.<span class=\"db-cta-wrap\"><a class=\"db-first\" href=\"/cases/new\">Open your first case</a></span>" };
  } else if (mode === 'focus' && heroCase) {
    let rlabel = heroCase.stage === 'bidding' ? 'Round in play' : (heroCase.stalled ? 'Gone quiet' : (heroCase.stage === 'awaiting' ? 'Awaiting the other party' : 'In progress'));
    pageHeadData = { eyebrow: 'Your live case · ' + rlabel,
      title: heroCase.title,
      sub: 'vs. ' + (heroCase.other_email || 'the other party') + ' &middot; opened ' + heroAge + ' day' + (heroAge===1?'':'s') + ' ago &middot; ' + money(heroCase.amount, heroCase.currency) + ' in dispute' };
  } else if (mode === 'focus') {
    pageHeadData = { eyebrow: 'Your cases', title: greet + ', ' + firstName,
      sub: 'No active disputes right now &middot; ' + nSettled + ' settled to date' };
  } else { // deck
    pageHeadData = { eyebrow: 'Portfolio', title: greet + ', ' + firstName,
      sub: openC.length + ' open &middot; ' + money(openValue, cur) + ' in play &middot; ' + settleRate + '% settlement rate' };
  }
%>
<%- include('partials/head', { pageHead: pageHeadData }) %>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />

<style>
/* ===== Adaptive individual dashboard — case-page palette. Gold = accent only. ===== */
.mbx{--navy:#16213f;--navy2:#22376f;--ink:#101a3a;--cobalt:#2b54e6;--cobsoft:#eaf0ff;--gold:#cf9c34;--goldd:#b5790f;
  --green:#23a259;--greend:#268a4f;--amber:#e0972a;--muted:#586079;--line:#e4e9f4;--paper:#fff;
  color:#101a3a;font-family:"Hanken Grotesk",system-ui,sans-serif}
.mbx *{box-sizing:border-box}
body{background:#eef1f7}
.mbx .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin-bottom:18px}
.mbx .card:last-child{margin-bottom:0}
.mbx .ch{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.mbx .ch h3{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.02rem;color:var(--navy);margin:0}
.mbx .ch a{font-family:"Spline Sans Mono",monospace;font-size:.7rem;color:var(--cobalt);text-decoration:none}
.mbx .ch a:hover{text-decoration:underline}
.mbx .grid{display:grid;gap:18px}

/* pills / buttons shared */
.mbx .pill{font-family:"Spline Sans Mono",monospace;font-size:.62rem;padding:4px 9px;border-radius:999px;white-space:nowrap;display:inline-block}
.mbx .pill.bidding,.mbx .pill.progress{background:var(--cobsoft);color:var(--cobalt)}
.mbx .pill.awaiting,.mbx .pill.draft{background:rgba(224,151,42,.14);color:#a9640f}
.mbx .pill.settled{background:#e3f5ea;color:var(--greend)}
.mbx .pill.declined,.mbx .pill.closed{background:#eef1f6;color:var(--muted)}
.mbx .btn{font-family:"Spline Sans Mono",monospace;font-size:.72rem;padding:8px 15px;border-radius:9px;text-decoration:none;display:inline-block;border:1px solid transparent;cursor:pointer}
.mbx .btn.go{background:var(--green);color:#fff}.mbx .btn.go:hover{background:#1c8a4b}
.mbx .btn.ghost{background:#fff;border-color:#c7cdda;color:var(--cobalt)}.mbx .btn.ghost:hover{border-color:var(--cobalt)}
.mbx .btn.primary{background:var(--cobalt);color:#fff}.mbx .btn.primary:hover{background:#1e4fd0}
.mbx .exp{font-family:"Spline Sans Mono",monospace;font-size:.7rem;padding:8px 13px;border-radius:9px;border:1px solid #c7cdda;background:#fff;color:var(--muted);cursor:pointer}
.mbx .exp:hover{border-color:var(--cobalt);color:var(--cobalt)}
.mbx .toolbar{display:flex;justify-content:flex-end;margin:12px 0 6px}

/* ---------- EMPTY ---------- */
.page-head{text-align:center}
.page-head .db-cta-wrap{display:block;margin-top:20px}
.page-head .db-first{display:inline-block;padding:12px 26px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(224,179,74,.55);color:#e0b34a;font-family:"Spline Sans Mono",monospace;font-size:.85rem;text-decoration:none;transition:.15s}
.page-head .db-first:hover{background:rgba(224,179,74,.16);border-color:#e0b34a}
.mb-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:-34px 0 20px;position:relative;z-index:5}
.mb-step{background:#fff;border:1px solid #e4e9f4;border-radius:16px;padding:26px 24px;box-shadow:0 18px 44px -30px rgba(16,26,58,.5)}
.mb-step.raise{margin-top:-30px}
.mb-step .ic{width:44px;height:44px;color:#b5790f;margin-bottom:16px}.mb-step .ic svg{width:100%;height:100%}
.mb-step h3{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.18rem;color:#16213f;margin:0 0 8px}
.mb-step p{color:#586079;font-size:.92rem;line-height:1.5;margin:0}
@media(max-width:820px){.mb-steps{grid-template-columns:1fr;margin-top:-20px}.mb-step.raise{margin-top:0}}

/* ---------- FOCUS (concierge) ---------- */
.mbx.focus .grid{grid-template-columns:1.5fr 1fr}
.mbx .seal{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:15px 17px;border:1px solid var(--line);border-radius:12px;background:#f7f9fe;margin-bottom:20px}
.mbx .seal .sl{font-family:"Spline Sans Mono",monospace;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.mbx .seal .sv{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.35rem;color:var(--ink)}
.mbx .seal .hint{display:flex;align-items:center;gap:8px;font-size:.84rem;color:var(--muted);max-width:270px}
.mbx .seal .hint svg{width:16px;height:16px;flex:none;color:var(--goldd)}
.mbx .tl{position:relative;padding-left:26px}
.mbx .tl::before{content:"";position:absolute;left:7px;top:5px;bottom:6px;width:2px;background:var(--line)}
.mbx .ev{position:relative;padding-bottom:19px}.mbx .ev:last-child{padding-bottom:0}
.mbx .ev .node{position:absolute;left:-26px;top:1px;width:16px;height:16px;border-radius:50%;background:#fff;border:2px solid #c7cdda}
.mbx .ev.you .node{border-color:var(--cobalt)}
.mbx .ev.now .node{border-color:var(--gold);box-shadow:0 0 0 4px rgba(207,156,52,.18)}
.mbx .ev.done .node{border-color:var(--green);background:var(--green)}
.mbx .ev .et{font-family:"Newsreader",Georgia,serif;font-size:1rem;color:var(--ink);font-weight:500}
.mbx .ev .es{font-family:"Spline Sans Mono",monospace;font-size:.66rem;color:var(--muted);margin-top:2px}
.mbx .ev .ec{font-size:.88rem;color:var(--muted);margin-top:4px;line-height:1.45}
.mbx .nba{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;border:none}
.mbx .nba .nl{font-family:"Spline Sans Mono",monospace;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:#a9c4ff;margin-bottom:8px}
.mbx .nba h3{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.18rem;margin:0 0 6px;color:#fff}
.mbx .nba p{color:rgba(255,255,255,.72);font-size:.9rem;margin:0 0 16px;line-height:1.5}
.mbx .nba .btn.solid{background:#fff;color:var(--navy)}
.mbx .nba .btn.gold{background:rgba(255,255,255,.09);color:#e0b34a;border-color:rgba(224,179,74,.5);margin-left:8px}
.mbx .mini{display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid var(--line);text-decoration:none}
.mbx .mini:last-child{border-bottom:none;padding-bottom:0}.mbx .mini:first-child{padding-top:0}
.mbx .mini .mn{font-family:"Newsreader",Georgia,serif;font-size:.95rem;color:var(--ink)}
.mbx .mini .mr{font-family:"Spline Sans Mono",monospace;font-size:.6rem;color:var(--cobalt);margin-top:1px}
.mbx .mini .mp{margin-left:auto}

/* ---------- DECK (operations) ---------- */
.mbx.deck .grid{grid-template-columns:1.55fr 1fr}
.mbx .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.mbx .kpi{background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px 16px}
.mbx .kpi .kl{font-family:"Spline Sans Mono",monospace;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.mbx .kpi .kv{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.5rem;color:var(--navy);line-height:1;font-variant-numeric:tabular-nums}
.mbx .kpi.k1{border-top:3px solid var(--cobalt)}.mbx .kpi.k1 .kv{color:var(--cobalt)}
.mbx .kpi.k2{border-top:3px solid var(--green)}.mbx .kpi.k2 .kv{color:var(--greend)}
.mbx .kpi.k3{border-top:3px solid var(--gold)}
.mbx .kpi.k4{border-top:3px solid var(--navy)}
.mbx .port{display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center}
.mbx .donut-c{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.3rem;fill:var(--navy)}
.mbx .donut-l{font-family:"Spline Sans Mono",monospace;font-size:.55rem;letter-spacing:.08em;text-transform:uppercase;fill:var(--muted)}
.mbx .leg{display:flex;flex-direction:column;gap:8px}
.mbx .leg .row{display:flex;align-items:center;gap:9px;font-size:.86rem;color:var(--ink)}
.mbx .leg .dot{width:9px;height:9px;border-radius:50%;flex:none}
.mbx .leg .val{margin-left:auto;font-family:"Spline Sans Mono",monospace;font-size:.82rem;color:var(--muted)}
.mbx .area-lab{font-family:"Spline Sans Mono",monospace;font-size:.56rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:8px 0 6px}
.mbx table{width:100%;border-collapse:collapse;font-size:.87rem}
.mbx thead th{text-align:left;font-family:"Spline Sans Mono",monospace;font-size:.56rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:500;padding:9px 10px;border-bottom:1px solid var(--line)}
.mbx thead th.r{text-align:right}
.mbx tbody td{padding:12px 10px;border-bottom:1px solid #f0f3f8;vertical-align:middle}
.mbx tbody td.r{text-align:right}
.mbx tbody tr:last-child td{border-bottom:none}
.mbx tbody tr:hover{background:#f7f9fe}
.mbx .cn{font-family:"Newsreader",Georgia,serif;font-weight:500;color:var(--ink)}
.mbx .cn a{color:var(--ink);text-decoration:none}.mbx .cn a:hover{color:var(--cobalt)}
.mbx .cr{font-family:"Spline Sans Mono",monospace;font-size:.62rem;color:var(--cobalt)}
.mbx .amt{font-family:"Fraunces",Georgia,serif;font-variant-numeric:tabular-nums;color:var(--navy)}
.mbx .bid{font-family:"Spline Sans Mono",monospace;font-size:.8rem;color:var(--muted);font-variant-numeric:tabular-nums}
.mbx .bid .none{color:#95a0b8;font-style:italic;font-family:"Newsreader",Georgia,serif}
.mbx .need{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--line);align-items:flex-start}
.mbx .need:last-child{border-bottom:none;padding-bottom:0}.mbx .need:first-child{padding-top:0}
.mbx .need .nb{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;flex:none;font-family:"Spline Sans Mono",monospace;font-size:.85rem;background:rgba(224,151,42,.13);color:var(--goldd)}
.mbx .need .nb.c{background:var(--cobsoft);color:var(--cobalt)}
.mbx .need .nt{font-size:.86rem;color:var(--ink);font-weight:500}
.mbx .need .ns{font-family:"Spline Sans Mono",monospace;font-size:.66rem;color:var(--muted);margin-top:2px}
.mbx .need .gol{margin-left:auto;font-family:"Spline Sans Mono",monospace;font-size:.66rem;color:var(--cobalt);text-decoration:none;white-space:nowrap;align-self:center}
.mbx .feed{display:flex;gap:11px;padding:9px 0;font-size:.84rem;color:var(--muted)}
.mbx .feed .fd{width:7px;height:7px;border-radius:50%;margin-top:6px;flex:none}
.mbx .feed b{color:var(--ink);font-weight:500;font-family:"Newsreader",Georgia,serif}

/* biz hint (all non-empty modes) */
.mbx .biz{display:flex;align-items:center;gap:.7em;margin-top:18px;padding:.85em 1.1em;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:.88rem;color:var(--muted)}
.mbx .biz.earned{border-color:#ecdfc4;background:#fffdf7;color:var(--goldd)}
.mbx .biz svg{width:16px;height:16px;flex:none;color:var(--cobalt)}
.mbx .biz.earned svg{color:var(--goldd)}
.mbx .biz b{color:var(--navy)}.mbx .biz .sp{flex:1}.mbx .biz form{margin:0}
.mbx .bizask{font-family:"Spline Sans Mono",monospace;font-size:.78rem;color:var(--cobalt);background:none;border:none;cursor:pointer;white-space:nowrap;padding:0}
.mbx .biz.earned .bizask{color:var(--goldd)}

@media(max-width:820px){.mbx.focus .grid,.mbx.deck .grid{grid-template-columns:1fr}.mbx .kpis{grid-template-columns:repeat(2,1fr)}.mbx .port{grid-template-columns:1fr}}
</style>

<% if (mode === 'empty') { %>
  <%# navy ribbon comes from head; below = how it works %>
  <div class="mb-steps">
    <div class="mb-step">
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg></div>
      <h3>Name the dispute</h3><p>You start by naming your case and setting the stakes.</p>
    </div>
    <div class="mb-step raise">
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v18M7 21h10M12 6l-7 2 3 5a3 3 0 01-6 0l3-5M12 6l7 2-3 5a3 3 0 006 0l-3-5"/></svg></div>
      <h3>Set your private figures</h3><p>Both sides enter confidential amounts.</p>
    </div>
    <div class="mb-step">
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 12l3 3 2-2 4 4M3 10l4-4 3 3M14 8l3-3 4 4-4 4M11 13l-3 3-4-4"/></svg></div>
      <h3>Settle when they meet</h3><p>MidBid suggests a fair split when offers align.</p>
    </div>
  </div>

<% } else if (mode === 'focus') { %>
<div class="mbx focus">
  <% if (mineC.length) { %><div class="toolbar"><button type="button" class="exp" onclick="downloadMine()">&#8595; Export</button></div><% } %>
  <div class="grid">
    <div>
      <% if (heroCase) {
           let nbaTitle, nbaBody, primL='Open the case', primH='/cases/'+heroCase.id, ghost=null;
           if (heroCase.stage === 'awaiting') { nbaTitle='Waiting on the other side to join'; nbaBody='Your invitation is out. You can resend it if they haven\u2019t opened it yet.'; ghost='Resend invite'; }
           else if (heroCase.stalled) { nbaTitle='They\u2019ve gone quiet'; nbaBody='No reply for '+heroCase.age+' days. A reminder goes out automatically \u2014 or send one now.'; ghost='Send a reminder'; }
           else if (heroCase.stage === 'bidding' && heroCase.myLastBid == null) { nbaTitle='Set your figure for this round'; nbaBody='A round is open and you haven\u2019t committed a figure yet. Nothing is revealed to the other side.'; primL='Set my figure'; }
           else { nbaTitle='Nothing to do right now'; nbaBody='Your figure is sealed for this round. If the other side goes quiet, a reminder goes out automatically.'; ghost='Send a reminder'; }
      %>
      <div class="card">
        <div class="ch"><h3>Where things stand</h3><a href="/cases/<%= heroCase.id %>">Open case →</a></div>
        <div class="seal">
          <div><div class="sl">Your figure this round</div><div class="sv"><%= heroCase.myLastBid != null ? money(heroCase.myLastBid, heroCase.currency) + ' · sealed' : 'Not set yet' %></div></div>
          <div class="hint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg><span>Nothing is revealed until both figures meet.</span></div>
        </div>
        <div class="tl">
          <% if (heroCase.stage === 'bidding') { %>
            <div class="ev now"><div class="node"></div><div class="et">A round is in play</div><div class="es">now</div><div class="ec"><%= heroCase.myLastBid != null ? 'Your figure is sealed. Waiting on the other side to submit theirs.' : 'Set your figure to move this round forward.' %></div></div>
          <% } else if (heroCase.stalled) { %>
            <div class="ev now"><div class="node"></div><div class="et">The other party has gone quiet</div><div class="es"><%= heroCase.age %> days</div><div class="ec">A reminder is due to go out automatically.</div></div>
          <% } else if (heroCase.stage === 'awaiting') { %>
            <div class="ev now"><div class="node"></div><div class="et">Waiting on the other party to join</div><div class="es">invitation sent</div></div>
          <% } %>
          <% if (heroCase.myLastBid != null) { %><div class="ev you"><div class="node"></div><div class="et">You sealed your figure</div><div class="es">this round</div></div><% } %>
          <div class="ev done"><div class="node"></div><div class="et">Case opened</div><div class="es">MB-<%= heroCase.id %> &middot; <%= heroAge %> day<%= heroAge===1?'':'s' %> ago</div></div>
        </div>
      </div>
      <div class="card nba">
        <div class="nl">Your next move</div>
        <h3><%= nbaTitle %></h3><p><%= nbaBody %></p>
        <a class="btn solid" href="<%= primH %>"><%= primL %></a><% if (ghost) { %><a class="btn gold" href="/cases/<%= heroCase.id %>"><%= ghost %></a><% } %>
      </div>
      <% } else { %>
      <div class="card">
        <div class="ch"><h3>No active disputes</h3><a href="/cases/new">New case →</a></div>
        <p style="color:#586079;font-size:.95rem;margin:0">Everything's settled or closed for now. When you start a new dispute, it'll take over this space with a live timeline and your next move.</p>
      </div>
      <% } %>
    </div>
    <div>
      <% if (cases.filter(function(c){ return !heroCase || c.id !== heroCase.id; }).length) { %>
      <div class="card">
        <div class="ch"><h3>Your other cases</h3></div>
        <% cases.filter(function(c){ return !heroCase || c.id !== heroCase.id; }).slice(0,5).forEach(function(c){
             const pc = c.status === 'declined' ? 'declined' : (c.status === 'closed' ? 'closed' : c.stage);
             const pt = c.status === 'settled' ? 'Settled' : (c.stage === 'awaiting' ? 'Awaiting' : (c.stage === 'bidding' ? 'Bidding' : (c.stage === 'draft' ? 'Draft' : c.status))); %>
          <a class="mini" href="/cases/<%= c.id %>"><div><div class="mn"><%= c.title %></div><div class="mr">MB-<%= c.id %></div></div><span class="mp pill <%= pc %>"><%= pt %></span></a>
        <% }); %>
      </div>
      <% } %>
      <div class="card">
        <div class="ch"><h3>How blind bidding works</h3></div>
        <div class="feed" style="border:none;padding:2px 0"><b style="font-family:'Newsreader',serif">Your walk-away stays private.</b></div>
        <p style="color:#586079;font-size:.86rem;margin:0 0 12px">Only the settled number ever crosses, and only if you meet. One figure per round, sealed once committed. No settlement, no fee.</p>
      </div>
    </div>
  </div>
</div>
<% } %>

<% if (mode === 'deck') { %>
<div class="mbx deck">
  <% if (mineC.length) { %><div class="toolbar"><button type="button" class="exp" onclick="downloadMine()">&#8595; Export all</button></div><% } %>
  <div class="kpis">
    <div class="kpi k1"><div class="kl">Open disputes</div><div class="kv"><%= openC.length %></div></div>
    <div class="kpi k2"><div class="kl">Recovered</div><div class="kv"><%= money(recovered, cur) %></div></div>
    <div class="kpi k3"><div class="kl">In play</div><div class="kv"><%= money(openValue, cur) %></div></div>
    <div class="kpi k4"><div class="kl">Avg. days</div><div class="kv"><%= typical !== null ? typical : '\u2014' %></div></div>
  </div>
  <div class="grid">
    <div>
      <div class="card">
        <div class="ch"><h3>Portfolio health</h3></div>
        <div class="port">
          <svg width="132" height="132" viewBox="0 0 132 132">
            <circle cx="66" cy="66" r="52" fill="none" stroke="#eaf0ff" stroke-width="14"/>
            <circle cx="66" cy="66" r="52" fill="none" stroke="#23a259" stroke-width="14" stroke-linecap="round" stroke-dasharray="<%= donutDash %> <%= donutGap %>" transform="rotate(-90 66 66)"/>
            <text x="66" y="64" text-anchor="middle" class="donut-c"><%= settleRate %>%</text>
            <text x="66" y="82" text-anchor="middle" class="donut-l">settled</text>
          </svg>
          <div class="leg">
            <div class="row"><span class="dot" style="background:#23a259"></span>Settled<span class="val"><%= nSettled %></span></div>
            <div class="row"><span class="dot" style="background:#2b54e6"></span>In bidding<span class="val"><%= nBidding %></span></div>
            <div class="row"><span class="dot" style="background:#e0972a"></span>Awaiting party<span class="val"><%= nAwaiting %></span></div>
            <div class="row"><span class="dot" style="background:#c7cdda"></span>Declined / closed<span class="val"><%= nDeclined %></span></div>
            <div class="area-lab">Recovered · last 8 weeks</div>
            <svg width="100%" height="54" viewBox="0 0 260 54" preserveAspectRatio="none">
              <defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b54e6" stop-opacity=".22"/><stop offset="1" stop-color="#2b54e6" stop-opacity="0"/></linearGradient></defs>
              <path d="<%= areaPath %>" fill="url(#ag)"/>
              <path d="<%= linePath %>" fill="none" stroke="#2b54e6" stroke-width="2"/>
            </svg>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="ch"><h3>All cases</h3><a href="/dashboard">Full table →</a></div>
        <div style="overflow-x:auto">
        <table>
          <thead><tr><th>Case</th><th>Amount</th><th>Your figure</th><th>Status</th><th class="r">Next</th></tr></thead>
          <tbody>
          <% cases.slice(0, 8).forEach(function(c){
               const mine = c.claimant_id === me.id;
               const pc = c.status === 'declined' ? 'declined' : (c.status === 'closed' ? 'closed' : c.stage);
               let pt = c.status === 'settled' ? 'Settled' : (c.stage === 'awaiting' ? 'Awaiting' : (c.stage === 'bidding' ? 'Bidding' : (c.stage === 'draft' ? 'Draft' : c.status))); %>
            <tr>
              <td><div class="cn"><a href="/cases/<%= c.id %>"><%= c.title %></a></div><div class="cr">MB-<%= c.id %></div></td>
              <td class="amt"><%= money(c.amount, c.currency) %></td>
              <td class="bid"><% if (c.myLastBid != null) { %><%= money(c.myLastBid, c.currency) %><% } else { %><span class="none">—</span><% } %></td>
              <td><span class="pill <%= pc %>"><%= pt %></span></td>
              <td class="r"><% if (c.status === 'settled') { %><% if (!mine) { %><a class="btn go" href="/cases/<%= c.id %>">Pay</a><% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">View</a><% } %><% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">Open</a><% } %></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
    <div>
      <% if (needs.length) { %>
      <div class="card">
        <div class="ch"><h3>Needs you</h3></div>
        <% needs.forEach(function(n){ %>
          <div class="need"><div class="nb <%= n.k==='c'?'c':'' %>"><%= n.ic %></div><div><div class="nt"><%= n.t %></div><div class="ns"><%= n.s %></div></div><a class="gol" href="<%= n.href %>"><%= n.go %> →</a></div>
        <% }); %>
      </div>
      <% } %>
      <div class="card">
        <div class="ch"><h3>Recent activity</h3></div>
        <% if (activity.length) { activity.forEach(function(a){ %>
          <div class="feed"><span class="fd" style="background:<%= a.ic==='green'?'#23a259':(a.ic==='gold'?'#e0972a':'#2b54e6') %>"></span><div><b><%= a.t %></b><br><span style="font-family:'Spline Sans Mono',monospace;font-size:.72rem"><%= a.s %></span></div></div>
        <% }); } else { %><div class="feed">Nothing yet.</div><% } %>
      </div>
    </div>
  </div>

  <% if (me.account_type !== 'business') { %>
    <% if (me.business_requested) { %>
      <div class="biz"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span class="sp">Your <b>business portal</b> request is with us — we'll be in touch about a demo.</span></div>
    <% } else { %>
      <div class="biz earned"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5"/></svg><span class="sp">You're handling <b><%= cases.length %> disputes</b>. The <b>business portal</b> adds spreadsheet import, one bid bar across the lot, and bulk invites.</span><form method="POST" action="/business/request"><button type="submit" class="bizask">Ask for a demo &rarr;</button></form></div>
    <% } %>
  <% } %>
</div>
<% } %>

<% if (mode !== 'empty') { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE), wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases'); XLSX.writeFile(wb,'midbid-my-cases.xlsx');
}
</script>
<% } %>

<%- include('partials/foot') %>

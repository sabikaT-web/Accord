<div class="lf-top">
  <div class="lf-welcome">
    <h1>Your cases</h1>
    <p><%= cases.length ? (openC.length + ' open · ' + settled.length + ' settled') : 'No cases yet' %></p>
  </div>
</div>

<% if (cases.length === 0) { %>
  <div class="lf-shell" style="padding-top:22px">
    <div class="lf-empty">
      <p>No cases yet. Start one to invite the other party.</p>
      <a class="lf-btn primary" href="/cases/new" style="margin-top:14px">+ Start a new case</a>
    </div>
  </div>
<% } else { %>

<div class="lf-shell">
  <!-- KPI cards overlapping the dark band -->
  <div class="lf-kpis">
    <div class="lf-kpi k1"><div class="k">In your favour</div><div class="n"><%= money(owed, cur) %></div><div class="d">across <%= owedC.length %> open</div></div>
    <a class="lf-kpi k2" href="/dashboard?filter=<%= filter === 'attn' ? 'all' : 'attn' %>"><div class="k">Need attention</div><div class="n"><%= needs %></div><div class="d"><%= needs ? 'quiet or in-band' : 'nothing waiting' %></div></a>
    <div class="lf-kpi k3"><div class="k">Recovered</div><div class="n"><%= money(recovered, cur) %></div><div class="d">settled to date</div></div>
    <% if (typical !== null) { %><div class="lf-kpi k4"><div class="k">Typical settle</div><div class="n"><%= typical %><span style="font-size:1rem;color:#78849E"> days</span></div><div class="d">open to agreed</div></div><% } %>
  </div>

  <!-- filter chips + new-case -->
  <div class="lf-tools">
    <% var stageChips = [['all','All']].concat(STAGES.map(function(st){return [st, STAGE_META[st].label];})); %>
    <% stageChips.forEach(function(sc){ %>
      <a class="lf-chip <%= filter === sc[0] ? 'on' : '' %>" href="/dashboard?filter=<%= sc[0] %>"><%= sc[1] %></a>
    <% }); %>
    <div class="sp"></div>
    <button type="button" class="lf-chip" onclick="downloadMine()">&#8595; Export</button>
    <a class="lf-btn primary" href="/cases/new">+ New case</a>
  </div>

  <%
    const visible = cases.filter(function (c) {
      if (filter === 'all') return true;
      if (filter === 'attn') return c.stalled;
      return c.stage === filter;
    });
  %>
  <div class="lf-tbl"><div class="lf-tbl-scroll">
    <table class="lfcases">
      <thead><tr><th>Case</th><th>Original amount</th><th>Last bid</th><th>Status</th><th style="text-align:right">Next step</th></tr></thead>
      <tbody>
      <% visible.forEach(function (c) {
           const mine = c.claimant_id === me.id;
           const side = sideOf(c);   // 'owed' | 'owe' | null
           const pillClass = c.status === 'declined' ? 'declined' : (c.status === 'closed' ? 'closed' : c.stage);
           let pillText = STAGE_META[c.stage] ? STAGE_META[c.stage].label : c.status;
           if (c.stage === 'draft') pillText = 'Draft — not invited';
           if (c.stage === 'awaiting') pillText = 'Awaiting other party';
           if (c.status === 'settled') pillText = 'Settled at ' + money(c.settled_value, c.currency);
           if (c.status === 'declined') pillText = 'Declined';
           if (c.status === 'closed') pillText = 'Closed';
      %>
        <tr class="<%= (c.status === 'settled' || c.status === 'closed') ? 'done' : '' %> <%= side === 'owed' ? 'lf-b' : (side === 'owe' ? 'lf-a' : '') %>">
          <td>
            <div class="lf-nm"><a href="/cases/<%= c.id %>"><%= c.title %></a></div>
            <div class="lf-ref">MB-<%= c.id %></div>
            <% if (c.stalled) { %><div class="lf-sub">Quiet for <%= c.age %> days</div><% } %>
          </td>
          <td class="lf-amt"><%= money(c.amount, c.currency) %></td>
          <td class="lf-bid">
            <% if (c.myLastBid != null) { %><span class="val"><%= money(c.myLastBid, c.currency) %></span>
            <% } else { %><span class="none">no bid yet</span><% } %>
          </td>
          <td><span class="lf-pill <%= pillClass %>"><%= pillText %></span></td>
          <td style="text-align:right">
            <% if (c.status === 'settled') { %>
              <% if (!mine) { %><a class="lf-btn go" href="/cases/<%= c.id %>">Pay</a>
              <% } else { %><a class="lf-btn ghost" href="/cases/<%= c.id %>">View</a><% } %>
            <% } else { %><a class="lf-btn ghost" href="/cases/<%= c.id %>">Open</a><% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div></div>
  <% if (!visible.length) { %><p class="lf-empty">No cases match this view.</p><% } %>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
// Only cases you raised yourself can move workspace — ones you were invited into
// belong to you as a person, wherever they came from.
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Highest bid': c.highest == null ? '' : c.highest, 'Lowest bid': c.lowest == null ? '' : c.lowest,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE);
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases');
  XLSX.writeFile(wb,'midbid-my-cases.xlsx');
}
</script>

<% } %>
<% if (me.account_type !== 'business') { %>
  <% if (me.business_requested) { %>
    <div class="bizhint pending">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <span class="sp">Your <b>business portal</b> request is with us — we'll be in touch about a demo.</span>
    </div>
  <% } else { %>
    <div class="bizhint <%= cases.length >= 25 ? 'earned' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5"/></svg>
      <span class="sp">
        <% if (cases.length >= 25) { %>
          You're handling <b><%= cases.length %> disputes</b>. The <b>business portal</b> is built for exactly this — import them from a spreadsheet, set one bid bar across the lot, invite in bulk.
        <% } else { %>
          Handling <b>25 disputes or more</b>? There's a <b>business portal</b> for that — spreadsheet import, one bid bar across the lot, bulk invites.
        <% } %>
      </span>
      <%# A real request, not a mailto: draft. mailto only opens the visitor's mail app
          and relies on them hitting send — on a machine with no mail client set up it
          does nothing at all, and the request never reaches you. %>
      <form method="POST" action="/business/request" style="margin:0">
        <button type="submit" class="bizask">Ask for a demo &rarr;</button>
      </form>
    </div>
  <% } %>
<% } %>

<%- include('partials/foot') %>

<%
  // Personal, one-card-per-case dashboard (from the my-cases prototype), in MidBid's
  // real palette via the shared partials. Two states: 0 cases -> onboarding tiles;
  // otherwise -> welcome strip + a card per open case + helpers + past-cases history.
  // No pageHead (so no navy banner / no leaked email).
  const openCases = cases.filter(c => !['settled','declined','closed'].includes(c.status));
  const pastCases = cases.filter(c =>  ['settled','declined','closed'].includes(c.status));
  const mineC     = cases.filter(c => c.claimant_id === me.id);
  const N = openCases.length;
%>
<%- include('partials/head') %>

<style>
main > .wrap{max-width:1040px}
body{background:#eef1f7}

.mcx{--cobalt:#2b54e6;--cobsoft:#eaf0ff;--navy:#16213f;--ink:#101a3a;--muted:#586079;
  --line:#e4e9f4;--green:#23a259;--greend:#268a4f;--greensoft:#e3f5ea;--amber:#e0972a;
  color:var(--ink);font-family:"Hanken Grotesk",system-ui,sans-serif;max-width:980px;margin:0 auto}
.mcx *{box-sizing:border-box}

/* welcome strip */
.mcx .hi{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin:20px 0 22px}
.mcx .hello{font:600 .72rem/1 "Spline Sans Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:#8a93a8;margin-bottom:8px}
.mcx .bighead{font:500 1.85rem/1.1 "Fraunces",Georgia,serif;color:var(--navy);margin:0;letter-spacing:-.01em}
.mcx .subhead{margin:8px 0 0;color:var(--muted);font-size:.92rem;max-width:52ch;line-height:1.5}
.mcx .hi-r{display:flex;gap:8px;flex:none}
.mcx .exp{font:600 .72rem/1 "Spline Sans Mono",monospace;padding:10px 15px;border-radius:10px;border:1px solid #c7cdda;background:#fff;color:var(--muted);cursor:pointer}
.mcx .exp:hover{border-color:var(--cobalt);color:var(--cobalt)}
.mcx .newc{font:600 .72rem/1 "Spline Sans Mono",monospace;padding:10px 16px;border-radius:10px;background:var(--cobalt);color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--cobalt)}
.mcx .newc:hover{background:#1e4fd0}
.mcx .newc svg{width:15px;height:15px}

/* case cards */
.mcx .cases{display:flex;flex-direction:column;gap:16px}
.mcx .case{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 24px;position:relative;overflow:hidden}
.mcx .case.is-settled{border-color:#bfe6cf;box-shadow:0 0 0 1px rgba(35,162,89,.22),0 16px 34px -20px rgba(35,162,89,.3)}
.mcx .c-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:18px}
.mcx .pill{display:inline-flex;align-items:center;gap:7px;font:700 .6rem/1 "Spline Sans Mono",monospace;letter-spacing:.06em;text-transform:uppercase;padding:6px 11px;border-radius:999px;margin-bottom:9px}
.mcx .pill .d{width:6px;height:6px;border-radius:50%;flex:none}
.mcx .pill.awaiting{background:rgba(224,151,42,.14);color:#a9640f}.mcx .pill.awaiting .d{background:var(--amber)}
.mcx .pill.bidding{background:var(--cobsoft);color:var(--cobalt)}.mcx .pill.bidding .d{background:var(--cobalt)}
.mcx .pill.settled{background:var(--greensoft);color:var(--greend)}.mcx .pill.settled .d{background:var(--green)}
.mcx .pill.closed{background:#eef1f6;color:var(--muted)}.mcx .pill.closed .d{background:#9aa3b6}
.mcx .c-title{font:500 1.2rem/1.2 "Fraunces",Georgia,serif;color:var(--navy)}
.mcx .c-sub{font:500 .82rem/1 "Spline Sans Mono",monospace;color:var(--muted);margin-top:6px}
.mcx .c-amt{text-align:right;flex:none}
.mcx .c-amt .v{font:500 1.5rem/1 "Fraunces",Georgia,serif;color:var(--navy);font-variant-numeric:tabular-nums}
.mcx .c-amt .l{font:400 .72rem/1 "Spline Sans Mono",monospace;color:#9aa3b6;margin-top:5px}

/* stage bar (blind-safe: shows the case's own stage, not closeness to their figure) */
.mcx .stage{margin-bottom:18px}
.mcx .stage .ends{display:flex;justify-content:space-between;font:600 .68rem/1 "Spline Sans Mono",monospace;color:#9aa3b6;margin-bottom:8px}
.mcx .bar{height:9px;border-radius:999px;background:#eef1f7;overflow:hidden}
.mcx .bar span{display:block;height:100%;border-radius:999px}
.mcx .bar .f-await{width:30%;background:linear-gradient(90deg,#f2b64d,var(--amber))}
.mcx .bar .f-bid{width:64%;background:linear-gradient(90deg,#5f80ee,var(--cobalt))}
.mcx .bar .f-settled{width:100%;background:linear-gradient(90deg,#3fc07f,var(--green));box-shadow:0 0 12px rgba(35,162,89,.4)}
.mcx .stage .note{font-size:.82rem;color:var(--muted);margin-top:10px;line-height:1.45;display:flex;gap:7px;align-items:flex-start}
.mcx .stage .note svg{width:15px;height:15px;flex:none;margin-top:1px;color:var(--cobalt)}
.mcx .case.is-settled .stage .note svg{color:var(--green)}

.mcx .c-acts{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.mcx .btn{font:600 .8rem/1 "Hanken Grotesk",sans-serif;padding:11px 18px;border-radius:10px;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border:1px solid transparent;cursor:pointer}
.mcx .btn svg{width:15px;height:15px}
.mcx .btn.primary{background:var(--cobalt);color:#fff}.mcx .btn.primary:hover{background:#1e4fd0}
.mcx .btn.go{background:var(--green);color:#fff}.mcx .btn.go:hover{background:#1c8a4b}
.mcx .btn.ghost{background:#fff;border-color:#c7cdda;color:var(--navy)}.mcx .btn.ghost:hover{border-color:var(--navy)}

/* onboarding (0 cases) */
.mcx .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.mcx .step{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 22px 20px;text-decoration:none;color:inherit;transition:transform .15s,box-shadow .15s,border-color .15s}
.mcx .step:hover{transform:translateY(-3px);box-shadow:0 16px 32px -18px rgba(22,33,63,.4);border-color:#cdd6ea}
.mcx .ic{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.mcx .ic svg{width:24px;height:24px}
.mcx .ic-b{background:var(--cobsoft);color:var(--cobalt)}
.mcx .ic-g{background:var(--greensoft);color:var(--greend)}
.mcx .sn{font:700 .58rem/1 "Spline Sans Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:#9aa3b6;margin-bottom:6px}
.mcx .st{font:500 1.18rem/1.2 "Fraunces",Georgia,serif;color:var(--navy);margin-bottom:6px}
.mcx .sd{font-size:.86rem;color:var(--muted);line-height:1.45}
.mcx .step .go{margin-top:16px;font:600 .72rem/1 "Spline Sans Mono",monospace;color:var(--cobalt)}

/* helper cards */
.mcx .helps{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px}
.mcx .help{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px 22px}
.mcx .help .hh{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.mcx .help .hi2{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex:none}
.mcx .help .hi2 svg{width:20px;height:20px}
.mcx .help.blue .hi2{background:var(--cobsoft);color:var(--cobalt)}
.mcx .help.green .hi2{background:var(--greensoft);color:var(--greend)}
.mcx .help h3{font:500 1rem/1.2 "Fraunces",Georgia,serif;color:var(--navy);margin:0}
.mcx .help p{font-size:.86rem;color:var(--muted);line-height:1.55;margin:0}

/* past cases history */
.mcx .past{margin-top:26px}
.mcx .past summary{font:600 .8rem/1 "Hanken Grotesk",sans-serif;color:var(--muted);cursor:pointer;list-style:none;display:flex;align-items:center;gap:8px;margin-bottom:12px}
.mcx .past summary::-webkit-details-marker{display:none}
.mcx .past summary svg{width:15px;height:15px;transition:transform .15s}
.mcx .past[open] summary svg{transform:rotate(180deg)}
.mcx .prow{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin-bottom:8px}
.mcx .prow .pt{font:500 .95rem/1.2 "Fraunces",Georgia,serif;color:var(--navy)}
.mcx .prow .ps{font:400 .78rem/1 "Spline Sans Mono",monospace;color:var(--muted);margin-top:4px}
.mcx .prow .pr{display:flex;align-items:center;gap:14px;flex:none}
.mcx .prow .tag{font:700 .62rem/1 "Spline Sans Mono",monospace;text-transform:uppercase;letter-spacing:.06em}
.mcx .prow .tag.settled{color:var(--greend)}.mcx .prow .tag.closed{color:#9aa3b6}
.mcx .prow a{font:600 .78rem/1 "Hanken Grotesk",sans-serif;color:var(--cobalt);text-decoration:none}.mcx .prow a:hover{text-decoration:underline}

.mcx .noneopen{background:#fff;border:1px dashed #c7cdda;border-radius:16px;padding:26px;text-align:center;color:var(--muted)}
.mcx .noneopen a{color:var(--cobalt);font-weight:600;text-decoration:none}

@media(max-width:760px){.mcx .steps,.mcx .helps{grid-template-columns:1fr}}
</style>

<div class="mcx">

  <% if (cases.length === 0) { %>

    <div class="hi"><div>
      <div class="hello">Getting started</div>
      <h1 class="bighead">Welcome to MidBid</h1>
      <p class="subhead">Three steps to a settlement — start by naming your dispute.</p>
    </div></div>

    <div class="steps">
      <a class="step" href="/cases/new">
        <span class="ic ic-b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M8 13h8M8 17h6"/></svg></span>
        <span class="sn">Step 1</span><span class="st">Name the dispute</span>
        <span class="sd">Who&rsquo;s involved, what it&rsquo;s about, and the amount in play.</span>
        <span class="go">Start &rarr;</span>
      </a>
      <a class="step" href="/cases/new">
        <span class="ic ic-b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg></span>
        <span class="sn">Step 2</span><span class="st">Set your private figure</span>
        <span class="sd">Your walk-away number, sealed. The other side never sees it.</span>
        <span class="go">Continue &rarr;</span>
      </a>
      <a class="step" href="/cases/new">
        <span class="ic ic-g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16 9"/></svg></span>
        <span class="sn">Step 3</span><span class="st">Settle when they meet</span>
        <span class="sd">If both figures cross, it settles at the midpoint. No settlement, no fee.</span>
        <span class="go">Get started &rarr;</span>
      </a>
    </div>

  <% } else { %>

    <div class="hi">
      <div>
        <div class="hello">Welcome back</div>
        <h1 class="bighead">You have <%= N %> open case<%= N === 1 ? '' : 's' %></h1>
        <p class="subhead">Your sealed figure stays private — the other side never sees your number, only whether you&rsquo;ve met.</p>
      </div>
      <div class="hi-r">
        <% if (mineC.length) { %><button type="button" class="exp" onclick="downloadMine()">&#8595; Export</button><% } %>
        <a class="newc" href="/cases/new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Open a case</a>
      </div>
    </div>

    <% if (openCases.length) { %>
      <div class="cases">
        <% openCases.forEach(function(c){
             const mine = c.claimant_id === me.id;
             let cls, label, fill, note, endR;
             if (c.stage === 'bidding') {
               cls='bidding'; label='In bidding'; fill='f-bid'; endR='Settled';
               note='Both sides are bidding. Adjust your sealed figure any time before it locks.';
             } else if (c.stage === 'draft') {
               cls='closed'; label='Draft'; fill='f-await'; endR='Settled';
               note='This case is still a draft — finish setting it up to send the invitation.';
             } else {
               cls='awaiting'; label='Awaiting other party'; fill='f-await'; endR='Settled';
               note='Waiting for the other side to join and submit their figure.';
             } %>
          <div class="case">
            <div class="c-top">
              <div>
                <span class="pill <%= cls %>"><span class="d"></span><%= label %></span>
                <div class="c-title"><%= c.title %></div>
                <div class="c-sub"><%= mine ? 'You opened this' : 'You were invited' %> &middot; MB-<%= c.id %></div>
              </div>
              <div class="c-amt"><div class="v"><%= money(c.amount, c.currency) %></div><div class="l">in dispute</div></div>
            </div>
            <div class="stage">
              <div class="ends"><span>Opened</span><span><%= endR %></span></div>
              <div class="bar"><span class="<%= fill %>"></span></div>
              <div class="note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span><%= note %></span></div>
            </div>
            <div class="c-acts">
              <a class="btn primary" href="/cases/<%= c.id %>">Open case <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
              <% if (c.stage === 'awaiting' && mine) { %><a class="btn ghost" href="/cases/<%= c.id %>#inviteBox">Resend invite</a><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="noneopen">No open cases right now. <a href="/cases/new">Open a new dispute &rarr;</a></div>
    <% } %>

    <div class="helps">
      <div class="help blue">
        <div class="hh"><span class="hi2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg></span><h3>Your figures stay private</h3></div>
        <p>The other side never sees your number. When your figures meet, the midpoint locks and a settlement is created.</p>
      </div>
      <div class="help green">
        <div class="hh"><span class="hi2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16 9"/></svg></span><h3>No settlement, no fee</h3></div>
        <p>You only pay the small service charge if a deal is reached. If the figures never meet, MidBid costs you nothing.</p>
      </div>
    </div>

    <% if (pastCases.length) { %>
      <details class="past">
        <summary><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg><%= pastCases.length %> past case<%= pastCases.length === 1 ? '' : 's' %></summary>
        <% pastCases.forEach(function(c){
             const isSettled = c.status === 'settled'; %>
          <div class="prow">
            <div>
              <div class="pt"><%= c.title %></div>
              <div class="ps">MB-<%= c.id %><% if (isSettled && c.settled_value != null) { %> &middot; settled at <%= money(c.settled_value, c.currency) %><% } %></div>
            </div>
            <div class="pr">
              <span class="tag <%= isSettled ? 'settled' : 'closed' %>"><%= isSettled ? 'Settled' : 'Closed' %></span>
              <a href="/cases/<%= c.id %>"><%= isSettled ? 'View' : 'Open' %></a>
            </div>
          </div>
        <% }); %>
      </details>
    <% } %>

  <% } %>

</div>

<% if (mineC.length) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE), wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases'); XLSX.writeFile(wb,'midbid-my-cases.xlsx');
}
</script>
<% } %>

<%- include('partials/foot') %>

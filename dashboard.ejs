<%
  // ===== Data (same instruments as before) =====
  const sideOf = (c) => {
    if (c.creator_owes === null || c.creator_owes === undefined) return null;
    const isClaimant = c.claimant_id === me.id;
    const claimantOwes = c.creator_owes === true;
    return (isClaimant ? claimantOwes : !claimantOwes) ? 'owe' : 'owed';
  };
  const openC   = cases.filter(c => !['settled','declined','closed'].includes(c.status));
  const mineC   = cases.filter(c => c.claimant_id === me.id);
  const settled = cases.filter(c => c.status === 'settled');
  const sum = (arr, k) => arr.reduce((a, c) => a + (c[k] || 0), 0);
  const recovered = sum(settled.filter(c => c.claimant_id === me.id), 'settled_value');

  const spans = settled.filter(c => c.settled_at && c.created_at)
    .map(c => Math.max(0, Math.round((new Date(c.settled_at) - new Date(c.created_at)) / 86400000)));
  const typical = spans.length ? Math.round(spans.reduce((a,b)=>a+b,0)/spans.length) : null;

  const _cc = {}; cases.forEach(c => { const k = c.currency || 'GBP'; _cc[k] = (_cc[k]||0)+1; });
  const cur = Object.keys(_cc).sort((a,b) => _cc[b]-_cc[a])[0] || 'GBP';

  const monthAgo = Date.now() - 30*86400000;
  const settledRecent = settled.filter(c => c.settled_at && new Date(c.settled_at).getTime() >= monthAgo);
  const recoveredRecent = settledRecent.filter(c => c.claimant_id === me.id).reduce((a,c)=>a+(c.settled_value||0),0);

  // Hero: the one open case that most wants attention right now.
  const heroCase = openC.find(c => c.stalled) || openC.find(c => c.stage === 'bidding')
    || openC.slice().sort((a,b) => new Date(b.created_at) - new Date(a.created_at))[0] || null;
  const heroAge = heroCase ? (heroCase.age != null ? heroCase.age
    : Math.max(0, Math.round((Date.now() - new Date(heroCase.created_at))/86400000))) : 0;

  // Recent activity, derived from the cases we already have — no extra query.
  let activity = [];
  settled.forEach(c => activity.push({ ic:'green', t:'Settlement signed — MB-'+c.id,
    s: money(c.settled_value||0, c.currency)+' recovered', w: c.settled_at ? new Date(c.settled_at).getTime() : 0 }));
  cases.filter(c => c.stalled).forEach(c => activity.push({ ic:'gold', t:'MB-'+c.id+' has gone quiet',
    s: 'No reply for '+c.age+' days', w: Date.now() }));
  openC.filter(c => c.myLastBid != null).forEach(c => activity.push({ ic:'blue', t:'Your figure is sealed — MB-'+c.id,
    s: 'Waiting on the other side', w: c.created_at ? new Date(c.created_at).getTime() : 0 }));
  activity.sort((a,b) => b.w - a.w);
  activity = activity.slice(0, 4);

  const _h = new Date().getHours();
  const greet = _h < 12 ? 'Good morning' : (_h < 18 ? 'Good afternoon' : 'Good evening');
  const firstName = (me.name || 'there').split(' ')[0];
%>
<%- include('partials/head', { pageHead: null }) %>

<%# Newsreader for names — head only ships Fraunces/Hanken/Spline. %>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />

<style>
/* ===== Individual dashboard — case-page "Chambers" palette.
   Cobalt is the workhorse; gold is an accent only. Scoped under .mbdash. ===== */
.mbdash{--navy:#16213f;--navy-mid:#22376f;--cobalt:#2b54e6;--gold:#cf9c34;--gold-soft:#e0b34a;
  --gold-dark:#b5790f;--ink:#101a3a;--muted:#586079;--line:#e4e9f4;--success:#23a259;--success-d:#268a4f;
  --warning:#e0972a;--warning-d:#a9640f;--paper:#fff;--radius:16px}
.mbdash{color:var(--ink)}
.mbdash *{box-sizing:border-box}
body{background:#eef1f7}

.mbdash .db-pagehead{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin:10px 0 22px}
.mbdash .db-pagehead h1{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.7rem;letter-spacing:-.01em;color:var(--navy);margin:0}
.mbdash .db-pagehead p{color:var(--muted);margin-top:4px;font-size:.92rem;font-family:"Spline Sans Mono",monospace}
.mbdash .db-exp{font-family:"Spline Sans Mono",monospace;font-size:.72rem;padding:9px 14px;border-radius:10px;
  border:1px solid #c7cdda;background:#fff;color:var(--muted);cursor:pointer}
.mbdash .db-exp:hover{border-color:var(--cobalt);color:var(--cobalt)}

.mbdash .db-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.mbdash .db-kpi{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;transition:transform .15s,box-shadow .15s}
.mbdash .db-kpi:hover{transform:translateY(-2px);box-shadow:0 12px 34px -22px rgba(16,26,58,.4)}
.mbdash .db-kpi-l{font-family:"Spline Sans Mono",monospace;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.mbdash .db-kpi-v{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.7rem;letter-spacing:-.01em;color:var(--navy);line-height:1;font-variant-numeric:tabular-nums}
.mbdash .db-kpi-t{font-family:"Spline Sans Mono",monospace;font-size:.66rem;margin-top:7px;color:var(--muted)}
.mbdash .db-kpi-t.up{color:var(--success-d)}
.mbdash .db-kpi.a1{border-top:3px solid var(--cobalt)}.mbdash .db-kpi.a1 .db-kpi-v{color:var(--cobalt)}
.mbdash .db-kpi.a2{border-top:3px solid var(--gold)}
.mbdash .db-kpi.a3{border-top:3px solid var(--success)}.mbdash .db-kpi.a3 .db-kpi-v{color:var(--success-d)}
.mbdash .db-kpi.a4{border-top:3px solid var(--navy)}

.mbdash .db-hero{background:var(--paper);border:1px solid var(--line);border-radius:20px;overflow:hidden;margin-bottom:24px;box-shadow:0 16px 40px -30px rgba(16,26,58,.5)}
.mbdash .db-hero-top{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 100%);color:#fff;padding:26px 30px 22px;position:relative;overflow:hidden}
.mbdash .db-hero-top::after{content:"";position:absolute;right:-40px;top:-50px;width:190px;height:190px;border-radius:50%;background:radial-gradient(circle,rgba(224,179,74,.16),transparent 70%);pointer-events:none}
.mbdash .db-srow{display:flex;align-items:center;gap:12px;margin-bottom:12px;position:relative;z-index:2;flex-wrap:wrap}
.mbdash .db-spill{display:inline-flex;align-items:center;gap:7px;padding:5px 12px;border-radius:999px;font-family:"Spline Sans Mono",monospace;font-size:.68rem;letter-spacing:.02em}
.mbdash .db-spill.wait{background:rgba(224,151,42,.2);color:#f4c675;border:1px solid rgba(224,151,42,.35)}
.mbdash .db-spill.bid{background:rgba(47,107,255,.2);color:#a9c4ff;border:1px solid rgba(47,107,255,.4)}
.mbdash .db-spill.draft{background:rgba(255,255,255,.12);color:#d7deec;border:1px solid rgba(255,255,255,.2)}
.mbdash .db-spill .d{width:7px;height:7px;border-radius:50%;background:currentColor}
.mbdash .db-cid{font-family:"Spline Sans Mono",monospace;font-size:.72rem;color:rgba(255,255,255,.5)}
.mbdash .db-htitle{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.35rem;letter-spacing:-.01em;margin:0 0 4px;position:relative;z-index:2}
.mbdash .db-hmeta{font-size:.9rem;color:rgba(255,255,255,.68);position:relative;z-index:2}
.mbdash .db-hero-body{padding:24px 30px 28px}
.mbdash .db-seal{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:#f7f9fe;margin-bottom:20px}
.mbdash .db-seal-l{font-family:"Spline Sans Mono",monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.mbdash .db-seal-v{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.3rem;color:var(--ink);font-variant-numeric:tabular-nums}
.mbdash .db-seal-hint{display:flex;align-items:center;gap:8px;font-size:.86rem;color:var(--muted);max-width:340px}
.mbdash .db-seal-hint svg{width:16px;height:16px;flex:none;color:var(--gold-dark)}
.mbdash .db-seal-hint strong{color:var(--ink);font-weight:600}
.mbdash .db-hactions{display:flex;gap:12px;flex-wrap:wrap}
.mbdash .db-btn{font-family:inherit;font-size:.9rem;font-weight:500;padding:11px 20px;border-radius:10px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:8px;border:1.5px solid transparent}
.mbdash .db-btn-primary{background:var(--cobalt);color:#fff}.mbdash .db-btn-primary:hover{background:#1e4fd0;text-decoration:none}
.mbdash .db-btn-secondary{background:#fff;color:var(--navy);border-color:#c7cdda}.mbdash .db-btn-secondary:hover{border-color:var(--cobalt);color:var(--cobalt);text-decoration:none}

.mbdash .db-empty{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:40px 24px;text-align:center;color:var(--muted);margin-bottom:24px}
.mbdash .db-empty h2{font-family:"Fraunces",Georgia,serif;font-weight:500;color:var(--navy);font-size:1.3rem;margin:0 0 8px}

.mbdash .db-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:20px}
.mbdash .db-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px}
.mbdash .db-card-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.mbdash .db-card-h h3{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.05rem;color:var(--navy);margin:0}
.mbdash .db-card-h a{font-family:"Spline Sans Mono",monospace;font-size:.72rem;color:var(--cobalt);text-decoration:none}
.mbdash .db-card-h a:hover{text-decoration:underline}
.mbdash .db-act{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}
.mbdash .db-act:last-child{border-bottom:none;padding-bottom:0}
.mbdash .db-act:first-child{padding-top:0}
.mbdash .db-act-ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex:none}
.mbdash .db-act-ic svg{width:16px;height:16px}
.mbdash .db-act-ic.gold{background:rgba(207,156,52,.14);color:var(--gold-dark)}
.mbdash .db-act-ic.green{background:rgba(35,162,89,.13);color:var(--success-d)}
.mbdash .db-act-ic.blue{background:rgba(43,84,230,.11);color:var(--cobalt)}
.mbdash .db-act-t{font-size:.9rem;font-weight:500;color:var(--ink)}
.mbdash .db-act-s{font-family:"Spline Sans Mono",monospace;font-size:.72rem;color:var(--muted);margin-top:2px}
.mbdash .db-act-empty{color:var(--muted);font-size:.9rem;padding:6px 0}
.mbdash .db-tip{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.mbdash .db-tip:last-child{border-bottom:none;padding-bottom:0}
.mbdash .db-tip:first-child{padding-top:0}
.mbdash .db-tip-n{width:28px;height:28px;border-radius:8px;background:var(--navy);color:var(--gold-soft);display:grid;place-items:center;font-family:"Spline Sans Mono",monospace;font-weight:600;font-size:.8rem;flex:none}
.mbdash .db-tip-x{font-size:.88rem;color:var(--muted);line-height:1.5}
.mbdash .db-tip-x strong{color:var(--ink);font-weight:600}

.mbdash .db-biz{display:flex;align-items:center;gap:.7em;margin-top:20px;padding:.85em 1.1em;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:.88rem;color:var(--muted)}
.mbdash .db-biz.earned{border-color:#ecdfc4;background:#fffdf7;color:var(--gold-dark)}
.mbdash .db-biz.pending{background:#f7f9fd}
.mbdash .db-biz svg{width:16px;height:16px;flex:none;color:var(--cobalt)}
.mbdash .db-biz.earned svg{color:var(--gold-dark)}
.mbdash .db-biz b{color:var(--navy)}
.mbdash .db-biz .sp{flex:1}
.mbdash .db-biz form{margin:0}
.mbdash .db-bizask{font-family:"Spline Sans Mono",monospace;font-size:.78rem;color:var(--cobalt);background:none;border:none;cursor:pointer;white-space:nowrap;padding:0}
.mbdash .db-biz.earned .db-bizask{color:var(--gold-dark)}

@media(max-width:900px){.mbdash .db-kpis{grid-template-columns:repeat(2,1fr)}.mbdash .db-grid{grid-template-columns:1fr}}
@media(max-width:600px){.mbdash .db-kpis{grid-template-columns:1fr 1fr}.mbdash .db-hactions{flex-direction:column}.mbdash .db-btn{width:100%;justify-content:center}}
</style>

<div class="mbdash">

  <div class="db-pagehead">
    <div>
      <h1><%= greet %>, <%= firstName %></h1>
      <p><%= openC.length %> active <%= openC.length === 1 ? 'case' : 'cases' %><%= settled.length ? ' \u00b7 ' + settled.length + ' settled' : '' %></p>
    </div>
    <% if (mineC.length) { %><button type="button" class="db-exp" onclick="downloadMine()">&#8595; Export my cases</button><% } %>
  </div>

  <div class="db-kpis">
    <div class="db-kpi a1"><div class="db-kpi-l">Active cases</div><div class="db-kpi-v"><%= openC.length %></div><div class="db-kpi-t">in progress</div></div>
    <div class="db-kpi a2"><div class="db-kpi-l">Settled</div><div class="db-kpi-v"><%= settled.length %></div><div class="db-kpi-t <%= settledRecent.length ? 'up' : '' %>"><%= settledRecent.length ? '\u2191 '+settledRecent.length+' this month' : 'to date' %></div></div>
    <div class="db-kpi a3"><div class="db-kpi-l">Recovered</div><div class="db-kpi-v"><%= money(recovered, cur) %></div><div class="db-kpi-t <%= recoveredRecent ? 'up' : '' %>"><%= recoveredRecent ? '\u2191 '+money(recoveredRecent, cur)+' this month' : 'settled to date' %></div></div>
    <div class="db-kpi a4"><div class="db-kpi-l">Avg. days</div><div class="db-kpi-v"><%= typical !== null ? typical : '\u2014' %></div><div class="db-kpi-t">to settle</div></div>
  </div>

  <% if (heroCase) {
       let pillCls = 'draft', pillTxt = 'Draft \u2014 not invited yet';
       if (heroCase.stalled) { pillCls = 'wait'; pillTxt = 'Gone quiet \u2014 '+heroCase.age+' days'; }
       else if (heroCase.stage === 'awaiting') { pillCls = 'wait'; pillTxt = 'Awaiting the other party'; }
       else if (heroCase.stage === 'bidding') { pillCls = 'bid'; pillTxt = 'Round in play \u00b7 figure sealed'; }
  %>
  <div class="db-hero">
    <div class="db-hero-top">
      <div class="db-srow">
        <span class="db-spill <%= pillCls %>"><span class="d"></span><%= pillTxt %></span>
        <span class="db-cid">Case #MB-<%= heroCase.id %></span>
      </div>
      <h2 class="db-htitle"><%= heroCase.title %></h2>
      <p class="db-hmeta">vs. <%= heroCase.other_email || 'the other party' %> \u00b7 opened <%= heroAge %> day<%= heroAge === 1 ? '' : 's' %> ago \u00b7 <%= money(heroCase.amount, heroCase.currency) %> in dispute</p>
    </div>
    <div class="db-hero-body">
      <div class="db-seal">
        <div>
          <div class="db-seal-l">Your figure this round</div>
          <div class="db-seal-v"><%= heroCase.myLastBid != null ? money(heroCase.myLastBid, heroCase.currency) : 'Not set yet' %></div>
        </div>
        <div class="db-seal-hint">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
          <span>Sealed for this round. <strong>Nothing is revealed</strong> until both sides' figures meet.</span>
        </div>
      </div>
      <div class="db-hactions">
        <a class="db-btn db-btn-primary" href="/cases/<%= heroCase.id %>">Open case</a>
        <a class="db-btn db-btn-secondary" href="/cases/<%= heroCase.id %>">Adjust next round</a>
        <a class="db-btn db-btn-secondary" href="/cases/<%= heroCase.id %>">Private notes</a>
      </div>
    </div>
  </div>
  <% } else if (cases.length === 0) { %>
  <div class="db-empty">
    <h2>No cases yet</h2>
    <p>Start a dispute to invite the other party — nothing you enter is ever revealed unless your figures meet.</p>
    <a class="db-btn db-btn-primary" href="/cases/new" style="margin-top:16px">Start a new case</a>
  </div>
  <% } %>

  <div class="db-grid">
    <div class="db-card">
      <div class="db-card-h"><h3>Recent activity</h3><a href="/dashboard">All cases</a></div>
      <% if (activity.length) { activity.forEach(function(a){ %>
        <div class="db-act">
          <div class="db-act-ic <%= a.ic %>">
            <% if (a.ic === 'green') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg>
            <% } else if (a.ic === 'gold') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg><% } %>
          </div>
          <div>
            <div class="db-act-t"><%= a.t %></div>
            <div class="db-act-s"><%= a.s %></div>
          </div>
        </div>
      <% }); } else { %>
        <div class="db-act-empty">Nothing yet — activity shows up here as your cases move.</div>
      <% } %>
    </div>

    <div class="db-card">
      <div class="db-card-h"><h3>How blind bidding works</h3></div>
      <div class="db-tip"><div class="db-tip-n">1</div><div class="db-tip-x"><strong>Your walk-away stays private.</strong> Only the settled number ever crosses, and only if you meet.</div></div>
      <div class="db-tip"><div class="db-tip-n">2</div><div class="db-tip-x"><strong>One figure per round.</strong> Once sealed it stays sealed — no probing the other side.</div></div>
      <div class="db-tip"><div class="db-tip-n">3</div><div class="db-tip-x"><strong>No settlement, no fee.</strong> You only pay the service charge if the figures meet.</div></div>
    </div>
  </div>

  <% if (me.account_type !== 'business') { %>
    <% if (me.business_requested) { %>
      <div class="db-biz pending">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span class="sp">Your <b>business portal</b> request is with us — we'll be in touch about a demo.</span>
      </div>
    <% } else { %>
      <div class="db-biz <%= cases.length >= 25 ? 'earned' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5"/></svg>
        <span class="sp">
          <% if (cases.length >= 25) { %>You're handling <b><%= cases.length %> disputes</b>. The <b>business portal</b> is built for exactly this — spreadsheet import, one bid bar across the lot, bulk invites.
          <% } else { %>Handling <b>25 disputes or more</b>? There's a <b>business portal</b> for that — spreadsheet import, one bid bar across the lot, bulk invites.<% } %>
        </span>
        <form method="POST" action="/business/request"><button type="submit" class="db-bizask">Ask for a demo &rarr;</button></form>
      </div>
    <% } %>
  <% } %>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {
  'MidBid case ID': c.id, 'Debtor Company': c.title, 'Debtor Email': c.other_email || '',
  'Amount in dispute': c.amount, 'Currency': c.currency, 'MidBid status': c.stage,
  'Highest bid': c.highest == null ? '' : c.highest, 'Lowest bid': c.lowest == null ? '' : c.lowest,
  'Settled amount': c.settled_value == null ? '' : c.settled_value
}; })) %>;
function downloadMine(){
  if(!MINE.length){alert('You have no cases of your own to download.');return;}
  var ws=XLSX.utils.json_to_sheet(MINE);
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'My cases');
  XLSX.writeFile(wb,'midbid-my-cases.xlsx');
}
</script>

<%- include('partials/foot') %>

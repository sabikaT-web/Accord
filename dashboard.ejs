<%#
  MidBid dashboard (Option 2 layout). Self-contained EJS: own <head> + nav.
  If your other pages pull head/nav from a shared partial, you can swap the
  <head> block and the <header class="nav"> block for your <%- include(...) %>.

  DATA THIS VIEW EXPECTS from your /dashboard route (all have safe fallbacks,
  so the page still renders if a name differs — it just shows placeholders):
    user.username            -> nav name
    cases  (array)           -> the case rows; each item may use:
        .id / .case_id       -> shown as "MB-<id>", and links to /cases/<id>
        .title / .name / .subject
        .original_amount  (+ .currency)   or  .original_amount_display
        .last_bid         (+ .currency)   or  .last_bid_display
        .status / .status_label
    openCount, settledCount  -> the "X open, Y settled" heading
    inFavourDisplay  (or inFavourTotal + baseCurrency)
    attentionCount
    recoveredDisplay (or recoveredTotal + baseCurrency)
%>
<%
  var money = function(v, cur){
    if(v==null || v==='') return '';
    var s = ({GBP:'£',USD:'$',CAD:'$',EUR:'€',SGD:'$',INR:'₹'})[cur] || '£';
    var n = Number(v);
    return isNaN(n) ? v : s + n.toLocaleString('en-GB');
  };
  var uname = (locals.user && locals.user.username) ? locals.user.username : 'Account';
  var rows  = locals.cases || locals.disputes || locals.rows || [];
  var openN = (locals.openCount    != null) ? locals.openCount    : rows.length;
  var settN = (locals.settledCount != null) ? locals.settledCount : 0;
  var favour = locals.inFavourDisplay  || money(locals.inFavourTotal,  locals.baseCurrency) || '£0';
  var attn   = (locals.attentionCount != null) ? locals.attentionCount : 0;
  var recov  = locals.recoveredDisplay || money(locals.recoveredTotal, locals.baseCurrency) || '£0';
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MidBid · Your cases</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600;700&family=Spline+Sans+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --navy-deep:#0c1b3a;
    --navy:#132a54;
    --navy-mid:#1a3a6e;
    --blue:#1a3eb8;
    --ink:#0a1020;
    --soft:#2e3a4f;
    --faint:#5a6578;
    --line:#c8d0e0;
    --page:#e4e8f0;
    --gold:#e8c56a;
  }
  body{font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--page);min-height:100vh}

  /* nav */
  .nav{display:flex;align-items:center;justify-content:space-between;padding:14px 36px;background:#fff;border-bottom:1px solid #e4e9f4}
  .brand{display:flex;align-items:center;gap:10px;font:600 1.1rem/1 Newsreader,serif;color:var(--ink)}
  .brand .m{width:24px;height:24px;border-radius:50%;background:conic-gradient(from 200deg,#1a3eb8 0%,#c4a035 45%,#1a3eb8 100%)}
  .nav-r{display:flex;align-items:center;gap:20px;font-size:.88rem;color:var(--soft)}
  .nav-r a{color:var(--blue);text-decoration:none;font-weight:500}
  .nav-r a:hover{text-decoration:underline}

  /* single band — Option 2 (compacted to avoid scrolling) */
  .band{
    color:#fff;padding:18px 36px 22px;
    background:linear-gradient(115deg,var(--navy-deep) 0%,var(--navy) 50%,var(--navy-mid) 100%);
  }
  .band-top{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:16px}
  .eyebrow{font:600 .65rem/1 Inter;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
  .band h1{font:500 1.7rem/1.1 Fraunces,serif;letter-spacing:-.02em}
  .band .sub{margin-top:6px;font-size:.9rem;color:rgba(255,255,255,.8);line-height:1.4;max-width:42ch}
  .band-actions{display:flex;gap:10px;flex-shrink:0}
  .bbtn{
    font:600 .85rem/1 Inter;padding:10px 15px;border-radius:9px;cursor:pointer;text-decoration:none;display:inline-block;
    border:1px solid rgba(255,255,255,.4);background:transparent;color:#fff;
  }
  .bbtn:hover{background:rgba(255,255,255,.1)}
  .bbtn.solid{background:#fff;color:var(--navy-deep);border-color:#fff}
  .bbtn.solid:hover{background:#eef1f7}

  .kpi-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .kpi{
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
    border-radius:12px;padding:12px 16px;
  }
  .kpi .k{font:600 .6rem/1 Inter;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.65);margin-bottom:6px}
  .kpi .v{font:600 1.3rem/1 Fraunces,serif;color:#fff;letter-spacing:-.01em}
  .kpi .v.blue{color:#93b4ff}      /* In your favour — NOT green (green = settlement only) */
  .kpi .v.gold{color:var(--gold)}
  .kpi .v.green{color:#7ee0a8}     /* Recovered — settled money, so green is right here */
  .kpi .s{font-size:.78rem;color:rgba(255,255,255,.55);margin-top:5px}

  /* body */
  .body{max-width:1100px;margin:0 auto;padding:16px 28px 32px}

  .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
  .chip{
    font:600 .78rem/1 Inter;padding:9px 13px;border-radius:999px;
    border:1.5px solid var(--line);background:#fff;color:var(--soft);cursor:pointer;
  }
  .chip:hover{border-color:var(--ink)}
  .chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}

  .table{
    background:#fff;border:1.5px solid var(--line);border-radius:12px;overflow:hidden;
    box-shadow:0 2px 0 rgba(12,27,58,.04);
  }
  .thead{
    display:grid;grid-template-columns:1.5fr 1.1fr 1fr 1.2fr 40px;gap:8px;
    padding:10px 18px;font:700 .65rem/1 Inter;letter-spacing:.08em;text-transform:uppercase;
    color:var(--faint);background:#eef1f7;border-bottom:1px solid var(--line);
  }
  .trow{
    display:grid;grid-template-columns:1.5fr 1.1fr 1fr 1.2fr 40px;gap:8px;
    padding:12px 18px;align-items:center;font-size:.9rem;border-bottom:1px solid #eef1f7;
    text-decoration:none;color:inherit;transition:background .15s;
  }
  .trow:last-child{border-bottom:none}
  .trow:hover{background:#f7f9fc}
  .case-name{font-weight:600;color:var(--ink)}
  .case-id{font-size:.75rem;color:var(--faint);margin-top:3px;font-family:Spline Sans Mono,monospace}
  .amt{font-weight:600;font-variant-numeric:tabular-nums}
  .muted{color:var(--faint);font-style:italic;font-weight:400}
  .status{
    display:inline-block;font:600 .72rem/1 Inter;padding:6px 10px;border-radius:999px;
    background:#f5e6c8;color:#7a5c14;
  }
  .status.settled{background:#d8f0e0;color:#1c6b3f}   /* green ONLY for settled */
  .arrow{color:var(--faint);font-size:1.1rem;text-align:right}
  .empty{padding:26px 18px;text-align:center;color:var(--faint);font-size:.9rem}
  .empty a{color:var(--blue);font-weight:600;text-decoration:none}

  .biz{
    margin-top:14px;padding:14px 16px;background:#fff;border:1.5px solid var(--line);
    border-radius:12px;font-size:.85rem;color:var(--soft);line-height:1.45;
    display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;
  }
  .biz b{color:var(--ink)}
  .biz a{color:var(--blue);font-weight:600;text-decoration:none;white-space:nowrap}
  .biz a:hover{text-decoration:underline}

  @media(max-width:800px){
    .nav,.band{padding-left:18px;padding-right:18px}
    .body{padding:14px 16px 28px}
    .kpi-strip{grid-template-columns:1fr}
    .band h1{font-size:1.5rem}
    .thead,.trow{grid-template-columns:1.3fr 1fr 1.1fr;font-size:.82rem}
    .thead span:nth-child(3),.trow span:nth-child(3),
    .thead span:nth-child(5),.trow .arrow{display:none}
  }
</style>
</head>
<body>

  <header class="nav">
    <div class="brand"><span class="m"></span> MidBid</div>
    <div class="nav-r">
      <a href="/dashboard">My cases</a>
      <a href="/account"><%= uname %></a>
      <a href="/logout">Log out</a>
    </div>
  </header>

  <!-- ONE ribbon: title + actions, then KPI strip -->
  <section class="band">
    <div class="band-top">
      <div>
        <div class="eyebrow">Your cases</div>
        <h1><%= openN %> open, <%= settN %> settled</h1>
        <p class="sub">Open a new dispute, or continue one you are already part of.</p>
      </div>
      <div class="band-actions">
        <!-- point Export at your export route when ready -->
        <a class="bbtn" href="#">↓ Export</a>
        <a class="bbtn solid" href="/cases/new">+ New case</a>
      </div>
    </div>
    <div class="kpi-strip">
      <div class="kpi">
        <div class="k">In your favour</div>
        <div class="v blue"><%= favour %></div>
        <div class="s">across <%= openN %> open</div>
      </div>
      <div class="kpi">
        <div class="k">Attention Required</div>
        <div class="v gold"><%= attn %></div>
        <div class="s"><%= (attn && attn > 0) ? 'waiting on you' : 'nothing waiting' %></div>
      </div>
      <div class="kpi">
        <div class="k">Recovered</div>
        <div class="v green"><%= recov %></div>
        <div class="s">settled to date</div>
      </div>
    </div>
  </section>

  <main class="body">
    <div class="filters">
      <button type="button" class="chip on">All</button>
      <button type="button" class="chip">Draft</button>
      <button type="button" class="chip">Awaiting</button>
      <button type="button" class="chip">Bidding — rounds in play</button>
      <button type="button" class="chip">Settled</button>
    </div>

    <div class="table">
      <div class="thead">
        <span>Case</span>
        <span>Original amount</span>
        <span>Last bid</span>
        <span>Status</span>
        <span></span>
      </div>

      <% if (rows.length === 0) { %>
        <div class="empty">No cases yet — <a href="/cases/new">open your first dispute →</a></div>
      <% } %>

      <% rows.forEach(function(c){
        var cid    = (c.id != null) ? c.id : (c.case_id != null ? c.case_id : c.ref);
        var title  = c.title || c.name || c.subject || c.case_name || ('Case ' + cid);
        var amt    = c.original_amount_display || money((c.original_amount != null ? c.original_amount : c.amount), c.currency);
        var lastB  = c.last_bid_display || (c.last_bid != null && c.last_bid !== '' ? money(c.last_bid, c.currency) : '');
        var status = c.status_label || c.status || 'Awaiting other party';
        var settled = /settl/i.test(status);
      %>
      <a class="trow" href="/cases/<%= cid %>">
        <div>
          <div class="case-name"><%= title %></div>
          <div class="case-id">MB-<%= cid %></div>
        </div>
        <span class="amt"><%= amt || '—' %></span>
        <% if (lastB) { %>
          <span class="amt"><%= lastB %></span>
        <% } else { %>
          <span class="muted">no bid yet</span>
        <% } %>
        <span><span class="status<%= settled ? ' settled' : '' %>"><%= status %></span></span>
        <span class="arrow">→</span>
      </a>
      <% }); %>
    </div>

    <div class="biz">
      <span>Handling <b>25 disputes or more</b>? There&rsquo;s a business portal for that — spreadsheet import, one bid bar across the lot, bulk invites.</span>
      <a href="#">Ask for a demo →</a>
    </div>
  </main>

</body>
</html>

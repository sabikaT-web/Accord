<%
  var otherJoined = !!(c.claimant_id && c.respondent_id);
  var liveCase    = ['settled', 'closed', 'declined'].indexOf(c.status) === -1;
  var sentAt      = c.invited_at ? new Date(c.invited_at) : null;
  var days        = sentAt ? Math.floor((Date.now() - sentAt.getTime()) / 86400000) : null;
  var ago         = days === null ? '' : (days === 0 ? 'today' : days === 1 ? 'yesterday' : days + ' days ago');
  var stale       = days !== null && days >= 5;
  var progressPct = typeof progressFor === 'function' ? progressFor(c) : 34;
  var mediatorAlready = !!(c.mediator_requested || (pay && pay.mediatorRequested));

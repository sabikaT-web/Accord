  <div class="inv-msg <%= /Could not|does not look/.test(msg) ? 'bad' : '' %>"><%= msg %></div>
<% } %>

<!-- ===== BAND: full-bleed, single blue ===== -->
<div class="cx-band-wrap">
<div class="cx-band">
  <div>
    <div class="eyebrow">Case MB-<%= c.id %></div>
    <div class="title"><%= c.title %></div>
    <div class="statusline">
      <% if (c.status === 'settled') { %>
        <span class="apill"><span class="d"></span> Settled</span>
        <span class="rd"><%= money(c.settled_value, c.currency) %></span>
      <% } else if (liveCase) { %>
        <span class="apill"><span class="d"></span> Active</span>
        <span class="rd">Round <%= c.round || 1 %> · <%= otherJoined ? 'both parties on the case' : 'awaiting respondent' %></span>
      <% } else { %>
        <span class="apill" style="color:var(--mb-mut);background:#f3efe6;border-color:var(--line)"><span class="d" style="background:#8f877a;box-shadow:none"></span> <%= c.status %></span>
      <% } %>
    </div>
    <div class="prog">
      <div class="ptrack"><div class="pf" style="width:<%= progressPct %>%"></div><div class="pdot" style="left:<%= progressPct %>%"></div></div>
      <div class="plabels"><b>Opened</b><span>Both bid</span><span>Settled</span></div>
    </div>
    <% if (!otherJoined && liveCase) { %>
    <div class="bandbtns">
      <button type="button" class="bbtn" id="copyBtn">Copy invite link</button>
      <form method="post" action="/cases/<%= c.id %>/invite" style="display:inline;margin:0">
        <button type="submit" class="bbtn solid"><%= (c.invite_count && c.invite_count > 0) ? 'Resend invite' : 'Send invite' %></button>
      </form>
    </div>
    <% if (typeof inviteUrl !== 'undefined' && inviteUrl) { %>
      <div id="inviteBox" style="display:none"><%= inviteUrl %></div>
    <% } %>
    <% } %>
  </div>
  <div class="fpanel">
    <div><div class="fk">Case reference</div><div class="fv ref">MB-<%= c.id %></div></div>
    <% const clName = c.claimant_name || c.claim_full_name; %>
    <% const rpName = c.respondent_name || c.resp_full_name; %>
    <% if (role === 'resp') { %>
      <div><div class="fk">Respondent · you</div><div class="fv"><%= rpName || 'You' %></div></div>
      <div><div class="fk">Claimant</div><div class="fv"><%= clName || '—' %></div></div>
    <% } else { %>
      <div><div class="fk">Claimant · you</div><div class="fv"><%= clName || 'You' %></div></div>
      <div><div class="fk">Respondent</div><div class="fv"><%= rpName || 'Awaiting' %></div></div>
    <% } %>
    <div><div class="fk">Original amount</div><div class="fv amt"><%= money(c.amount, c.currency) %></div></div>
  </div>
</div>

</div>
<!-- ===== BODY (balanced columns) ===== -->
<div class="cx-body">
  <div class="cx-grid">

    <!-- LEFT: Timeline + Private notes -->
    <div class="cx-stack">
      <div class="cx-card cx-pad">
        <span class="cx-ceyebrow">Case activity</span>
        <h3 class="cx-ct">Timeline</h3>
        <div class="cx-tl">
          <div class="cx-ti g"><div class="h">Case opened</div><div class="t"><%= fmtDate(c.created_at) %></div></div>
          <% if (c.invited_at) { %>
          <div class="cx-ti a"><div class="h">Invitation sent</div><div class="t"><%= fmtDate(c.invited_at) %></div></div>
          <% } %>
          <% if ((role === 'claim' ? c.claim_value : c.resp_value) != null) { %>
          <div class="cx-ti">
            <div class="h">Your figures saved<% if (role === 'claim' && c.claim_value != null) { %><div class="tsub">Minimum acceptable amount · <%= money(c.claim_value, c.currency) %></div><% } %></div>
            <div class="t">—</div>
          </div>
          <% } %>
          <% if (c.status === 'settled') { %>
          <div class="cx-ti g"><div class="h">Settled at <%= money(c.settled_value, c.currency) %></div><div class="t"><%= fmtDate(c.settled_at) %></div></div>
          <% } else { %>
          <div class="cx-ti now"><div class="h"><%= otherJoined ? 'Both parties on the case' : 'Awaiting the other party' %></div><div class="t">Current</div></div>
          <% } %>
        </div>
      </div>

      <div class="cx-card cx-pad cx-notes">
        <span class="cx-ceyebrow">Private notes</span>
        <h3 class="cx-ct">Your working notes</h3>
        <p class="cx-muted" style="margin:4px 0 10px">Visible only to you. Never shared with the other party.</p>
        <form method="post" action="/cases/<%= c.id %>/notes">
          <textarea name="notes" maxlength="4000" placeholder="Record context, solicitor advice, or your thinking for this case…"><%= typeof privateNotes !== 'undefined' ? privateNotes : '' %></textarea>
          <div class="meta">
            <span class="cx-lock">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              Private to you
            </span>
            <button type="submit" class="btn btn-primary" style="padding:9px 16px;font-size:13px">Save notes</button>
          </div>
        </form>
      </div>
    </div>

    <!-- RIGHT: Scale (full interactive) + Documents -->
    <div class="cx-stack">
<div class="card mb-card <%= role === 'claim' ? 'tint-claim' : 'tint-resp' %><%= c.status === 'settled' ? ' is-settled' : '' %>">
  <div class="mb-schead">
    <span class="mb-eyebrow">Your private figures</span>
    <span class="mb-rolechip">You &mdash; <%= role === 'claim' ? 'Claimant' : 'Respondent' %></span>
  </div>
  <% if (c.status === 'settled') { %>
  <div class="mb-settled">
    <span class="msg-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg></span>
    <div>
      <span class="msg-lab">Settled — <%= role === 'claim' ? 'you will receive' : 'you will pay' %></span>
      <span class="msg-amt"><%= money(c.settled_value, c.currency) %></span>
      <span class="msg-sub">Agreed at the midpoint and locked in by both sides.</span>
    </div>
  </div>
  <% } else { %>
  <div class="mb-direction <%= role === 'claim' ? 'paid' : 'pay' %>">
    <span class="dlabel"><%= role === 'claim' ? 'You will be paid' : 'You will pay' %></span>
    <span class="dsub"><%= role === 'claim' ? 'These are the amounts you would accept — from your ideal down to your walk-away.' : 'These are the amounts you would pay — from your ideal up to your walk-away.' %></span>
  </div>
  <% } %>
  <div class="mb-figwrap">
    <div class="mb-fig"><%= cur.symbol %><span id="figNum">0</span></div>
    <div class="mb-figrole" id="figRole">Drag the three handles to set your figures</div>
  </div>

  <div class="mb-chips" id="chips">
    <div class="mb-chip" data-slot="ideal"><span class="k" id="kIdeal">Ideal</span><span class="v"><%= cur.symbol %><span id="vIdeal">0</span></span></div>
    <div class="mb-chip" data-slot="fair"><span class="k">Target</span><span class="v"><%= cur.symbol %><span id="vFair">0</span></span></div>
    <div class="mb-chip" data-slot="res"><span class="k" id="kRes">Walk-away</span><span class="v"><%= cur.symbol %><span id="vRes">0</span></span></div>
  </div>

  <div class="mb-track" id="track">
    <div class="mb-band" id="band"></div>
    <div class="mb-h" id="hIdeal" data-slot="ideal"><span class="dot"></span></div>
    <div class="mb-h" id="hFair" data-slot="fair"><span class="dot"></span></div>
    <div class="mb-you" id="you"><span class="hub"></span><span class="ring" id="ring"><span class="od-blue"></span></span></div>
    <div class="mb-pops" id="pops"></div>
  </div>
  <div class="mb-scale"><span><%= cur.symbol %>0</span><span><%= cur.symbol %><%= fmt(Math.round(c.amount/2)) %></span><span><%= cur.symbol %><%= fmt(c.amount) %></span></div>

  <%# This slot used to hold the proximity bar — the thing that told you how close
      you were, and so let you find the other side's number by nudging. It is gone.
      What belongs here instead is the rule that replaced it. %>
  <div class="mb-oneway" id="onewayNote">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7" id="onewayArrow" />
    </svg>
    <span id="onewayText"></span>
  </div>

  <%# Shown when a round has closed with no deal and it is your turn to move again.
      It deliberately says nothing about how close the two sides were — that would be
      the leak. It points at your own figure, which is the only thing you should be
      thinking about. %>
  <div class="mb-nudge" id="roundNudge" hidden>
    <div class="mb-nudge-top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
      </svg>
      <div>
        <b id="nudgeTitle">Round closed — no agreement yet</b>
        <span id="nudgeSub">You can revise your figure and bid again. The moment your ranges meet, it settles.</span>
      </div>
    </div>
  </div>

  <div class="coach tone-<%= status.coach ? status.coach.tone : 'idle' %>" id="coachBox" <%= status.coach ? '' : 'style="display:none"' %>>
    <span class="coach-badge">midbid</span>
    <span class="coach-text" id="coachText"><%= status.coach ? status.coach.text : '' %></span>
  </div>

  <div class="mb-ask" id="bidAsk" role="dialog" aria-modal="true" aria-labelledby="askTitle">
    <div class="mb-ask-box">
      <div class="mb-ask-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M12 8v5M12 16.5v.01" /><circle cx="12" cy="12" r="9" />
        </svg>
      </div>
      <h3 id="askTitle">Submit these figures?</h3>
      <p id="askBody"></p>
      <div class="mb-ask-figs" id="askFigs"></div>
      <p class="mb-ask-warn" id="askWarn"></p>
      <div class="mb-ask-foot">
        <button type="button" class="btn btn-ghost" id="askNo">Not yet</button>
        <button type="button" class="btn btn-gold" id="askYes">Submit &amp; lock</button>
      </div>
    </div>
  </div>

  <div class="mb-actions">
    <button class="btn btn-primary" type="button" id="saveBtn">Save my figures</button>
    <button class="btn btn-ghost" type="button" id="resetBtn" title="The figures will go back to your last saved numbers.">Reset</button>
    <button class="mb-approve" type="button" id="approve" style="display:none"><span class="lbl" id="approveLbl">Settle</span></button>
    <span class="muted" id="saveHint"></span>
    <span class="muted" id="roundLine" style="display:none" aria-hidden="true"></span>
  </div>


      <div class="cx-card cx-pad" id="documents">
        <span class="cx-ceyebrow">Evidence</span>
        <h3 class="cx-ct">Documents</h3>
        <p class="cx-muted" style="margin:4px 0 10px">Add at any stage of the case.</p>
        <div class="cx-docs-row">
          <form method="post" action="/cases/<%= c.id %>/documents" enctype="multipart/form-data" style="margin:0">
            <label class="cx-drop" for="docInput">
              <strong>Add files</strong>
              <span>PDF, JPG, PNG · 5 MB each</span>
            </label>
            <input type="file" name="documents" id="docInput" multiple
                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,.txt,.csv"
                   style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden"
                   onchange="this.form.submit()">
          </form>
          <div>
            <% if (typeof docs !== 'undefined' && docs && docs.length) { %>
              <% docs.forEach(function(d){ %>
                <a class="cx-file" href="/cases/<%= c.id %>/documents/<%= d.id %>" target="_blank" rel="noopener" style="margin-top:0;margin-bottom:8px;display:flex">
                  <span class="fi"><%= (d.mime||'').indexOf('pdf')>=0 ? 'PDF' : 'DOC' %></span>
                  <div>
                    <div class="fn"><%= d.filename %></div>
                    <div class="fs"><%= d.size ? (Math.round(d.size/1024)+' KB') : '' %></div>
                  </div>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mediator full width -->
  <div class="cx-mediator">
    <div>
      <div class="mb">Stuck? Bring in a mediator.</div>
      <div class="ms">An accredited human mediator can help close the gap. Both parties must agree.<%= (pay && pay.mediatorNote) ? (' ' + pay.mediatorNote) : '' %></div>
    </div>
    <button type="button" class="mbtn" id="mediatorBtn" <%= mediatorAlready ? 'disabled' : '' %>>
      <span id="mediatorLbl"><%= mediatorAlready ? '✓ Human mediator requested' : 'Request a human mediator' %></span>
    </button>
  </div>
</div>

<script>
(function(){
  var copyBtn = document.getElementById('copyBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function(){
      var box = document.getElementById('inviteBox');
      if (!box) return;
      var text = box.textContent.trim();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function(){
          copyBtn.textContent = 'Copied!';
          setTimeout(function(){ copyBtn.textContent = 'Copy invite link'; }, 1500);
        });
      }
    });
  }
})();
</script>
<script>
  var AMOUNT = <%= c.amount %>;
  var CUR = { symbol: <%- JSON.stringify(cur.symbol) %>, locale: <%- JSON.stringify(cur.locale) %> };
  var CASE_ID = <%= c.id %>;
  var ROLE = '<%= role %>';                       // 'claim' (wants high) or 'resp' (wants low)
  var INIT = <%- JSON.stringify({ mine: status.mine, state: status.state, locked: !!status.locked,
    round: status.round, limit: status.limit, limitText: status.limitText,
    coach: status.coach, theirBidIn: !!status.theirBidIn, settledValue: status.settledValue,
    settleReason: status.settleReason }) %>;
  var CASE_TITLE = <%- JSON.stringify(c.title) %>;

  // Round-advance / settle auto-refresh. Once BOTH sides have bid, the server opens the
  // next round (or settles) — but a page that has already bid latches 'locked' and stops
  // updating. Poll for the round moving on and reload, so neither side stays stuck on
  // "Locked in for round N" after the round has actually turned over.
  (function(){
    if (INIT && INIT.state === 'settled') return;
    var startRound = (INIT && INIT.round) ? INIT.round : 1;
    var adv = setInterval(function(){
      fetch('/cases/' + CASE_ID + '/status').then(function(r){ return r.json(); }).then(function(s){
        if (!s) return;
        if (s.state === 'settled') { clearInterval(adv); location.reload(); return; }
        if (s.round && s.round > startRound) { clearInterval(adv); location.reload(); }
      }).catch(function(){});
    }, 5000);
  })();

  var track=document.getElementById('track'), you=document.getElementById('you'), ring=document.getElementById('ring');
  var hIdeal=document.getElementById('hIdeal'), hFair=document.getElementById('hFair'), band=document.getElementById('band');
  var figNum=document.getElementById('figNum'), figRole=document.getElementById('figRole'), pops=document.getElementById('pops');
  var vIdeal=document.getElementById('vIdeal'), vFair=document.getElementById('vFair'), vRes=document.getElementById('vRes');
  var kIdeal=document.getElementById('kIdeal'), kRes=document.getElementById('kRes');
  var saveBtn=document.getElementById('saveBtn'), saveHint=document.getElementById('saveHint');
  var btn=document.getElementById('approve'), approveLbl=document.getElementById('approveLbl');
  var coachBox=document.getElementById('coachBox'), coachText=document.getElementById('coachText');
  var proxFill=document.getElementById('proxFill'), proxText=document.getElementById('proxText');
  var medWrap=document.getElementById('medWrap'), chips=document.getElementById('chips');

  // Role-aware labels. Both roles read left->right as [low, mid, high].
  // The rule, said the way it actually applies to you. A claimant's walk-away can
  // only fall; a respondent's ceiling can only rise. "Cannot be reduced" is only
  // true for one of them, so neither gets told the other's version.
  function setOneway(s){
    var box = document.getElementById('onewayNote');
    var txt = document.getElementById('onewayText');
    var arw = document.getElementById('onewayArrow');
    if(!box || !txt) return;
    if(s && s.state === 'settled'){ box.style.display = 'none'; return; }
    box.style.display = 'flex';
    if(s && s.locked){
      box.classList.add('locked');
      arw.setAttribute('d','M5 12h14M12 5l7 7-7 7');
      txt.innerHTML = 'Locked for this round. Your figures cannot be changed until the other side has bid.';
      return;
    }
    box.classList.remove('locked');
    arw.setAttribute('d', ROLE==='claim' ? 'M12 5v14M5 12l7 7 7-7' : 'M12 19V5M5 12l7-7 7 7');
    var base = ROLE==='claim'
      ? 'One way only — each bid moves you toward a settlement, never away from it. Once you commit a figure it stays committed, and can\'t be taken back.'
      : 'One way only — each bid moves you toward a settlement, never away from it. Once you commit a figure it stays committed, and can\'t be taken back.';
    if(s && s.limitText) base += ' ' + s.limitText;
    txt.innerHTML = base;
  }

  var LBL = ROLE==='claim'
    ? { res:'The least you’ll accept', fair:'Your target figure', ideal:'Your ideal outcome', kIdeal:'Ideal', kRes:'Walk-away' }
    : { res:'The most you’ll pay',     fair:'Your target figure', ideal:'Your ideal outcome', kIdeal:'Ideal', kRes:'Walk-away' };
  kIdeal.textContent=LBL.kIdeal; kRes.textContent=LBL.kRes;

  // slot fractions, always lo <= mid <= hi (left to right on the track)
  var MINGAP=0.015, lo, mid, hi;
  function fracFromVal(v){ return Math.max(0,Math.min(1, v/AMOUNT)); }
  if (INIT.mine && INIT.mine.reservation!=null){
    var a=INIT.mine;
    if (ROLE==='claim'){ lo=fracFromVal(a.reservation); mid=fracFromVal(a.fair!=null?a.fair:a.reservation); hi=fracFromVal(a.ideal!=null?a.ideal:a.fair); }
    else { hi=fracFromVal(a.reservation); mid=fracFromVal(a.fair!=null?a.fair:a.reservation); lo=fracFromVal(a.ideal!=null?a.ideal:a.fair); }
  } else {
    if (ROLE==='claim'){ lo=0.40; mid=0.60; hi=0.80; } else { lo=0.20; mid=0.40; hi=0.60; }
  }
  var savedLo=lo, savedMid=mid, savedHi=hi;
  function order(){ if(mid<lo+MINGAP)mid=lo+MINGAP; if(hi<mid+MINGAP)hi=mid+MINGAP; if(hi>1){hi=1; if(mid>hi-MINGAP)mid=hi-MINGAP; if(lo>mid-MINGAP)lo=mid-MINGAP;} if(lo<0)lo=0; }

  // map slots -> meaning
  function resFrac(){ return ROLE==='claim'?lo:hi; }
  function idealFrac(){ return ROLE==='claim'?hi:lo; }
  function anchorsGBP(){
    return { ideal:Math.round(idealFrac()*AMOUNT), fair:Math.round(mid*AMOUNT), reservation:Math.round(resFrac()*AMOUNT) };
  }

  var dragging=null, lastPopX=null, locked=false;
  var gClose=false, phase='negotiate', t=0, btnX=0, btnY=0, btnW=120, btnH=36, circleStart=0;

  function gbp(n){ return Number(n).toLocaleString(CUR.locale); }

  function makeSnake(hex, glow){
    var layer=document.createElement('div'); layer.className='mb-snake'; track.appendChild(layer);
    var segs=[];
    for(var i=0;i<8;i++){
      var s=document.createElement('span'); s.className='seg'; var size=14-i;
      s.style.width=size+'px'; s.style.height=size+'px'; s.style.background=hex; s.style.opacity=(1-i*0.1).toFixed(2);
      s.style.boxShadow='0 0 '+(10-i)+'px '+Math.max(0.5,(3-i*0.25)).toFixed(2)+'px '+glow.replace('A',(0.5-i*0.045).toFixed(2));
      layer.appendChild(s); segs.push(s);
    }
    return {layer:layer, segs:segs, hist:[], x:0.5*520, y:0};
  }
  var yellow=makeSnake('#c27803','rgba(245,180,0,A)');
  var blue=makeSnake('#3d5a80','rgba(61,90,128,A)'); blue.layer.style.display='none';

  function placeAll(){
    order();
    you.style.left=(resFrac()*100)+'%';
    hFair.style.left=(mid*100)+'%';
    hIdeal.style.left=(idealFrac()*100)+'%';
    band.style.left=(lo*100)+'%';
    band.style.width=((hi-lo)*100)+'%';
    var a=anchorsGBP();
    vIdeal.textContent=gbp(a.ideal); vFair.textContent=gbp(a.fair); vRes.textContent=gbp(a.reservation);
    you.setAttribute('aria-valuenow',a.reservation);
  }
  function headline(slot){
    var a=anchorsGBP();
    if(slot==='ideal'){ figNum.textContent=gbp(a.ideal); figRole.textContent=LBL.ideal; }
    else if(slot==='res'){ figNum.textContent=gbp(a.reservation); figRole.textContent=LBL.res; }
    else { figNum.textContent=gbp(a.fair); figRole.textContent=LBL.fair; }
    [].forEach.call(chips.children,function(ch){ ch.classList.toggle('sel', ch.getAttribute('data-slot')===slot); });
  }
  // chip click jumps the headline to that figure
  [].forEach.call(chips.children,function(ch){ ch.addEventListener('click',function(){ headline(ch.getAttribute('data-slot')); }); });

  function setCoach(tone,text){
    if(!coachBox)return;
    if(!text){ coachBox.style.display='none'; return; }
    var changed=coachText.textContent!==text;
    coachText.textContent=text; coachBox.className='coach tone-'+(tone||'idle'); coachBox.style.display='flex';
    if(changed){ coachBox.classList.remove('pop'); void coachBox.offsetWidth; coachBox.classList.add('pop'); }
  }
  // setProx() is gone with the proximity bar. Its elements no longer exist, so
  // calling it would throw on load and take the whole page's script with it.
  function setApprove(state){
    btn.classList.remove('ready');
    if(state==='ready'){ btn.classList.add('ready'); approveLbl.textContent='Settle'; }
    else if(state==='waiting'){ approveLbl.textContent='Waiting for the other side…'; }
    else if(state==='green'){ btn.classList.add('is-green'); approveLbl.textContent='Settle'; }
    else { approveLbl.textContent='Settle'; }
  }

  function applyStatus(s){
    if(!s) return;
    var nudge = document.getElementById('roundNudge');
    if(nudge){
      // Only when a later round is open and you have not yet bid in it. Never carries
      // any hint of the gap — just that the round turned over and it is your move.
      var showNudge = (s.state === 'round_open') && !s.locked;
      nudge.hidden = !showNudge;
      if(showNudge && s.round){
        document.getElementById('nudgeTitle').textContent = 'Round ' + (s.round - 1) + ' closed — no agreement yet';
      }
    }
    gClose = false;                       // there is no "close" signal any more — that WAS the leak
    LIMIT = (s.limit != null) ? s.limit : null;
    // Settled first: hide both status bars, then run the seal. Stops the "Locked…"
    // bar lingering / flashing yellow once the case is done.
    if(s.state==='settled'){
      var _ob=document.getElementById('onewayNote'); if(_ob) _ob.style.display='none';
      setCoach('idle','');
      runSeal(); return;
    }
    setOneway(s);
    if(locked) return;

    // Your bid for this round is in. It cannot be changed, and nothing about the
    // other side is shown — so there is nothing here to probe with.
    if(s.locked){ lockRound(s); return; }

    phase='negotiate';
    setApprove('idle');
    roundLine(s);
    if(s.coach){
      // Don't repeat the status bar's message as a coach line.
      var _dupe = s.locked || /waiting for the other side to bid/i.test(s.coach.text || '');
      setCoach(s.coach.tone, _dupe ? '' : s.coach.text);
    }
  }

  var LIMIT = null;                       // your previous walk-away: the one-way rule
  function lockRound(s){
    phase='sealed';
    setOneway(s);
    [hIdeal,hFair,you].forEach(function(h){ if(h){ h.style.pointerEvents='none'; h.style.opacity='.55'; } });
    saveBtn.disabled = true;
    saveBtn.textContent = 'Locked in for round ' + s.round;
    setApprove('idle');
    if(btn) btn.style.display='none';
    setCoach('idle', '');   // one-way bar already carries "Locked… until the other side has bid"
    roundLine(s);
  }
  function roundLine(s){
    /* Round / limit line removed from UI — limit still enforced server-side */
    var el = document.getElementById('roundLine');
    if(el){ el.textContent = ''; el.style.display = 'none'; }
  }

  function step(sn,tx,ty,e){ sn.x+=(tx-sn.x)*e; sn.y+=(ty-sn.y)*e; sn.hist.unshift({x:sn.x,y:sn.y}); if(sn.hist.length>70)sn.hist.pop(); }
  function draw(sn){ for(var i=0;i<sn.segs.length;i++){ var h=sn.hist[Math.min(i*5,sn.hist.length-1)]; if(!h)continue; sn.segs[i].style.left=h.x+'px'; sn.segs[i].style.top='calc(50% + '+h.y+'px)'; } }

  function frame(){
    t+=0.025; var W=track.clientWidth||520;
    if(phase==='travel'){
      var Rx=btnW/2+12;
      step(blue, btnX-Rx, btnY, 0.05); draw(blue);
      step(yellow, btnX+Rx, btnY, 0.05); draw(yellow);
    } else if(phase==='circle'){
      var rx=btnW/2+12, ry=btnH/2+12, a=(performance.now()-circleStart)/1000*4.0;
      var wB=Math.sin(a*3)*3, wY=Math.sin(a*3+1.2)*3, ba=Math.PI+a, ya=a;
      step(blue, btnX+(rx+wB)*Math.cos(ba), btnY+(ry+wB)*Math.sin(ba), 0.42); draw(blue);
      step(yellow, btnX+(rx+wY)*Math.cos(ya), btnY+(ry+wY)*Math.sin(ya), 0.42); draw(yellow);
    } else if(phase!=='agreed'){
      var nx=Math.max(0.02,Math.min(0.98, 0.5 + Math.sin(t*0.32)*0.42));
      step(yellow, nx*W, Math.sin(nx*W*0.05 + t*1.4)*7, 0.12); draw(yellow);
    }
    requestAnimationFrame(frame);
  }

  function spawnPop(px){
    for(var i=0;i<2;i++){
      var d=document.createElement('span'); d.className='pp'; var bl=Math.random()<0.5;
      d.style.background=bl?'#3d5a80':'#6b83a6'; d.style.boxShadow='0 0 7px 1px '+(bl?'rgba(61,90,128,.5)':'rgba(91,123,240,.5)');
      d.style.left=(px+(Math.random()*16-8))+'px'; d.style.top='50%'; d.style.transform='translate(-50%,-50%)'; pops.appendChild(d);
      (function(el){var up=18+Math.random()*10;
        requestAnimationFrame(function(){el.style.transition='transform .3s cubic-bezier(.3,1.25,.5,1)';el.style.transform='translate(-50%,calc(-50% - '+up+'px))';});
        setTimeout(function(){el.style.transform='translate(-50%,calc(-50% - 9px))';},320);
        setTimeout(function(){el.style.transition='opacity .45s';el.style.opacity='0';},980);
        setTimeout(function(){el.remove();},1480);})(d);
    }
  }
  function burstAt(cx,cy){
    for(var i=0;i<22;i++){
      var d=document.createElement('span'); d.className='pp'; var bl=(i%2)===0;
      d.style.background=bl?'#3d5a80':'#23a259'; d.style.boxShadow='0 0 8px 2px '+(bl?'rgba(61,90,128,.5)':'rgba(35,162,89,.55)');
      d.style.left=cx+'px'; d.style.top='calc(50% + '+cy+'px)'; d.style.transform='translate(-50%,-50%)'; pops.appendChild(d);
      (function(el){var ang=Math.random()*Math.PI*2,dist=30+Math.random()*55;var tx=Math.cos(ang)*dist,ty=Math.sin(ang)*dist;
        requestAnimationFrame(function(){el.style.transition='transform .9s cubic-bezier(.2,.7,.3,1), opacity .9s';el.style.transform='translate(calc(-50% + '+tx+'px),calc(-50% + '+(cy+ty)+'px)) scale(.5)';el.style.opacity='0';});
        setTimeout(function(){el.remove();},950);})(d);
    }
  }

  function measureBtn(){
    var tr=track.getBoundingClientRect(), br=btn.getBoundingClientRect();
    btnX=(br.left+br.width/2)-tr.left; btnY=(br.top+br.height/2)-(tr.top+tr.height/2); btnW=br.width; btnH=br.height;
  }
  function runSeal(){
    if(locked) return; locked=true;
    saveBtn.style.display='none';
    measureBtn();
    var W=track.clientWidth||520;
    you.style.display='none'; hFair.style.display='none'; hIdeal.style.display='none';
    blue.layer.style.display='block'; blue.x=resFrac()*W; blue.y=0; blue.hist=[];
    setCoach('success',"Both sides approved — preparing your agreement…");
    phase='travel';
    setTimeout(function(){ phase='circle'; circleStart=performance.now(); },1100);
    setTimeout(finalizeAgreed,2700);
  }
  function finalizeAgreed(){
    phase='agreed';
    setApprove('green');
    burstAt(btnX,btnY);
    var esc=document.getElementById('escalate'); if(esc) esc.style.display='none';
    setTimeout(function(){ blue.layer.style.opacity='0'; yellow.layer.style.opacity='0'; },350);
    // The scale has driven to green; now the announcement lands. It reads the settled
    // figure from the just-returned status, so it is the real agreed amount.
    setTimeout(function(){ showCeremony(SETTLED_VALUE); },700);
  }

  var SETTLED_VALUE = (INIT && INIT.settledValue != null) ? INIT.settledValue : null;

  // The announcement. Fires only when the case is genuinely settled. It reveals the
  // agreed figure — which is safe, because the negotiation is over — and nothing about
  // how the two sides' numbers related on the way there.
  function showCeremony(value){
    var cer = document.getElementById('settleCer');
    if(!cer || cer.dataset.shown) return;
    cer.dataset.shown = '1';
    document.getElementById('cerTitle').textContent = CASE_TITLE || 'This case';
    var why = document.getElementById('cerWhy');
    if(why){
      // Only says WHICH rule fired — never the figures, never how close. On overlap it
      // stays silent; on a band settle it explains the 5%.
      if(INIT.settleReason === 'band'){
        why.textContent = 'Your two figures were within 5% of each other, so MidBid closed the gap and settled at the midpoint.';
        why.style.display = '';
      } else {
        why.style.display = 'none';
      }
    }
    cer.hidden = false;
    document.body.style.overflow = 'hidden';

    var target = Number(value) || 0, t0 = null, DUR = 1100;
    var figEl = document.getElementById('cerFig');
    function tick(ts){
      if(t0 === null) t0 = ts;
      var p = Math.min(1, (ts - t0) / DUR);
      var eased = 1 - Math.pow(1 - p, 3);
      figEl.textContent = CUR.symbol + gbp(Math.round(target * eased));
      if(p < 1) requestAnimationFrame(tick);
    }
    if(target > 0) requestAnimationFrame(tick); else figEl.textContent = CUR.symbol + '0';

    // One celebratory card now — dismissed by clicking anywhere (overlay onclick).
    // Step two: into the settled view (agreement + any service charge).
    var d = document.getElementById('cerDoneGo');
    if(d) d.onclick = function(){ cer.hidden = true; document.body.style.overflow=''; location.reload(); };
    var ab = document.getElementById('cerAgreeBtn');
    if(ab) ab.onclick = function(){
      var box = document.getElementById('cerAgree');
      if(box){ box.className='mb-cer-agree-done'; box.textContent = "Noted \u2014 we'll email you the additional information and the cost to prepare your settlement agreement under the applicable law."; }
    };
  }
  function finalizeNow(){
    locked=true; phase='agreed';
    saveBtn.style.display='none';
    var esc=document.getElementById('escalate'); if(esc) esc.style.display='none';
    you.style.display='none'; hFair.style.display='none'; hIdeal.style.display='none';
    yellow.layer.style.display='none'; blue.layer.style.display='none';
    setApprove('green');
    setCoach('success',"Agreed. This figure is locked in by both sides.");
    medWrap.classList.add('show');
  }

  function postForm(url,body){ return fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body}).then(function(r){return r.json();}); }

  /* ===== Settle modal: details for the agreement, then service charge ===== */
  (function(){
    var modal=document.getElementById('settleModal');
    if(!modal) return;
    var openBtn=document.getElementById('settleBtn');
    var back=document.getElementById('settleBack'), closeBtn=document.getElementById('settleClose');
    var step1=document.getElementById('settleStep1'), step2=document.getElementById('settleStep2');
    var company=document.getElementById('pdCompany'), address=document.getElementById('pdAddress');
    var fullName=document.getElementById('pdName');
    var save=document.getElementById('pdSave'), err=document.getElementById('pdErr');
    var wait=document.getElementById('pdWait'), ready=document.getElementById('pdReady');
    var MY_DETAILS_DONE = <%= myDetailsDone ? 'true' : 'false' %>;

    function open(){ modal.hidden=false; document.body.style.overflow='hidden'; var f=step1.hidden?null:fullName; if(f) setTimeout(function(){f.focus();},80); }
    function close(){ modal.hidden=true; document.body.style.overflow=''; }
    if(openBtn) openBtn.addEventListener('click',open);
    // After settlement the single green "Settle" button opens the details modal.
    var SETTLED = <%= c.status === 'settled' ? 'true' : 'false' %>;
    var mainBtn=document.getElementById('approve');
    if(SETTLED && mainBtn){ mainBtn.style.cursor='pointer'; mainBtn.addEventListener('click',open); }
    if(back) back.addEventListener('click',close);
    if(closeBtn) closeBtn.addEventListener('click',close);
    document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&!modal.hidden) close(); });

    function fail(msg,el){ err.textContent=msg; err.hidden=false; if(el) el.focus(); }
    if(save) save.addEventListener('click',function(){
      var n=(fullName.value||'').trim(), a=(address.value||'').trim();
      if(n.length<2){ return fail('Please enter your full name as it should appear on the agreement.', fullName); }
      if(a.length<6){ return fail('Please enter an address so the agreement can name you correctly.', address); }
      err.hidden=true; save.disabled=true; save.textContent='Saving…';
      var body='full_name='+encodeURIComponent(n)
             +'&company='+encodeURIComponent((company.value||'').trim())
             +'&address='+encodeURIComponent(a);
      postForm('/cases/'+CASE_ID+'/party-details',body)
        .then(function(r){
          if(!r||!r.ok) throw new Error((r&&r.error)||'failed');
          step1.hidden=true; step2.hidden=false;
          if(r.bothIn){
            if(wait) wait.hidden=true;
            if(ready) ready.hidden=false;
          }
        })
        .catch(function(){ save.disabled=false; save.textContent='Save my details'; fail('Could not save your details — please try again.'); });
    });

    // Pop the modal automatically the moment the case becomes agreed — but only
    // once the Settle step is actually available (i.e. any success fee is paid).
    window.mbOpenSettleModal=function(){ if(openBtn && modal.hidden) setTimeout(open,900); };
    if(openBtn && MY_DETAILS_DONE===false && INIT.state==='settled') setTimeout(open,600);

    // While we wait on the other side, watch for their details and reveal the
    // "ready to release" step (service charge, then agreement) automatically.
    function unlockReady(){
      if(wait) wait.hidden=true;
      if(ready) ready.hidden=false;
    }
    var watch=setInterval(function(){
      // Only poll while we're actually parked on the waiting screen.
      if(!wait || wait.hidden || step2.hidden) { clearInterval(watch); return; }
      fetch('/cases/'+CASE_ID+'/status').then(function(r){return r.json();}).then(function(s){
        if(s && s.bothDetailsDone){ unlockReady(); clearInterval(watch); }
      }).catch(function(){});
    },6000);
  })();

  // Ask in the product's own voice rather than the browser's grey system box.
  function askToSubmit(a){
    return new Promise(function(resolve){
      var box=document.getElementById('bidAsk');
      document.getElementById('askBody').textContent = ROLE==='claim'
        ? 'These lock for this round. If they will pay at or above your walk-away, this settles automatically at the midpoint.'
        : 'These lock for this round. If they will accept at or below your ceiling, this settles automatically at the midpoint.';
      document.getElementById('askFigs').innerHTML =
        '<div class="mb-ask-fig"><div class="k">Ideal</div><div class="v">'+CUR.symbol+gbp(a.ideal)+'</div></div>' +
        '<div class="mb-ask-fig"><div class="k">Target</div><div class="v">'+CUR.symbol+gbp(a.fair)+'</div></div>' +
        '<div class="mb-ask-fig walk"><div class="k">'+(ROLE==='claim'?'Walk-away':'Ceiling')+'</div><div class="v">'+CUR.symbol+gbp(a.reservation)+'</div></div>';
      document.getElementById('askWarn').innerHTML = ROLE==='claim'
        ? 'You cannot raise your walk-away later. This is the least you will accept.'
        : 'You cannot reduce your ceiling later. This is the most you will pay.';
      box.classList.add('on');
      var yes=document.getElementById('askYes'), no=document.getElementById('askNo');
      function done(v){ box.classList.remove('on'); yes.onclick=null; no.onclick=null; box.onclick=null; resolve(v); }
      yes.onclick=function(){ done(true); };
      no.onclick=function(){ done(false); };
      box.onclick=function(e){ if(e.target===box) done(false); };
    });
  }
  function saveFigures(){
    var a=anchorsGBP();
    askToSubmit(a).then(function(ok){ if(ok) doSubmit(a); });
  }
  function doSubmit(a){
    saveBtn.disabled=true; saveHint.textContent='Submitting…';
    postForm('/cases/'+CASE_ID+'/bid','ideal='+a.ideal+'&fair='+a.fair+'&reservation='+a.reservation)
      .then(function(s){
        if(s && s.error){ saveHint.textContent=s.error; saveBtn.disabled=false; setCoach('warning', s.error); return; }
        applyStatus(s); savedLo=lo; savedMid=mid; savedHi=hi; saveHint.textContent='Submitted.';
        setTimeout(function(){saveHint.textContent='';},2000);
      })
      .catch(function(){ saveBtn.disabled=false; saveHint.textContent='Could not submit — try again.'; });
  }
  // Settlement is automatic now: your submitted figure IS your approval. Kept only
  // so any old handler still bound to the button does something harmless.
  function approve(){
    setCoach('idle', 'There is nothing to approve — if your ranges meet, the round settles itself.');
    return;
    /* eslint-disable no-unreachable */
    if(phase!=='negotiate'||locked) return;
    if(!gClose){ return; }
    btn.classList.remove('ready'); setApprove('waiting'); setCoach('success',"You've approved — letting the other side know…");
    postForm('/cases/'+CASE_ID+'/approve','')
      .then(function(s){ applyStatus(s); })
      .catch(function(){ setCoach('warning',"Could not record your approval — try again."); setApprove('ready'); });
  }

  // ---- three-handle dragging with ordering constraints ----
  function clampSlot(slot,p){
    if(slot==='lo')  return Math.max(0, Math.min(p, mid-MINGAP));
    if(slot==='mid') return Math.max(lo+MINGAP, Math.min(p, hi-MINGAP));
    return Math.max(mid+MINGAP, Math.min(p, 1));   // 'hi'
  }
  function slotForHandle(el){
    if(el===hFair) return 'mid';
    if(el===you) return ROLE==='claim'?'lo':'hi';
    if(el===hIdeal) return ROLE==='claim'?'hi':'lo';
    return null;
  }
  function chipSlotFor(slot){
    if(slot==='mid') return 'fair';
    if(slot===(ROLE==='claim'?'lo':'hi')) return 'res';
    return 'ideal';
  }
  function setSlot(slot,p){
    if(slot==='lo')lo=clampSlot('lo',p); else if(slot==='mid')mid=clampSlot('mid',p); else hi=clampSlot('hi',p);
    placeAll(); headline(chipSlotFor(slot));
  }
  function nearestHandle(p){
    var cands=[{el:you,f:resFrac()},{el:hFair,f:mid},{el:hIdeal,f:idealFrac()}];
    cands.sort(function(a,b){return Math.abs(a.f-p)-Math.abs(b.f-p);});
    return cands[0].el;
  }
  function pFromClientX(clientX){ var r=track.getBoundingClientRect(); return Math.max(0,Math.min(1,(clientX-r.left)/r.width)); }
  function down(el,e){
    if(locked||phase==='agreed') return;
    dragging=el; lastPopX=null; el.classList.add('live');
    if(el.setPointerCapture&&e.pointerId!=null){try{el.setPointerCapture(e.pointerId);}catch(_){}}
    var p=pFromClientX(e.clientX); var slot=slotForHandle(el);
    var px=p*(track.getBoundingClientRect().width);
    if(lastPopX===null||Math.abs(px-lastPopX)>26){ spawnPop(px); lastPopX=px; }
    setSlot(slot,p); e.preventDefault();
  }
  you.addEventListener('pointerdown',function(e){down(you,e);});
  hFair.addEventListener('pointerdown',function(e){down(hFair,e);});
  hIdeal.addEventListener('pointerdown',function(e){down(hIdeal,e);});
  track.addEventListener('pointerdown',function(e){ if(e.target.closest('.mb-you,.mb-h'))return; down(nearestHandle(pFromClientX(e.clientX)),e); });
  window.addEventListener('pointermove',function(e){
    if(!dragging) return;
    var p=pFromClientX(e.clientX), slot=slotForHandle(dragging);
    var px=p*(track.getBoundingClientRect().width);
    if(lastPopX===null||Math.abs(px-lastPopX)>26){ spawnPop(px); lastPopX=px; }
    setSlot(slot,p);
  });
  window.addEventListener('pointerup',function(){ if(dragging){dragging.classList.remove('live'); dragging=null;} lastPopX=null; });

  // keyboard for the reservation hub
  you.tabIndex=0; you.setAttribute('role','slider'); you.setAttribute('aria-label','Your walk-away figure'); you.setAttribute('aria-valuemin',0); you.setAttribute('aria-valuemax',AMOUNT);
  you.addEventListener('keydown',function(e){
    if(locked)return; var slot=ROLE==='claim'?'lo':'hi'; var cur=resFrac();
    if(e.key==='ArrowLeft'||e.key==='ArrowDown'){ setSlot(slot,cur-0.02); spawnPop(resFrac()*track.clientWidth); e.preventDefault(); }
    if(e.key==='ArrowRight'||e.key==='ArrowUp'){ setSlot(slot,cur+0.02); spawnPop(resFrac()*track.clientWidth); e.preventDefault(); }
  });

  if(saveBtn) saveBtn.addEventListener('click',saveFigures);
  var resetBtn=document.getElementById('resetBtn');
  if(resetBtn) resetBtn.addEventListener('click',function(){ if(locked)return; lo=savedLo; mid=savedMid; hi=savedHi; order(); placeAll(); [].forEach.call(chips.children,function(ch){ch.classList.remove('sel');}); });
  btn.addEventListener('click',approve);

  var mediatorBtn=document.getElementById('mediatorBtn'), mediatorLbl=document.getElementById('mediatorLbl');
  if(mediatorBtn) mediatorBtn.addEventListener('click',function(){
    mediatorBtn.disabled=true; mediatorLbl.textContent='Requesting…';
    postForm('/cases/'+CASE_ID+'/mediator','')
      .then(function(r){ mediatorLbl.textContent='✓ Human mediator requested'; })
      .catch(function(){ mediatorBtn.disabled=false; mediatorLbl.textContent='Request a human mediator'; });
  });

  var copyBtn=document.getElementById('copyBtn');
  if(copyBtn) copyBtn.addEventListener('click',function(){ var x=document.getElementById('inviteBox').textContent.trim(); navigator.clipboard.writeText(x).then(function(){ copyBtn.textContent='Copied!'; setTimeout(function(){copyBtn.textContent='Copy link';},1500); }); });

  // Poll so the other side's moves and approval show up here.
  setInterval(function(){
    if(locked) return;
    fetch('/cases/'+CASE_ID+'/status').then(function(r){return r.json();}).then(function(s){ if(s&&s.state) applyStatus(s); }).catch(function(){});
  },4000);

  placeAll();
  headline('fair');
  if(INIT.state==='settled'){
    // Landed on an already-settled case (a reload, or the other side settled while you
    // were away). Show the announcement once; if it has already been seen this load,
    // finalizeNow just tidies the scale.
    finalizeNow();
    if(INIT.settledValue != null) setTimeout(function(){ showCeremony(INIT.settledValue); }, 350);
  }
  else { applyStatus(INIT); }   // INIT now carries locked/limit/round — pass it straight through,
                                // or the page paints unlocked until the first poll corrects it.
  requestAnimationFrame(frame);
</script>
<% if (c.status === 'settled') { %>
<% var _mbSettled = money(c.settled_value, c.currency);
   var _mbFeeShare = (pay && pay.fee) ? pay.fee.halfLabel : '';
   var _mbTotal = (pay && pay.fee) ? money((c.settled_value||0) + (pay.fee.half||0)/100, c.currency) : _mbSettled;
   var _mbPaid = (typeof settlementPaid !== 'undefined') && settlementPaid;
   var _mbReady = (typeof payeeOnboarded !== 'undefined') && payeeOnboarded; %>
<% if (role === 'resp') { %>
  <% if (_mbPaid) { %><span class="mb-fab" style="background:#268a4f;cursor:default;box-shadow:none">Paid &#10003;</span>
  <% } else if (_mbReady) { %><form method="post" action="/cases/<%= c.id %>/pay" style="margin:0"><button class="mb-fab" type="submit">Pay <%= _mbTotal %></button></form>
  <% } else { %><span class="mb-fab" style="background:#8f877a;cursor:default;box-shadow:none" title="This activates once the other party has added their bank details to receive the funds.">Payment opens once they add bank details</span><% } %>
<% } else { %>
  <% if (_mbReady) { %><span class="mb-fab" style="background:#268a4f;cursor:default;box-shadow:none">Payouts ready &#10003;</span>
  <% } else { %><form method="post" action="/cases/<%= c.id %>/payout/onboard" style="margin:0"><button class="mb-fab" type="submit">Add your bank details to get paid</button></form><% } %>
<% } %>
<% var _agreeAsked = (typeof agreementRequested !== 'undefined') && agreementRequested; %>
<% if (_agreeAsked) { %>
  <span class="mb-agree-fab done">&#10003; Agreement requested</span>
<% } else { %>
  <button class="mb-agree-fab" type="button" id="mbAgreeFab" onclick="document.getElementById('mbAgree').classList.add('show')">Request a settlement agreement</button>
<% } %>

<%# The settlement agreement is the premium, human-reviewed path. Rather than
    auto-generating a contract per jurisdiction, high-value cases upload their papers
    and MidBid prepares the agreement from them. This popup makes that offer. %>
<div id="mbAgree" onclick="if(event.target===this)this.classList.remove('show')">
  <div class="m" role="dialog" aria-modal="true" aria-labelledby="agreeH">
    <button class="x" aria-label="Close" onclick="document.getElementById('mbAgree').classList.remove('show')">&times;</button>
    <span class="badge" style="background:#16306B">Recommended for high-value cases</span>
    <h3 id="agreeH">A formal settlement agreement</h3>
    <p class="mut" style="margin:0 0 4px">Your settlement is already binding — both sides committed to the figure through MidBid, and that record stands on its own. A formal written agreement is an added layer, worth it when the sum is large or you may need to rely on the document later.</p>
    <p class="mut" style="margin:10px 0 16px">Upload the papers relevant to this dispute — the contract, invoices, correspondence — and we will prepare a formal settlement agreement and issue it to both parties.</p>

    <form method="post" action="/cases/<%= c.id %>/agreement/request" enctype="multipart/form-data">
      <label class="aglabel" for="agDocs">Upload case documents</label>
      <input class="agfile" id="agDocs" type="file" name="documents" multiple
             accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
      <p class="agfine">PDF, Word or images, up to 5 MB each. You can add more later from your case page.</p>

      <label class="aglabel" for="agNote">Anything we should know? <span class="opt">(optional)</span></label>
      <textarea class="agnote" id="agNote" name="note" rows="3" maxlength="1000"
                placeholder="e.g. the key dispute was over the final two invoices"></textarea>

      <button class="cta" type="submit" style="margin-top:14px">Request the agreement &rarr;</button>
      <p class="agfine" style="margin-top:10px">Fees for the agreement are quoted case by case, as they depend on the jurisdiction and the documents involved, and are separate from your settlement. We will provide a quotation for your approval before any work begins.</p>
    </form>
  </div>
</div>
<div id="mbSet" onclick="if(event.target===this)this.classList.remove('show')">
  <div class="m" role="dialog" aria-modal="true">
    <button class="x" aria-label="Close" onclick="document.getElementById('mbSet').classList.remove('show')">&times;</button>
    <span class="badge">Settled</span>
    <% if (role === 'claim') { %>
      <h3>You've settled — let's get you paid</h3>
      <div class="status ok"><span class="k">Status</span>Settled at <strong><%= _mbSettled %></strong>. <b>The other party's payment button stays locked until you add your bank details here</b> — that's how we know where to send the money. The moment you finish, their button activates and we email them to pay.</div>
      <% if (typeof payeeOnboarded !== 'undefined' && payeeOnboarded) { %>
        <div class="status ok" style="margin-top:12px"><span class="k">Bank details added</span>You're set up to receive the funds. The other party's payment button is now active — we've emailed them to pay, and your money is released as soon as they do.</div>
      <% } else { %>
        <p class="mut">We use Stripe to collect your bank details securely and pay you directly — MidBid never sees or stores your account number.</p>
        <label class="tc"><input type="checkbox" onchange="document.getElementById('mbOnb').disabled=!this.checked"><span>I accept MidBid's <a href="/terms" target="_blank" rel="noopener">Terms &amp; Conditions</a>.</span></label>
        <form method="post" action="/cases/<%= c.id %>/payout/onboard" style="margin:0"><button class="cta" id="mbOnb" type="submit" disabled>Set up secure payouts &rarr;</button></form>
      <% } %>
    <% } else { %>
      <h3>Complete your payment</h3>
      <% if (typeof payeeOnboarded !== 'undefined' && payeeOnboarded) { %>
        <div class="status ok"><span class="k">Ready to pay</span>The other party has added their bank details, so your payment can be routed to them. You're clear to pay.</div>
      <% } else { %>
        <div class="status wait"><span class="k">Payment locked</span>Your <b>Pay</b> button unlocks as soon as the other party adds their bank details to receive the funds. Until then there's nowhere to send the money, so payment is held. We'll email you the instant it opens — you don't need to keep checking.</div>
      <% } %>
      <div class="bd"><div class="r"><span class="l">Settlement sum</span><span class="v"><%= _mbSettled %></span></div><div class="r sub"><span class="l">MidBid service fee (your share)</span><span class="v"><%= _mbFeeShare %></span></div><div class="r tot"><span class="l">Total to pay</span><span class="v"><%= _mbTotal %></span></div></div>
      <% if (typeof payeeOnboarded !== 'undefined' && payeeOnboarded) { %>
        <label class="tc"><input type="checkbox" onchange="document.getElementById('mbPay').disabled=!this.checked"><span>I accept the <a href="/terms" target="_blank" rel="noopener">Terms &amp; Conditions</a>, including that this payment discharges the settlement.</span></label>
        <button class="cta" id="mbPay" disabled title="Payment goes live in Stage 2">Pay <%= _mbTotal %></button>
      <% } else { %>
        <button class="cta" disabled>Waiting for the other party…</button>
        <p class="mut">You don't need to do anything yet — we'll let you know when payment opens.</p>
      <% } %>
    <% } %>
    <div class="agree" id="mbAgree"><div><p class="h"><%= role === 'claim' ? 'Want a signed settlement agreement?' : 'Also want a signed settlement agreement?' %></p><p class="s">Optional — additional cost<%= role === 'claim' ? ', shared between the parties' : '' %>.</p></div><button class="btn" type="button" onclick="mbReqAgree()">Request</button></div>
    <p class="fine">Click outside this box to close · nothing is lost</p>
  </div>
</div>
<script>
  function mbOpen(){ document.getElementById('mbSet').classList.add('show'); }
  function mbReqAgree(){ document.getElementById('mbAgree').outerHTML='<div class="agree-done" id="mbAgree">Noted \u2014 we\'ll email you the cost and the details we need to prepare your settlement agreement under the applicable law.</div>'; }
</script>
<% } %>



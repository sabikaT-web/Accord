<% var title="Case"; var active=""; %>
<%
  // Shared APP SHELL (left sidebar) for all inside pages. Include this at the top of
  // a page, add the page style and a .content block, then include app-foot at the
  // end. Pass active (overview | analytics | account) and title. Uses res.locals me.
  // This file lives at the repo root; the boot step copies it into views/partials.
  const _u = (me && (me.company_name || me.username || me.name)) || 'Account';
  const _ini = _u.replace(/[^A-Za-z ]/g,'').split(' ').filter(Boolean).slice(0,2).map(s => s[0].toUpperCase()).join('') || 'M';
  const _act = (typeof active !== 'undefined') ? active : '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MidBid · <%= (typeof title !== 'undefined') ? title : 'MidBid' %></title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    /* greige base */
    --bg:#d8d4cc; --paper:#f7f3eb; --surface:#f7f3eb; --surface2:#f3efe6;
    --ink:#1a1814; --navy:#1a1814; --muted:#6a6358; --faint:#8f877a; --line:#ebe4d6;
    /* stage / accent colours remapped to the greige palette (same var names the pages read) */
    --cobalt:#3d5a80; --cobalt-deep:#2c4a6e; --cobsoft:#e8eef6;
    --green:#4d7c5a; --greend:#3c6349; --greensoft:#e8f0ea;
    --amber:#c27803; --ambersoft:#fef6e4;
    --gold:#c27803; --gold2:#e8a317; --gold-soft:#fef6e4; --gold-border:#e8d4a8; --gold-text:#8a5a12;
  }
  body{font-family:"Hanken Grotesk",system-ui,sans-serif;color:var(--ink);
    background:var(--bg);min-height:100vh;display:flex}
  .seam{position:fixed;top:0;left:0;right:0;height:2px;z-index:50;background:linear-gradient(90deg,#3d5a80,#4d7c5a 50%,#c27803)}

  /* Sidebar — light greige */
  .side{width:224px;flex:none;background:var(--surface);border-right:1px solid var(--line)}
  .side-in{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;overflow-y:auto}
  .side .brand{display:flex;align-items:center;gap:11px;padding:22px 20px 20px;border-bottom:1px solid var(--line)}
  .side .brand svg{width:30px;height:25px;flex:none;overflow:visible}
  .side .brand b{font:600 1.22rem/1 "Fraunces",Georgia,serif;color:var(--ink);letter-spacing:.004em}
  .side nav{flex:1;padding:16px 14px;display:flex;flex-direction:column;gap:2px}
  .side nav a{display:flex;align-items:center;gap:13px;padding:10px 13px;border-radius:9px;text-decoration:none;color:var(--muted);font:500 .875rem/1 "Hanken Grotesk",sans-serif;letter-spacing:.004em;border-left:2px solid transparent;transition:color .15s,background .15s}
  .side nav a svg{width:18px;height:18px;flex:none;opacity:.8}
  .side nav a:hover{color:var(--ink);background:var(--surface2)}
  .side nav a.on{color:var(--gold-text);background:var(--gold-soft);border-left-color:var(--gold)}
  .side nav a.on svg{opacity:1}
  .side .sep{height:1px;background:var(--line);margin:12px 14px}
  .side .who{display:flex;align-items:center;gap:11px;padding:16px 20px;border-top:1px solid var(--line)}
  .side .who .av{width:32px;height:32px;border-radius:50%;background:linear-gradient(145deg,var(--gold2),var(--gold));color:#fff;display:flex;align-items:center;justify-content:center;font:600 .74rem/1 "Spline Sans Mono",monospace;flex:none}
  .side .who .nm{font:500 .84rem/1.15 "Hanken Grotesk",sans-serif;color:var(--ink)}
  .side .who .rl{font:400 .7rem/1 "Spline Sans Mono",monospace;color:var(--muted);margin-top:3px;text-transform:capitalize}
  .side .who form{margin:0}

  .main{flex:1;min-width:0;display:flex;flex-direction:column}
  .topbar{display:flex;align-items:center;gap:14px;padding:14px 26px;border-bottom:1px solid var(--line);background:rgba(247,243,235,.6);backdrop-filter:blur(6px)}
  .search{flex:1;max-width:440px;position:relative}
  .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--faint)}
  .search input{width:100%;border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 14px 9px 36px;font:inherit;font-size:.86rem;color:var(--ink)}
  .search input:focus{outline:none;border-color:var(--gold)}
  .tb-sp{flex:1}
  .newc{font:600 .78rem/1 "Hanken Grotesk",sans-serif;padding:9px 15px;border-radius:9px;background:linear-gradient(145deg,var(--cobalt-deep),var(--cobalt));color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--cobalt)}
  .newc:hover{background:var(--cobalt-deep)}.newc svg{width:15px;height:15px}
  .exp{font:600 .74rem/1 "Spline Sans Mono",monospace;padding:9px 14px;border-radius:9px;border:1px solid var(--gold-border);background:var(--surface);color:var(--muted);cursor:pointer}
  .exp:hover{border-color:var(--gold);color:var(--gold-text)}

  .content{padding:22px 26px 40px;max-width:1240px;width:100%}
  .phead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:20px}
  .phead h1{font:600 1.75rem/1.1 "Fraunces",Georgia,serif;color:var(--navy);letter-spacing:-.01em}
  .phead p{color:var(--muted);font-size:.9rem;margin-top:6px}
  .phead .acts{display:flex;gap:8px;flex:none}

  @media(max-width:820px){
    .side{width:64px}.side .brand b,.side nav a .lbl,.side .who .nm,.side .who .rl{display:none}
    .side .brand{justify-content:center;padding:20px 0}.side nav a{justify-content:center;border-left:none}.side .who{justify-content:center}
    .search{display:none}
  }
</style>
</head>
<body>
<div class="seam"></div>
<div class="stage" aria-hidden="true"><div class="wash w1"></div><div class="wash w2"></div><div class="wash w3"></div></div>

<aside class="side">
  <div class="side-in">
  <div class="brand">
    <svg viewBox="0 0 48 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs><clipPath id="mb-side-lens"><circle cx="18" cy="20" r="11"/></clipPath></defs>
      <g clip-path="url(#mb-side-lens)"><circle cx="30" cy="20" r="11" fill="#22c55e"/></g>
      <circle cx="18" cy="20" r="11" fill="none" stroke="#2563eb" stroke-width="2.4"/>
      <circle cx="30" cy="20" r="11" fill="none" stroke="#f59e0b" stroke-width="2.4"/>
      <circle cx="24" cy="3.4" r="2.3" fill="#2563eb"/><circle cx="24" cy="36.6" r="2.3" fill="#f59e0b"/>
    </svg>
    <b>MidBid</b>
  </div>
  <nav>
    <a href="/overview" class="<%= _act === 'overview' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span class="lbl">Overview</span></a>
    <a href="/cases" class="on"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span class="lbl">Cases</span></a>
    <a href="/analytics" class="<%= _act === 'analytics' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-6M22 20H2"/></svg><span class="lbl">Analytics</span></a>
    <a href="/account" class="<%= _act === 'account' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg><span class="lbl">My account</span></a>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <a href="/admin" class="<%= _act === 'admin' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg><span class="lbl">Admin</span></a>
    <% } %>
    <a class="newcase" href="/cases/new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg><span class="lbl">Open new case</span></a>
  </nav>
  <div class="side-spacer"></div>
  <div class="side-bottom">
    <div class="who"><div class="av"><%= _ini %></div><div><div class="nm"><%= _u %></div><div class="rl"><%= (me && me.account_type) ? me.account_type : 'individual' %></div></div></div>
    <a class="logout-link" href="/logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="lbl">Log out</span></a>
  </div>
  </div>
</aside>

<div class="main">

<%# pageHead suppressed — case band (cx-band) is the single header for this page %>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Spline+Sans+Mono:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ——— MidBid greige + party role theme (Glass Pop B accents) ——— */
:root {
  --mb-bg: #d8d4cc;
  --mb-surface: #f7f3eb;
  --mb-line: #ebe4d6;
  --mb-ink: #1a1814;
  --mb-mut: #6a6358;
  --mb-gold: #c27803;
  --mb-gold-soft: #fef6e4;
  --mb-gold-border: #e8d4a8;
  --mb-gold-text: #8a5a12;
  --mb-blue: #3d5a80;
  --mb-blue-deep: #2c4a6e;
  --mb-blue-soft: #e8eef6;
  --mb-blue-border: #b8c8dc;
  --mb-green: #4d7c5a;
}
html.role-claim {
  --party: var(--mb-gold);
  --party-soft: var(--mb-gold-soft);
  --party-border: var(--mb-gold-border);
  --party-text: var(--mb-gold-text);
  --party-deep: #a06720;
}
html.role-resp {
  --party: var(--mb-blue);
  --party-soft: var(--mb-blue-soft);
  --party-border: var(--mb-blue-border);
  --party-text: var(--mb-blue-deep);
  --party-deep: var(--mb-blue-deep);
}
/* Walk-away / ceiling hub follows role */
html.role-claim .hub {
  background: var(--mb-gold) !important;
  box-shadow: 0 0 0 5px rgba(194,120,3,.18), 0 0 10px 1px rgba(194,120,3,.45) !important;
}
html.role-resp .hub {
  background: var(--mb-blue) !important;
  box-shadow: 0 0 0 5px rgba(61,90,128,.2), 0 0 10px 1px rgba(61,90,128,.4) !important;
}
html.role-claim .mb-chip[data-slot="res"] .k,
html.role-claim .mb-chip[data-slot="res"] .v { color: var(--mb-gold) !important; }
html.role-resp .mb-chip[data-slot="res"] .k,
html.role-resp .mb-chip[data-slot="res"] .v { color: var(--mb-blue) !important; }
html.role-claim .mb-chip[data-slot="res"].sel {
  border-color: var(--mb-gold) !important;
  background: color-mix(in srgb, var(--mb-gold) 11%, #fff) !important;
  box-shadow: 0 0 0 3px rgba(194,120,3,.22) !important;
}
html.role-resp .mb-chip[data-slot="res"].sel {
  border-color: var(--mb-blue) !important;
  background: color-mix(in srgb, var(--mb-blue) 11%, #fff) !important;
  box-shadow: 0 0 0 3px rgba(61,90,128,.22) !important;
}
/* Primary figure */
html.role-claim .mb-fig { color: var(--mb-gold-text); }
html.role-resp .mb-fig { color: var(--mb-blue-deep); }
/* Coach / cards soft tint */
html.role-claim .coach:not(.tone-warning):not(.tone-close):not(.tone-success) {
  background: var(--mb-gold-soft); border-color: var(--mb-gold-border); color: var(--mb-ink);
}
html.role-resp .coach:not(.tone-warning):not(.tone-close):not(.tone-success) {
  background: var(--mb-blue-soft); border-color: var(--mb-blue-border); color: var(--mb-ink);
}
html.role-claim .coach-badge {
  background: linear-gradient(135deg, #a06720, var(--mb-gold)) !important;
}
html.role-resp .coach-badge {
  background: linear-gradient(135deg, var(--mb-blue-deep), var(--mb-blue)) !important;
}
/* Submit / primary actions that use gold already — keep; add blue for respondent */
html.role-resp .btn-gold {
  background: var(--mb-blue) !important;
  border-color: var(--mb-blue) !important;
  color: #fff !important;
}
html.role-resp .btn-gold:hover {
  background: var(--mb-blue-deep) !important;
  border-color: var(--mb-blue-deep) !important;
}
html.role-resp .mb-ask-box { border-top-color: var(--mb-blue) !important; }
html.role-resp .mb-ask-fig.walk {
  border-color: var(--mb-blue) !important;
  background: rgba(61,90,128,.08) !important;
}
html.role-resp .mb-ask-warn {
  background: rgba(61,90,128,.1) !important;
  border-color: var(--mb-blue) !important;
  color: var(--mb-blue-deep) !important;
}
html.role-resp .mb-ask-ic {
  background: rgba(61,90,128,.15) !important;
  color: var(--mb-blue) !important;
}
</style>
<script>
(function () {
  try {
    var role = <%- JSON.stringify(typeof role !== 'undefined' ? role : null) %>;
    if (role === 'claim' || role === 'resp') {
      document.documentElement.classList.add('role-' + role);
    }
  } catch (e) {}
})();
</script>


<style>
  .mb-card{margin-top:1rem}
  .mb-figwrap{margin:1.4rem 0 .4rem}
  .mb-fig{font-size:1.7rem;font-weight:600;transition:color .3s ease}
  .mb-figrole{font-size:.85rem;color:#6a6358;margin-bottom:1.1rem;min-height:1.1em}

  /* three-anchor legend chips */
  .mb-chips{display:flex;gap:.5rem;flex-wrap:wrap;margin:.2rem 0 1rem}
  .mb-chip{display:inline-flex;flex-direction:column;gap:.1rem;padding:.4rem .7rem;border-radius:12px;border:1px solid #ebe4d6;background:#f3efe6;cursor:pointer;transition:border-color .25s,box-shadow .25s,background .25s}
  .mb-chip .k{font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#8f877a}
  .mb-chip .v{font-size:.98rem;font-weight:600;color:#1e2a4a}
  .mb-chip[data-slot="ideal"] .k{color:#7a5af0}
  .mb-chip[data-slot="ideal"] .v{color:#7a5af0}
  .mb-chip[data-slot="fair"] .k{color:#3d5a80}
  .mb-chip[data-slot="fair"] .v{color:#3d5a80}
  .mb-chip[data-slot="res"] .k{color:#c07d12}
  .mb-chip[data-slot="res"] .v{color:#c07d12}
  /* a moving handle lights up its category chip in that category's colour */
  .mb-chip.sel{border-color:#3d5a80;box-shadow:0 0 0 3px rgba(61,90,128,.14);background:#f3efe6}
  .mb-chip[data-slot="ideal"].sel{border-color:#7a5af0;background:color-mix(in srgb,#7a5af0 9%,#fff);box-shadow:0 0 0 3px rgba(122,90,240,.20),0 0 24px -2px rgba(122,90,240,.55)}
  .mb-chip[data-slot="fair"].sel{border-color:#3d5a80;background:color-mix(in srgb,#3d5a80 9%,#fff);box-shadow:0 0 0 3px rgba(61,90,128,.20),0 0 24px -2px rgba(61,90,128,.55)}
  .mb-chip[data-slot="res"].sel{border-color:#e0972a;background:color-mix(in srgb,#e0972a 11%,#fff);box-shadow:0 0 0 3px rgba(224,151,42,.24),0 0 24px -2px rgba(224,151,42,.60)}

  .mb-track{position:relative;height:8px;border-radius:6px;background:#eae2d2;border:0.5px solid #ebe4d6;margin:1.5rem 0 1.1rem}
  /* your own range: translucent band from lowest to highest figure */
  .mb-band{position:absolute;top:50%;height:8px;transform:translateY(-50%);border-radius:6px;background:linear-gradient(90deg,rgba(224,151,42,.34),rgba(61,90,128,.40),rgba(122,90,240,.34));pointer-events:none;z-index:0;transition:background .4s}

  /* reservation handle = the spinning orbit hub (the binding "walk-away" figure) */
  .mb-you{position:absolute;top:50%;left:50%;width:52px;height:52px;transform:translate(-50%,-50%);cursor:grab;touch-action:none;outline:none;z-index:4}
  .mb-you:active{cursor:grabbing}
  .hub{position:absolute;top:50%;left:50%;width:18px;height:18px;border-radius:50%;background:#e0972a;border:2px solid #fff;transform:translate(-50%,-50%);z-index:2;box-shadow:0 0 0 5px rgba(224,151,42,.14),0 0 10px 1px rgba(224,151,42,.5);transition:filter .15s,transform .15s}
  .ring{display:none}
  @keyframes mb-spin{to{transform:rotate(360deg)}}
  .od-blue{display:none}
  .mb-you:focus-visible .hub{box-shadow:0 0 0 5px rgba(224,151,42,.35)}
  .mb-you:active .hub{filter:brightness(.72) saturate(1.15);transform:translate(-50%,-50%) scale(1.28)}

  /* the two softer handles: ideal (hollow ring) + fair (solid dot) */
  .mb-h{position:absolute;top:50%;left:50%;width:34px;height:34px;transform:translate(-50%,-50%);cursor:grab;touch-action:none;outline:none;z-index:3;display:flex;align-items:center;justify-content:center}
  .mb-h:active{cursor:grabbing}
  .mb-h .dot{width:15px;height:15px;border-radius:50%;transition:transform .15s}
  .mb-h[data-slot="fair"] .dot{background:#3d5a80;box-shadow:0 0 8px 2px rgba(61,90,128,.4);transition:filter .15s,transform .15s,box-shadow .15s}
  .mb-h[data-slot="ideal"] .dot{background:#fff;border:2px solid #7a5af0;box-shadow:0 0 7px 1px rgba(122,90,240,.45);transition:filter .15s,transform .15s,box-shadow .15s}
  .mb-h:focus-visible .dot,.mb-h.live .dot{transform:scale(1.22)}
  .mb-h.live[data-slot="fair"] .dot,.mb-h[data-slot="fair"]:active .dot{filter:brightness(.72) saturate(1.15);transform:scale(1.3)}
  .mb-h.live[data-slot="ideal"] .dot,.mb-h[data-slot="ideal"]:active .dot{border-color:#5a3fd0;box-shadow:0 0 0 6px rgba(122,90,240,.16),0 0 16px 2px rgba(122,90,240,.55);transform:scale(1.3)}

  .mb-snake{display:none!important}
  .seg{position:absolute;border-radius:50%;transform:translate(-50%,-50%)}
  .mb-pops{display:none!important}
  .pp{position:absolute;width:9px;height:9px;border-radius:50%;will-change:transform,opacity}
  .mb-scale{display:flex;justify-content:space-between;font-size:.72rem;color:#8f877a;margin-top:.5rem}

  /* proximity highlight meter — the "you're nearly there" signal */
  .mb-prox{margin:1.1rem 0 .2rem}
  .mb-prox-bar{position:relative;height:7px;border-radius:6px;background:#eae2d2;border:0.5px solid #ebe4d6;overflow:hidden}
  .mb-prox-fill{position:absolute;left:0;top:0;bottom:0;width:0%;border-radius:6px;background:#d8ceba;transition:width .6s cubic-bezier(.2,.7,.3,1),background .5s}
  .mb-prox-fill.lvl-apart{background:#3d5a80}
  .mb-prox-fill.lvl-near{background:#c27803;box-shadow:0 0 12px 2px rgba(245,180,0,.55)}
  .mb-prox-fill.lvl-close{background:#23a259}
  .mb-prox-fill.lvl-overlap{background:#23a259;box-shadow:0 0 14px 3px rgba(35,162,89,.5)}
  .mb-prox-text{font-size:.78rem;color:#8f877a;margin-top:.45rem;min-height:1em;transition:color .3s}
  .mb-prox-text.hot{color:#9a6b00;font-weight:600}

  .coach{display:flex;gap:.55rem;align-items:flex-start;margin:1rem 0 0;padding:.7rem .9rem;border-radius:14px;background:#f3efe6;border:1px solid #ebe4d6;color:#1e2a4a;font-size:.95rem;line-height:1.45}
  .coach .coach-badge{flex:0 0 auto;font-size:.6rem;letter-spacing:.07em;text-transform:uppercase;font-weight:700;color:#fff;background:linear-gradient(135deg,#2c4a6e,#13205c);padding:.3rem .46rem;border-radius:7px;margin-top:.05rem}
  .coach.tone-warning{background:#fff6ec;border-color:#f2dcc1;color:#5a3a17}
  .coach.tone-close,.coach.tone-success{background:#eef9f1;border-color:#cce9d4;color:#1d4a2c}
  .coach.pop{animation:mb-bpop .34s ease}
  @keyframes mb-bpop{0%{transform:translateY(7px) scale(.98);opacity:.45}100%{transform:translateY(0) scale(1);opacity:1}}
  .mb-actions{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;margin-top:1.2rem}
  /* One-way reminder. Gold, not green: green is reserved for settlement across the
     whole product, and firing it here would make the same colour mean two things. */
  .mb-nudge{border:1px solid #3d5a80;border-left:4px solid #3d5a80;border-radius:12px;
    background:rgba(47,107,255,.06);padding:.85em 1em;margin:14px 0 4px}
  .mb-nudge[hidden]{display:none}
  .mb-nudge-top{display:flex;gap:.7em;align-items:flex-start}
  .mb-nudge-top svg{width:19px;height:19px;flex:none;color:#3d5a80;margin-top:.1em}
  .mb-nudge-top b{display:block;font-size:.95rem;color:#16306B}
  .mb-nudge-top span{display:block;font-size:.85rem;color:#6a6358;line-height:1.5;margin-top:.15em}
  .mb-oneway{display:flex;align-items:center;gap:.6em;margin:14px 0 2px;padding:.75em 1em;background:rgba(47,107,255,.07);border:1px solid rgba(47,107,255,.30);border-left:4px solid #3d5a80;border-radius:12px;font-size:.86rem;font-weight:600;color:#2c4a6e;line-height:1.45}
  .mb-oneway svg{width:16px;height:16px;flex:none;color:#3d5a80}
  .mb-oneway.locked{background:rgba(15,35,80,.05);border-color:#ebe4d6;border-left-color:#8f877a;color:#6a6358}
  .mb-oneway.locked svg{color:#8f877a}
  .mb-oneway b{color:#0F2350}

  /* Submit dialog. The browser's confirm() box is grey, system-fonted, and says
     nothing about what is at stake. This is the same question, in your own voice. */
  .mb-ask{position:fixed;inset:0;background:rgba(10,20,45,.58);display:none;
    align-items:center;justify-content:center;z-index:90;padding:20px}
  .mb-ask.on{display:flex}
  .mb-ask-box{background:#fff;border:1px solid #ebe4d6;border-top:5px solid #c27803;
    border-radius:16px;max-width:470px;width:100%;padding:24px 24px 20px;
    box-shadow:0 34px 80px -24px rgba(22,48,107,.55)}
  .mb-ask-ic{width:36px;height:36px;border-radius:50%;background:rgba(245,179,18,.2);
    color:#B5790F;display:flex;align-items:center;justify-content:center;margin-bottom:.7rem}
  .mb-ask-ic svg{width:19px;height:19px}
  .mb-ask h3{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.35rem;
    color:#1E2A45;margin:0 0 .3rem;letter-spacing:-.01em}
  .mb-ask p{color:#6a6358;font-size:.92rem;line-height:1.55;margin:0 0 .9rem}
  .mb-ask-figs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 .9rem}
  .mb-ask-fig{border:1px solid #ebe4d6;border-radius:10px;padding:.5em .6em;background:#f3efe6}
  .mb-ask-fig .k{font-family:"Spline Sans Mono",monospace;font-size:.6rem;letter-spacing:.09em;
    text-transform:uppercase;color:#6a6358;font-weight:700}
  .mb-ask-fig .v{font-family:"Fraunces",Georgia,serif;font-size:1.02rem;color:#1E2A45;margin-top:.1rem}
  .mb-ask-fig.walk{border-color:#c27803;background:rgba(245,179,18,.1)}
  .mb-ask-warn{background:rgba(245,179,18,.13);border:1px solid #c27803;border-radius:10px;
    padding:.6em .8em;font-size:.85rem;color:#8A5A0B;font-weight:600;margin:0 0 1rem}
  .mb-ask-foot{display:flex;gap:.5em;justify-content:flex-end}
  .btn-gold{background:#c27803;color:#2E2000;border:1px solid #c27803;font-weight:700}
  .btn-gold:hover{background:#E0A30C;border-color:#E0A30C}

  .mb-approve{position:relative;border:none;border-radius:999px;padding:.55rem .7rem;cursor:pointer;opacity:.72;background:linear-gradient(90deg,#3d5a80 0 50%,#c27803 50% 100%);transition:opacity .4s ease,background .5s ease,box-shadow .5s ease}
  .mb-approve .lbl{position:relative;display:inline-flex;align-items:center;gap:5px;font-size:.9rem;font-weight:600;color:#fff;background:rgba(0,0,0,.32);padding:.3rem .85rem;border-radius:999px;transition:background .5s ease}
  .mb-approve.ready{opacity:1;animation:mb-pulse 1.7s ease-in-out infinite}
  @keyframes mb-pulse{0%,100%{box-shadow:0 0 0 0 rgba(245,180,0,0)}50%{box-shadow:0 0 16px 4px rgba(245,180,0,.45)}}
  .mb-approve.is-green{opacity:1;animation:none;background:#23a259;box-shadow:0 0 22px 6px rgba(35,162,89,.5)}
  .mb-approve.is-green .lbl{background:transparent}
  .mb-med-wrap{margin-top:1.4rem;padding-top:1.1rem;border-top:0.5px solid #ebe4d6;opacity:0;transform:translateY(8px);transition:opacity .5s ease,transform .5s ease;pointer-events:none}
  .mb-med-wrap.show{opacity:1;transform:none;pointer-events:auto}
  .mb-med{display:inline-flex;align-items:center;gap:8px;font-size:.9rem;font-weight:600;color:#13205c;background:transparent;border:0.5px solid #d8ceba;border-radius:999px;padding:.55rem 1.05rem;cursor:pointer;text-decoration:none}
  .mb-med:hover{background:#f3efe6}
  .mb-med-cap{display:block;font-size:.78rem;color:#8f877a;margin-top:.5rem}
  .mb-escalate{margin-top:1.2rem;padding-top:1rem;border-top:0.5px dashed #ebe4d6}
  .mb-esc-row{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
  .mb-esc-btn{flex:none;display:inline-flex;align-items:center;gap:6px;font-size:.88rem;font-weight:600;color:#13205c;background:#fff;border:1px solid #d8ceba;border-radius:999px;padding:.5rem 1rem;cursor:pointer;transition:background .2s,border-color .2s}
  .mb-esc-btn:hover:not(:disabled){background:#f3efe6;border-color:#3d5a80}
  .mb-esc-btn:disabled{cursor:default;color:#23a259;border-color:#cce9d4;background:#eef9f1}
  .mb-esc-cap{font-size:.8rem;color:#8f877a;line-height:1.4;flex:1 1 220px}
  .mb-pay{display:inline-flex;align-items:center;gap:6px;font-size:.92rem;font-weight:700;color:#fff;background:#23a259;border:none;border-radius:999px;padding:.6rem 1.15rem;cursor:pointer;box-shadow:0 0 16px 3px rgba(35,162,89,.35);transition:filter .2s}
  .mb-pay:hover{filter:brightness(1.05)}

  /* Settlement announcement. This is the one moment green is correct — the deal is
     done. It fires only on the settled state, never on proximity: there is no "you're
     close" here, because being told you are close is exactly the leak the sealed
     mechanic removes. What it reveals — the agreed figure — is safe, because the case
     is over the instant it shows. */
  .mb-cer{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:1.2rem}
  .mb-cer[hidden]{display:none}
  .mb-cer-sky{position:absolute;inset:0;background:radial-gradient(circle at 50% 38%,rgba(21,184,119,.28),rgba(16,24,48,.72) 62%);
    backdrop-filter:blur(3px);animation:cerFade .5s ease}
  .mb-cer-card{position:relative;background:#fff;border-radius:22px;max-width:440px;width:100%;
    padding:2.4rem 2rem 1.7rem;text-align:center;
    box-shadow:0 30px 90px -20px rgba(21,184,119,.5),0 8px 30px rgba(16,24,48,.3);
    animation:cerRise .6s cubic-bezier(.16,.84,.32,1)}
  .mb-cer-seal{width:66px;height:66px;margin:0 auto 1.1rem;border-radius:50%;
    display:flex;align-items:center;justify-content:center;color:#fff;
    background:linear-gradient(135deg,#15B877,#0E8F5B);
    box-shadow:0 0 0 8px rgba(21,184,119,.14),0 10px 26px -6px rgba(21,184,119,.6);
    animation:cerSeal .55s cubic-bezier(.2,.9,.3,1.3) .2s both}
  .mb-cer-seal svg{width:34px;height:34px}
  .mb-cer-eyebrow{font-family:"Spline Sans Mono",monospace;font-size:.66rem;letter-spacing:.22em;
    text-transform:uppercase;font-weight:700;color:#0E8F5B;margin-bottom:.5rem}
  .mb-cer-h{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:2.1rem;letter-spacing:-.02em;
    color:#12241C;margin:0 0 .3rem;line-height:1}
  .mb-cer-fig{font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:2.9rem;letter-spacing:-.03em;
    color:#0E8F5B;margin:.2rem 0 .9rem;line-height:1;font-variant-numeric:tabular-nums}
  .mb-cer-sub{color:#6a6358;font-size:.95rem;line-height:1.6;margin:0 auto 1.4rem;max-width:340px}
  .mb-cer-sub span{color:#12241C;font-weight:600}
  .mb-cer-why{font-size:.82rem;color:#0E8F5B;background:rgba(21,184,119,.1);border-radius:9px;
    padding:.55em .8em;margin:0 auto 1.2rem;max-width:340px;line-height:1.5}
  .mb-cer-go{border:none;border-radius:999px;background:#15B877;color:#fff;font:inherit;font-weight:700;
    font-size:.98rem;padding:.85em 1.6em;cursor:pointer;box-shadow:0 10px 24px -8px rgba(21,184,119,.7);
    transition:transform .15s,box-shadow .15s}
  .mb-cer-go:hover{transform:translateY(-1px);box-shadow:0 14px 30px -8px rgba(21,184,119,.8)}
  .mb-cer-fine{font-size:.76rem;color:#8f877a;margin:1rem 0 0;line-height:1.5}
  .mb-cer-agree{text-align:left;margin:0 0 1.1rem;border-radius:12px;padding:12px 13px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fbeef1;border:1px solid #e2b3bf}
  .mb-cer-agree .h{font-size:.82rem;font-weight:700;color:#101a3a;margin:0}
  .mb-cer-agree .s{font-size:.72rem;color:#8a2b42;font-weight:600;margin:2px 0 0;line-height:1.35}
  .mb-cer-agree .btn{flex:0 0 auto;background:transparent;border:2px solid #8a2b42;color:#8a2b42;font:inherit;font-size:.8rem;font-weight:700;padding:8px 13px;border-radius:9px;cursor:pointer}
  .mb-cer-agree .btn:hover{background:#f3dde3}
  .mb-cer-agree-done{text-align:left;margin:0 0 1.1rem;border-radius:12px;padding:12px 13px;background:#fbeef1;border:1px solid #e2b3bf;font-size:.8rem;line-height:1.5;color:#12241C}
  .mb-cer-done{animation:cerRise .45s cubic-bezier(.16,.84,.32,1)}
  @keyframes cerFade{from{opacity:0}to{opacity:1}}
  @keyframes cerRise{from{opacity:0;transform:translateY(22px) scale(.96)}to{opacity:1;transform:none}}
  @keyframes cerSeal{from{transform:scale(0) rotate(-12deg);opacity:0}to{transform:none;opacity:1}}
  @media(prefers-reduced-motion:reduce){.mb-cer-sky,.mb-cer-card,.mb-cer-seal{animation:none}}

  .mb-modal{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem}
  .mb-modal[hidden]{display:none}
  .mb-modal-back{position:absolute;inset:0;background:rgba(16,24,48,.55);backdrop-filter:blur(2px)}
  .mb-modal-card{position:relative;background:#fff;border-radius:18px;box-shadow:0 24px 60px rgba(16,24,48,.28);max-width:460px;width:100%;padding:1.6rem 1.5rem 1.4rem;max-height:88vh;overflow:auto;animation:mbIn .28s cubic-bezier(.2,.9,.3,1)}
  @keyframes mbIn{from{transform:translateY(14px) scale(.98);opacity:0}to{transform:none;opacity:1}}
  .mb-modal-x{position:absolute;top:.7rem;right:.85rem;border:none;background:transparent;font-size:1.5rem;line-height:1;color:#8f877a;cursor:pointer}
  .mb-modal-badge{display:inline-block;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:#fff;background:#23a259;padding:.32rem .6rem;border-radius:7px;margin-bottom:.85rem;box-shadow:0 0 16px 3px rgba(35,162,89,.35)}
  .mb-modal-badge.ok{background:#16306B;box-shadow:none}
  .mb-modal-card h2{font-family:"Fraunces",Georgia,serif;font-weight:500;font-size:1.35rem;margin:0 0 .55rem;color:#16306B}
  .mb-modal-sub{font-size:.92rem;line-height:1.5;color:#3a352c;margin:0 0 .9rem}
  .mb-modal-card label{display:block;font-size:.82rem;font-weight:600;color:#3a352c;margin:.85rem 0 .3rem}
  .mb-modal-card .opt{font-weight:400;color:#8f877a}
  .mb-modal-card input,.mb-modal-card textarea{width:100%;font:inherit;font-size:.92rem;padding:.6rem .7rem;border:1px solid #ebe4d6;border-radius:10px;background:#f3efe6;resize:vertical}
  .mb-modal-card input:focus,.mb-modal-card textarea:focus{outline:none;border-color:#3d5a80;box-shadow:0 0 0 3px rgba(61,90,128,.15)}
  .mb-modal-err{margin-top:.7rem;font-size:.85rem;color:#7a4a18;background:#fff6ec;border:1px solid #f2dcc1;border-radius:9px;padding:.5rem .7rem}
  .mb-modal-go{display:block;width:100%;margin-top:1.1rem;text-align:center;font:inherit;font-size:.92rem;font-weight:600;color:#fff;background:#23a259;border:none;border-radius:999px;padding:.7rem 1rem;cursor:pointer;text-decoration:none;box-shadow:0 0 18px 3px rgba(35,162,89,.32)}
  .mb-modal-go:disabled{opacity:.6;cursor:default;box-shadow:none}
  .mb-modal-go[aria-disabled="true"]{opacity:.45;cursor:not-allowed;box-shadow:none;pointer-events:none}
  .mb-modal-alt{display:block;text-align:center;margin-top:.8rem;font-size:.85rem;color:#16306B}

  /* Invitation panel. The old version was a link and a Copy button, shown only while
     the case was already 'awaiting_other' — so if the send failed, the case sat in
     'draft' and there was no way to try again short of pasting a URL by hand. */
  .inv{border:1px solid var(--line);border-left:4px solid #3d5a80;border-radius:14px;
    background:#fff;padding:16px 18px;margin:0 0 18px}
  .inv.inv-stale{border-left-color:#c27803;background:rgba(245,179,18,.05)}
  .inv.inv-bad{border-left-color:#C25A34;background:rgba(194,90,52,.05)}
  .inv-head{display:flex;gap:.7em;align-items:flex-start}
  .inv-head svg{width:19px;height:19px;flex:none;color:#3d5a80;margin-top:.15em}
  .inv.inv-stale .inv-head svg{color:#B5790F}
  .inv.inv-bad .inv-head svg{color:#C25A34}
  .inv-head b{display:block;font-size:.95rem;color:#1E2A45}
  .inv-head span{display:block;font-size:.85rem;color:#6a6358;line-height:1.5;margin-top:.15em}
  .inv-err{font-family:"Spline Sans Mono",monospace;font-size:.76rem;color:#8C3D1E;
    background:rgba(194,90,52,.09);border:1px solid rgba(194,90,52,.3);border-radius:8px;
    padding:.55em .7em;margin:.7em 0 0;word-break:break-word}
  .inv-form{display:flex;gap:.5em;margin-top:.9em;flex-wrap:wrap}
  .inv-form input{flex:1;min-width:180px;padding:.5em .7em;border:1px solid var(--line);
    border-radius:9px;font:inherit;font-size:.88rem}
  .inv-alt{margin-top:.8em}
  .inv-alt summary{font-size:.82rem;color:#6a6358;cursor:pointer}
  .inv-alt summary:hover{color:#16306B}
  .inv-fine{font-size:.76rem;color:#8f877a;margin:.5em 0 0;line-height:1.45}
  .inv-msg{border:1px solid #15B877;background:rgba(21,184,119,.1);color:#1c5e3f;
    border-radius:10px;padding:.6em .9em;margin:0 0 14px;font-size:.88rem;font-weight:600}
  .inv-msg.bad{border-color:#C25A34;background:rgba(194,90,52,.08);color:#8C3D1E}
  .mb-modal-fine{font-size:.76rem;color:#8f877a;text-align:center;margin:.75rem 0 0;line-height:1.45}
  /* ---- settlement action popup ---- */
  #mbSet{position:fixed;inset:0;z-index:10001;display:none;align-items:flex-start;justify-content:center;padding:48px 16px;background:rgba(9,14,34,.55);backdrop-filter:blur(3px);overflow:auto}
  #mbSet.show{display:flex}
  #mbAgree{position:fixed;inset:0;z-index:10001;display:none;align-items:flex-start;justify-content:center;padding:48px 16px;background:rgba(9,14,34,.55);backdrop-filter:blur(3px);overflow:auto}
  #mbAgree.show{display:flex}
  #mbAgree .m{width:min(540px,100%);background:#fff;border-radius:22px;box-shadow:0 28px 74px rgba(4,10,30,.5);padding:32px 32px 24px;position:relative;color:#1c2333}
  #mbAgree .x{position:absolute;top:15px;right:15px;width:31px;height:31px;border-radius:50%;border:0;background:#f3efe6;color:#8f877a;cursor:pointer;font-size:16px}
  #mbAgree .badge{display:inline-block;color:#fff;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:6px 13px;border-radius:999px}
  #mbAgree h3{font-family:"Fraunces",Georgia,serif;color:#101a3a;font-size:25px;line-height:1.15;font-weight:600;margin:15px 0 10px}
  #mbAgree .mut{color:#6a6358;font-size:13.5px;line-height:1.6}
  #mbAgree .aglabel{display:block;font-size:12px;font-weight:700;color:#16306B;margin:14px 0 5px;letter-spacing:.02em}
  #mbAgree .aglabel .opt{color:#8f877a;font-weight:500;text-transform:none;letter-spacing:0}
  #mbAgree .agfile{width:100%;font-size:13px;padding:9px;border:1px dashed #d8ceba;border-radius:10px;background:#f3efe6;box-sizing:border-box}
  #mbAgree .agnote{width:100%;font:inherit;font-size:13.5px;padding:10px;border:1px solid #ebe4d6;border-radius:10px;box-sizing:border-box;resize:vertical}
  #mbAgree .agfine{color:#8f877a;font-size:11.5px;line-height:1.5;margin:6px 0 0}
  #mbAgree .cta{width:100%;border:0;border-radius:999px;background:#16306B;color:#fff;font:inherit;font-weight:700;font-size:14.5px;padding:13px;cursor:pointer}
  #mbAgree .cta:hover{background:#2c4a6e}
  #mbSet .m{width:min(540px,100%);background:#fff;border-radius:22px;box-shadow:0 28px 74px rgba(4,10,30,.5);padding:32px 32px 22px;position:relative;color:#1c2333}
  #mbSet .x{position:absolute;top:15px;right:15px;width:31px;height:31px;border-radius:50%;border:0;background:#f3efe6;color:#8f877a;cursor:pointer;font-size:16px}
  #mbSet .badge{display:inline-flex;align-items:center;gap:7px;background:#2f9e5b;color:#fff;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:6px 13px;border-radius:999px}
  #mbSet .badge::before{content:"";width:6px;height:6px;border-radius:50%;background:#fff;opacity:.9}
  #mbSet h3{font-family:"Fraunces",Georgia,serif;color:#101a3a;font-size:26px;line-height:1.15;font-weight:600;margin:15px 0 10px}
  #mbSet .status{border-radius:12px;padding:13px 15px;font-size:13.5px;line-height:1.5}
  #mbSet .status .k{display:block;font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;margin-bottom:4px}
  #mbSet .status.ok{background:#e8f6ee;border:1px solid #bfe6cd;color:#1f5f3e}
  #mbSet .status.ok .k{color:#268a4f}
  #mbSet .status.wait{background:#fdf3e2;border:1px solid #e9d3a6;color:#7a5312}
  #mbSet .status.wait .k{color:#b5791f}
  #mbSet .bd{margin-top:16px;border:1px solid #ebe4d6;border-radius:13px;overflow:hidden}
  #mbSet .r{display:flex;justify-content:space-between;align-items:baseline;padding:12px 16px;font-size:14.5px}
  #mbSet .r+.r{border-top:1px solid #ebe4d6}
  #mbSet .r .l{color:#6a6358} #mbSet .r .v{font-weight:600;font-variant-numeric:tabular-nums}
  #mbSet .r.sub .l,#mbSet .r.sub .v{font-size:13px;color:#6a6358;font-weight:500}
  #mbSet .r.tot{background:#f3efe6} #mbSet .r.tot .l{color:#101a3a;font-weight:700;font-size:15px} #mbSet .r.tot .v{color:#101a3a;font-weight:800;font-size:17px}
  #mbSet .tc{display:flex;align-items:flex-start;gap:10px;margin-top:15px;font-size:13.5px;line-height:1.45}
  #mbSet .tc input{margin-top:2px;width:17px;height:17px;accent-color:#2f9e5b;flex:0 0 auto;cursor:pointer}
  #mbSet .tc a{color:#3d5a80;font-weight:600;text-decoration:none}
  #mbSet .cta{width:100%;border:0;cursor:pointer;background:#2f9e5b;color:#fff;font:inherit;font-size:16px;font-weight:700;padding:15px 20px;border-radius:13px;margin-top:15px}
  #mbSet .cta:hover:not(:disabled){background:#268a4f} #mbSet .cta:disabled{opacity:.45;cursor:not-allowed}
  #mbSet .field{margin-top:12px} #mbSet .field label{display:block;font-size:12.5px;font-weight:600;color:#101a3a;margin-bottom:5px}
  #mbSet .field input{width:100%;border:1px solid #ebe4d6;border-radius:10px;padding:11px 13px;font:inherit;font-size:14.5px}
  #mbSet .field input:focus{outline:none;border-color:#3d5a80;box-shadow:0 0 0 3px rgba(61,90,128,.12)}
  #mbSet .two{display:flex;gap:12px} #mbSet .two .field{flex:1}
  #mbSet .agree{margin-top:15px;border-radius:12px;padding:14px 15px;display:flex;align-items:center;justify-content:space-between;gap:14px;background:#fbeef1;border:1px solid #e2b3bf}
  #mbSet .agree .h{font-size:13.5px;font-weight:700;color:#101a3a;margin:0}
  #mbSet .agree .s{font-size:12px;color:#8a2b42;font-weight:600;margin:3px 0 0}
  #mbSet .agree .btn{flex:0 0 auto;background:transparent;border:2px solid #8a2b42;color:#8a2b42;font:inherit;font-size:13.5px;font-weight:700;padding:9px 14px;border-radius:10px;cursor:pointer;white-space:nowrap}
  #mbSet .agree .btn:hover{background:#f3dde3}
  #mbSet .agree-done{background:#fbeef1;border:1px solid #e2b3bf;border-radius:12px;padding:13px 15px;margin-top:15px;font-size:12.5px;line-height:1.5}
  #mbSet .fine{text-align:center;font-size:11.5px;color:#6a6358;margin:14px 0 2px}
  #mbSet .mut{font-size:12px;color:#6a6358;margin:8px 2px 0;line-height:1.45}
  .mb-fab{position:fixed;right:20px;bottom:20px;z-index:9998;border:0;cursor:pointer;background:#2f9e5b;color:#fff;font:inherit;font-weight:700;font-size:14px;padding:13px 20px;border-radius:999px;box-shadow:0 12px 30px -8px rgba(47,158,91,.6)}
  .mb-fab:hover{background:#268a4f}

<%- include('partials/head', { pageHead: {
  eyebrow: 'Case MB-' + c.id,
  title: c.title,
  sub: ''
} }) %>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Spline+Sans+Mono:wght@500;600&display=swap" rel="stylesheet">

<style>
  /* ---- Layout: Timeline + Scale + Private notes ---- */
  .cx-grid{display:grid;grid-template-columns:280px 1fr;gap:14px;align-items:start;margin-top:14px}
  .cx-stack{display:flex;flex-direction:column;gap:12px}
  .cx-card{background:#fff;border:1px solid #DCE3EF;border-radius:12px;box-shadow:0 12px 36px -32px rgba(15,28,46,.45)}
  .cx-pad{padding:16px 18px}

  .cx-eyebrow{font:700 .56rem/1 'Inter',system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#1E4FBF;display:block;margin-bottom:7px}
  .cx-h{font:500 14.5px/1.2 'Newsreader',Georgia,serif;margin:0 0 4px}
  .cx-muted{font-size:12px;color:#4A5568;line-height:1.5}

  /* ribbon */
  .cx-ribbon{display:grid;grid-template-columns:repeat(4,1fr);padding:11px 12px;margin-bottom:4px;
    background:linear-gradient(180deg,#FFFEF8,#F8F1DF);border:1px solid #E8D9B0;border-radius:12px}
  .cx-rc{padding:5px 16px}.cx-rc+.cx-rc{border-left:1px solid #E4D4A8}
  .cx-rc .k{display:flex;align-items:center;gap:.35em;font:600 .58rem/1 'Inter',system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#9A7B2E;margin-bottom:6px}
  .cx-rc .k::before{content:"";width:5px;height:5px;border-radius:50%;background:#C9A227}
  .cx-rc .v{font:500 1rem/1.15 'Newsreader',serif;color:#2A2416}
  .cx-rc .v.mono{font-family:'Spline Sans Mono',monospace;color:#9A6B18;font-weight:600;font-size:.9rem}
  .cx-rc .v.amt{font:600 1.25rem/1 'Fraunces',serif;color:#8A5A0F}

  .cx-titlebar{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;gap:12px;flex-wrap:wrap}
  .cx-titlebar h1{font:500 22px/1.15 'Newsreader',serif;margin:0}
  .cx-ref{font:600 11.5px/1 'Spline Sans Mono',monospace;color:#1E4FBF;background:rgba(30,79,191,.09);padding:.4em .65em;border-radius:6px;margin-right:8px}
  .cx-pill{font:600 10px/1 'Inter',system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#0D9F6E;background:rgba(13,159,110,.1);border:1px solid rgba(13,159,110,.28);padding:.5em .75em;border-radius:999px}

  /* timeline */
  .cx-timeline{list-style:none;position:relative;margin:12px 0 0 6px;padding:0}
  .cx-timeline li{position:relative;padding:0 0 14px 18px;border-left:2px solid #DCE3EF;font-size:12px}
  .cx-timeline li:last-child{border-left-color:transparent;padding-bottom:0}
  .cx-timeline .dot{position:absolute;left:-6px;top:2px;width:10px;height:10px;border-radius:50%;background:#1E4FBF;border:2px solid #fff}
  .cx-timeline .dot.gold{background:#C9A227}
  .cx-timeline .dot.green{background:#0D9F6E}
  .cx-timeline .when{font-size:10.5px;color:#7A879C;margin-top:2px}
  .cx-timeline b{font-weight:600}

  /* invite / status */
  .cx-status{display:flex;gap:8px;padding:9px 11px;border-radius:9px;background:#F4F6FA;border:1px solid #DCE3EF;border-left:3px solid #C9A227;margin:9px 0}
  .cx-status b{font-size:12px;display:block}.cx-status span{font-size:11px;color:#4A5568}
  .cx-link{margin-top:9px;font:500 10.5px/1.4 'Spline Sans Mono',monospace;color:#4A5568;background:#F4F6FA;border:1px dashed #C8D2E4;border-radius:8px;padding:7px 9px;word-break:break-all}

  /* buttons */
  .cx-btn{font:600 13px/1 'Inter',system-ui,sans-serif;color:#fff;background:#1E4FBF;border:none;border-radius:8px;padding:10px 16px;cursor:pointer}
  .cx-btn:hover{background:#163A8F}
  .cx-btn:disabled{opacity:.55;cursor:default}
  .cx-btn.full{width:100%;text-align:center;display:block}
  .cx-btn.ghost{background:transparent;color:#0F1C2E;border:1px solid #DCE3EF}
  .cx-btn.ghost:hover{border-color:#0F1C2E;background:#F4F6FA}
  .cx-btn.sm{padding:7px 14px;font-size:12px}

  /* mediator */
  .cx-mediator{background:linear-gradient(145deg,#0B1F3A,#163A6B);color:#fff;border-radius:12px;padding:16px}
  .cx-mediator .mb{font:500 .95rem/1.2 'Fraunces',serif}
  .cx-mediator .ms{font-size:.76rem;color:rgba(255,255,255,.7);margin:4px 0 11px;line-height:1.45}
  .cx-mediator .mbtn{width:100%;font-weight:600;font-size:.84rem;color:#0B1F3A;background:#C9A227;border:none;border-radius:8px;padding:10px;cursor:pointer}
  .cx-mediator .mbtn:disabled{opacity:.7;cursor:default}

  /* private notes */
  .cx-notes textarea{width:100%;min-height:110px;resize:vertical;border:1px solid #DCE3EF;border-radius:9px;padding:10px 12px;font:inherit;font-size:13px;line-height:1.5;color:#0F1C2E;background:#FAFBFD;outline:none}
  .cx-notes textarea:focus{border-color:#1E4FBF;background:#fff}
  .cx-notes-meta{display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-size:11px;color:#7A879C}
  .cx-notes-meta .lock{display:flex;align-items:center;gap:4px}

  /* documents */
  .cx-drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:72px;border:1.5px dashed #C2CBD9;border-radius:10px;background:#FBFCFF;text-align:center;padding:12px;cursor:pointer;color:#4A5568}
  .cx-drop strong{font-size:12.5px;color:#0F1C2E}.cx-drop span{font-size:10.5px}
  .cx-file{display:flex;align-items:center;gap:9px;border:1px solid #DCE3EF;border-radius:10px;padding:10px;background:#F4F6FA;text-decoration:none;color:inherit}
  .cx-file .fi{width:26px;height:26px;border-radius:6px;background:rgba(30,79,191,.09);color:#1E4FBF;display:grid;place-items:center;font:700 7.5px/1 'Inter',system-ui,sans-serif;flex:none}
  .cx-file .fn{font-size:11.5px;font-weight:500}.cx-file .fs{font-size:10px;color:#7A879C;margin-top:1px}

  /* scale inputs */
  .cx-scale{padding:18px 20px}
  .cx-scale-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
  .cx-rolechip{font:700 .58rem/1 'Inter',system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#1E4FBF;background:rgba(30,79,191,.09);padding:.45em .65em;border-radius:999px}
  .cx-chips{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px}
  .cx-chip{border:1px solid #DCE3EF;border-radius:10px;padding:10px 12px;background:#FAFBFD}
  .cx-chip .k{font:700 .55rem/1 'Inter',system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#4A5568;margin-bottom:6px}
  .cx-chip input{width:100%;border:1px solid #DCE3EF;border-radius:7px;padding:7px 9px;font:600 .95rem/1 'Spline Sans Mono',monospace;color:#0F1C2E;background:#fff;outline:none}
  .cx-chip input:focus{border-color:#1E4FBF}
  .cx-chip.ideal .k{color:#5B4AD8}
  .cx-chip.target .k{color:#1E4FBF}
  .cx-chip.walk .k{color:#9A6B18}
  .cx-oneway{margin:12px 0;padding:9px 12px;border-radius:9px;background:rgba(30,79,191,.07);border:1px solid rgba(30,79,191,.22);font-size:11.5px;color:#4A5568;line-height:1.45}
  .cx-acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px;align-items:center}
  .cx-hint{font-size:12px;color:#4A5568}

  @media(max-width:900px){
    .cx-grid{grid-template-columns:1fr}
    .cx-ribbon{grid-template-columns:1fr 1fr}
  }
</style>

<%
  var otherJoined = !!(c.claimant_id && c.respondent_id);
  var liveCase = ['settled','closed','declined'].indexOf(c.status) === -1;
  var inviteUrlSafe = (typeof inviteUrl !== 'undefined' && inviteUrl) ? inviteUrl : '';
  var myIdeal = (role === 'claim' ? c.claim_ideal : c.resp_ideal);
  var myFair  = (role === 'claim' ? c.claim_fair  : c.resp_fair);
  var myRes   = (role === 'claim' ? c.claim_value : c.resp_value);
  var privateNotes = (typeof privateNotes !== 'undefined') ? privateNotes
                   : (c.private_notes || '');
  var mediatorAlready = !!(c.mediator_requested || (typeof status !== 'undefined' && status && status.mediatorRequested));
%>

<div class="wrap-wide" style="max-width:1180px;margin:0 auto;padding:0 22px 48px">

  <div class="cx-titlebar">
    <div>
      <span class="cx-ref">Case MB-<%= c.id %></span>
      <h1><%= c.title %></h1>
    </div>
    <% if (c.status === 'settled') { %>
      <span class="cx-pill">● Settled</span>
    <% } else if (liveCase) { %>
      <span class="cx-pill">● Active</span>
    <% } else { %>
      <span class="cx-pill" style="color:#586079;background:#F4F6FA;border-color:#DCE3EF">● <%= c.status %></span>
    <% } %>
  </div>

  <!-- Summary ribbon -->
  <div class="cx-card cx-ribbon">
    <div class="cx-rc">
      <div class="k">Case reference</div>
      <div class="v mono">MB-<%= c.id %></div>
    </div>
    <div class="cx-rc">
      <div class="k">Claimant</div>
      <div class="v"><%= c.claim_full_name || (role === 'claim' ? 'You' : '—') %></div>
    </div>
    <div class="cx-rc">
      <div class="k">Respondent</div>
      <div class="v"><%= c.resp_full_name || (role === 'resp' ? 'You' : (c.other_email || 'Awaiting')) %></div>
    </div>
    <div class="cx-rc">
      <div class="k">Original amount</div>
      <div class="v amt"><%= money(c.amount, c.currency) %></div>
    </div>
  </div>

  <div class="cx-grid">

    <!-- LEFT COLUMN -->
    <div class="cx-stack">

      <!-- Timeline -->
      <div class="cx-card cx-pad">
        <span class="cx-eyebrow">Case activity</span>
        <h3 class="cx-h">Timeline</h3>
        <ul class="cx-timeline">
          <li>
            <span class="dot green"></span>
            <b>Case opened</b>
            <div class="when"><%= fmtDate(c.created_at) %></div>
          </li>
          <% if (c.invited_at) { %>
          <li>
            <span class="dot gold"></span>
            <b>Invitation sent</b>
            <div class="when"><%= fmtDate(c.invited_at) %></div>
          </li>
          <% } %>
          <% if (myRes != null) { %>
          <li>
            <span class="dot"></span>
            <b>Your figures saved</b>
            <div class="when">—</div>
          </li>
          <% } %>
          <% if (c.status === 'settled') { %>
          <li>
            <span class="dot green"></span>
            <b>Settled at <%= money(c.settled_value, c.currency) %></b>
            <div class="when"><%= fmtDate(c.settled_at) %></div>
          </li>
          <% } else { %>
          <li>
            <span class="dot"></span>
            <b><%= otherJoined ? 'Both parties on the case' : 'Awaiting the other party' %></b>
            <div class="when">Current</div>
          </li>
          <% } %>
        </ul>
      </div>

      <!-- Invite -->
      <div class="cx-card cx-pad">
        <span class="cx-eyebrow">The other party</span>
        <h3 class="cx-h">Invite the respondent</h3>
        <% if (otherJoined) { %>
          <div class="cx-status" style="border-left-color:#0D9F6E">
            <div><b>Invitation accepted</b><span>The other party has joined the case.</span></div>
          </div>
        <% } else { %>
          <div class="cx-status">
            <div>
              <b><%= (c.invite_count && c.invite_count > 0) ? 'Invitation sent' : 'Not yet invited' %></b>
              <span><%= c.invited_at ? ('Last sent ' + fmtDate(c.invited_at)) : 'Send an invitation to get started.' %></span>
            </div>
          </div>
          <form method="post" action="/cases/<%= c.id %>/invite" style="margin-top:8px">
            <button type="submit" class="cx-btn full">
              <%= (c.invite_count && c.invite_count > 0) ? 'Resend invitation' : 'Send invitation' %>
            </button>
          </form>
          <% if (inviteUrlSafe) { %>
            <div class="cx-link" id="inviteBox"><%= inviteUrlSafe %></div>
            <button type="button" class="cx-btn ghost sm" style="margin-top:8px" id="copyBtn">Copy link</button>
          <% } %>
        <% } %>
      </div>

      <!-- Mediator -->
      <div class="cx-mediator">
        <div class="mb">Bring in a mediator</div>
        <div class="ms">Accredited human mediator. Both parties must agree before a session is scheduled.</div>
        <button type="button" class="mbtn" id="mediatorBtn" <%= mediatorAlready ? 'disabled' : '' %>>
          <%= mediatorAlready ? 'Mediator requested' : 'Request mediator' %>
        </button>
        <div class="ms" id="mediatorLbl" style="margin:8px 0 0"></div>
      </div>

    </div>

    <!-- RIGHT COLUMN -->
    <div class="cx-stack">

      <!-- Private figures -->
      <div class="cx-card cx-scale">
        <div class="cx-scale-top">
          <span class="cx-eyebrow" style="margin:0">Your private figures</span>
          <span class="cx-rolechip">You — <%= role === 'claim' ? 'Claimant' : 'Respondent' %></span>
        </div>

        <form id="figuresForm">
          <div class="cx-chips">
            <div class="cx-chip ideal">
              <div class="k">Ideal</div>
              <input type="number" name="ideal" id="figIdeal" step="any" min="0"
                     value="<%= myIdeal != null ? myIdeal : '' %>"
                     placeholder="Best case"
                     <%= !liveCase ? 'readonly' : '' %> required>
            </div>
            <div class="cx-chip target">
              <div class="k">Target</div>
              <input type="number" name="fair" id="figFair" step="any" min="0"
                     value="<%= myFair != null ? myFair : '' %>"
                     placeholder="Realistic figure"
                     <%= !liveCase ? 'readonly' : '' %> required>
            </div>
            <div class="cx-chip walk">
              <div class="k"><%= role === 'claim' ? 'Walk-away' : 'Ceiling' %></div>
              <input type="number" name="reservation" id="figRes" step="any" min="0"
                     value="<%= myRes != null ? myRes : '' %>"
                     placeholder="<%= role === 'claim' ? 'Least you accept' : 'Most you will pay' %>"
                     <%= !liveCase ? 'readonly' : '' %> required>
            </div>
          </div>

          <div class="cx-oneway">
            One-way only — each committed figure moves toward settlement and cannot be withdrawn once submitted for this round.
          </div>

          <% if (liveCase) { %>
          <div class="cx-acts">
            <button type="submit" class="cx-btn" id="saveBtn">Save figures</button>
            <button type="button" class="cx-btn ghost" id="resetBtn">Reset</button>
            <span class="cx-hint" id="saveHint"></span>
          </div>
          <% } %>
        </form>
      </div>

      <!-- Private notes -->
      <div class="cx-card cx-pad cx-notes">
        <span class="cx-eyebrow">Private notes</span>
        <h3 class="cx-h">Your working notes</h3>
        <p class="cx-muted" style="margin:4px 0 10px">Visible only to you. Never shared with the other party or shown in any settlement record.</p>
        <form method="post" action="/cases/<%= c.id %>/notes" id="notesForm">
          <textarea name="notes" id="notesField" placeholder="Record context, solicitor advice, or your thinking for this case…" maxlength="4000"><%= privateNotes %></textarea>
          <div class="cx-notes-meta">
            <span class="lock">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              Private to you
            </span>
            <button type="submit" class="cx-btn sm">Save notes</button>
          </div>
        </form>
      </div>

      <!-- Documents -->
      <div class="cx-card cx-pad" id="documents">
        <span class="cx-eyebrow">Documents</span>
        <h3 class="cx-h">Supporting files</h3>
        <form method="post" action="/cases/<%= c.id %>/documents" enctype="multipart/form-data" style="margin-top:10px">
          <label class="cx-drop" for="docInput">
            <strong>Add files</strong>
            <span>PDF, Word or images · max 5 MB each</span>
          </label>
          <input type="file" name="documents" id="docInput" multiple
                 accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,.txt,.csv"
                 style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden"
                 onchange="this.form.submit()">
        </form>
        <% if (typeof docs !== 'undefined' && docs && docs.length) { %>
          <div class="cx-stack" style="margin-top:10px">
            <% docs.forEach(function(d){ %>
              <a class="cx-file" href="/cases/<%= c.id %>/documents/<%= d.id %>" target="_blank" rel="noopener">
                <span class="fi"><%= (d.mime||'').indexOf('pdf') >= 0 ? 'PDF' : 'DOC' %></span>
                <div>
                  <div class="fn"><%= d.filename %></div>
                  <div class="fs"><%= d.size ? (Math.round(d.size/1024) + ' KB') : '' %></div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<script>
(function () {
  var CASE_ID = <%= Number(c.id) %>;

  // Copy invite link
  var copyBtn = document.getElementById('copyBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      var box = document.getElementById('inviteBox');
      if (!box) return;
      var text = box.textContent.trim();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          copyBtn.textContent = 'Copied!';
          setTimeout(function () { copyBtn.textContent = 'Copy link'; }, 1500);
        });
      } else {
        // Fallback
        var ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); copyBtn.textContent = 'Copied!'; } catch (e) {}
        document.body.removeChild(ta);
        setTimeout(function () { copyBtn.textContent = 'Copy link'; }, 1500);
      }
    });
  }

  // Mediator — uses existing JSON endpoint POST /cases/:id/mediator
  var mediatorBtn = document.getElementById('mediatorBtn');
  var mediatorLbl = document.getElementById('mediatorLbl');
  if (mediatorBtn && !mediatorBtn.disabled) {
    mediatorBtn.addEventListener('click', function () {
      mediatorBtn.disabled = true;
      if (mediatorLbl) mediatorLbl.textContent = 'Requesting…';
      fetch('/cases/' + CASE_ID + '/mediator', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin',
        body: ''
      })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function () {
          if (mediatorLbl) mediatorLbl.textContent = '✓ Human mediator requested';
          mediatorBtn.textContent = 'Mediator requested';
        })
        .catch(function () {
          mediatorBtn.disabled = false;
          if (mediatorLbl) mediatorLbl.textContent = 'Could not send request — try again.';
        });
    });
  }

  // Figures — posts to existing POST /cases/:id/bid with ideal, fair, reservation
  var figuresForm = document.getElementById('figuresForm');
  var saveBtn = document.getElementById('saveBtn');
  var saveHint = document.getElementById('saveHint');
  var resetBtn = document.getElementById('resetBtn');
  var idealEl = document.getElementById('figIdeal');
  var fairEl  = document.getElementById('figFair');
  var resEl   = document.getElementById('figRes');

  var savedIdeal = idealEl ? idealEl.value : '';
  var savedFair  = fairEl  ? fairEl.value  : '';
  var savedRes   = resEl   ? resEl.value   : '';

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      if (idealEl) idealEl.value = savedIdeal;
      if (fairEl)  fairEl.value  = savedFair;
      if (resEl)   resEl.value   = savedRes;
      if (saveHint) saveHint.textContent = '';
    });
  }

  if (figuresForm) {
    figuresForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!idealEl || !fairEl || !resEl) return;

      var ideal = String(idealEl.value).trim();
      var fair  = String(fairEl.value).trim();
      var res   = String(resEl.value).trim();

      if (!ideal || !fair || !res) {
        if (saveHint) saveHint.textContent = 'Enter all three figures.';
        return;
      }

      if (saveBtn) saveBtn.disabled = true;
      if (saveHint) saveHint.textContent = 'Submitting…';

      var body =
        'ideal=' + encodeURIComponent(ideal) +
        '&fair=' + encodeURIComponent(fair) +
        '&reservation=' + encodeURIComponent(res);

      fetch('/cases/' + CASE_ID + '/bid', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin',
        body: body
      })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (s) {
          if (s && s.error) {
            if (saveHint) saveHint.textContent = s.error;
            if (saveBtn) saveBtn.disabled = false;
            return;
          }
          savedIdeal = ideal;
          savedFair  = fair;
          savedRes   = res;
          if (saveHint) saveHint.textContent = 'Submitted.';
          setTimeout(function () { window.location.reload(); }, 700);
        })
        .catch(function () {
          if (saveBtn) saveBtn.disabled = false;
          if (saveHint) saveHint.textContent = 'Could not submit — try again.';
        });
    });
  }
})();
</script>

<%- include('partials/foot') %>

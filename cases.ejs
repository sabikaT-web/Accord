<%
  // CASES / ledger — shared sidebar shell + beige theme. Data: cases, me, money().
  const isNoDeal  = (c) => ['closed','declined'].includes(c.status);
  const activeN   = cases.filter(c => !['settled','declined','closed'].includes(c.status)).length;
  const settledN  = cases.filter(c => c.status === 'settled').length;
  const nodealN   = cases.filter(isNoDeal).length;
  const mineC     = cases.filter(c => c.claimant_id === me.id);
%>
<%- include('partials/app-head', { active: '', title: 'Cases' }) %>
<style>
  .tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:14px;overflow-x:auto}
  .tab{font:600 .82rem/1 "Hanken Grotesk",sans-serif;color:var(--muted);background:none;border:none;border-bottom:2px solid transparent;padding:10px 14px;margin-bottom:-1px;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:7px}
  .tab:hover{color:var(--navy)}.tab.on{color:var(--navy);border-bottom-color:var(--cobalt)}
  .tab .n{font:700 .64rem/1 "Spline Sans Mono",monospace;background:#f1e8cf;color:var(--muted);padding:2px 7px;border-radius:999px}
  .tab.on .n{background:var(--cobsoft);color:var(--cobalt)}
  .sheet{background:var(--paper);border:1px solid var(--line);border-radius:14px;overflow:hidden}
  .scroll{overflow-x:auto}
  table{width:100%;border-collapse:collapse;font-size:.9rem}
  thead th{text-align:left;font:500 .58rem/1 "Spline Sans Mono",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:11px 16px;border-bottom:1px solid var(--line);background:#faf3e0;white-space:nowrap}
  thead th.r{text-align:right}
  tbody td{padding:14px 16px;border-bottom:1px solid #f1e8cf;vertical-align:middle;white-space:nowrap}
  tbody td.r{text-align:right}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:#fbf4e2}
  .cn{font:500 1rem/1.2 "Newsreader",Georgia,serif;color:var(--ink)}
  .cn a{color:var(--ink);text-decoration:none}.cn a:hover{color:var(--cobalt)}
  .cp{font:400 .74rem/1 "Spline Sans Mono",monospace;color:var(--faint);margin-top:4px}
  .amt{font:500 .95rem/1 "Fraunces",Georgia,serif;color:var(--navy);font-variant-numeric:tabular-nums}
  .role{font:600 .64rem/1 "Spline Sans Mono",monospace;color:var(--muted);margin-top:4px;text-transform:uppercase;letter-spacing:.05em}
  .fig{font:500 .86rem/1 "Spline Sans Mono",monospace;color:var(--ink);font-variant-numeric:tabular-nums;display:inline-flex;align-items:center;gap:6px}
  .fig svg{width:12px;height:12px;color:var(--faint)}.fig .ns{color:#b3a684;font-style:italic;font-family:"Newsreader",Georgia,serif}
  .pill{font:600 .62rem/1 "Spline Sans Mono",monospace;padding:5px 10px;border-radius:999px;white-space:nowrap}
  .pill.bidding{background:var(--cobsoft);color:var(--cobalt)}.pill.awaiting,.pill.draft{background:var(--ambersoft);color:#96640f}.pill.settled{background:var(--greensoft);color:var(--greend)}.pill.closed{background:#f0e8d2;color:var(--muted)}
  .btn{font:600 .7rem/1 "Hanken Grotesk",sans-serif;padding:7px 13px;border-radius:8px;text-decoration:none;border:1px solid transparent}
  .btn.go{background:var(--green);color:#fff}.btn.go:hover{background:#268a4f}
  .btn.ghost{background:var(--paper);border-color:#d8cba6;color:var(--cobalt)}.btn.ghost:hover{border-color:var(--cobalt)}
  .btn.link{color:var(--muted);padding:7px 6px}.btn.link:hover{color:var(--cobalt)}
  .foot{padding:12px 16px;border-top:1px solid var(--line);color:var(--muted);font-size:.8rem}
  .empty{padding:34px 16px;text-align:center;color:var(--muted)}.empty a{color:var(--cobalt);font-weight:600;text-decoration:none}
</style>

<div class="topbar">
  <div class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input type="text" placeholder="Search cases or counterparties…"></div>
  <div class="tb-sp"></div>
  <% if (mineC.length) { %><button type="button" class="exp" onclick="downloadMine()">&#8595; Export</button><% } %>
  <a class="newc" href="/cases/new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Open new case</a>
</div>

<div class="content">
  <div class="phead"><div><h1>Cases</h1><p>Your blind-bidding pipeline. Your figures stay private — only a settled amount is ever shared.</p></div></div>

  <div class="tabs">
    <button type="button" class="tab on" data-tab="active">Active <span class="n"><%= activeN %></span></button>
    <button type="button" class="tab" data-tab="settled">Settled <span class="n"><%= settledN %></span></button>
    <button type="button" class="tab" data-tab="nodeal">No deal <span class="n"><%= nodealN %></span></button>
    <button type="button" class="tab" data-tab="all">All <span class="n"><%= cases.length %></span></button>
  </div>

  <div class="sheet">
    <div class="scroll">
      <table>
        <thead><tr><th>Case / counterparty</th><th>Disputed amount</th><th>Your figure</th><th>Status</th><th class="r">Action</th></tr></thead>
        <tbody>
          <% if (cases.length === 0) { %><tr><td colspan="5"><div class="empty">No cases yet — <a href="/cases/new">open your first dispute →</a></div></td></tr><% } %>
          <% cases.forEach(function(c){
               const mine = c.claimant_id === me.id;
               const settled = c.status === 'settled';
               const nodeal = ['closed','declined'].includes(c.status);
               const cat = settled ? 'settled' : (nodeal ? 'nodeal' : 'active');
               const stg = settled ? 'settled' : (nodeal ? 'closed' : (c.stage === 'bidding' ? 'bidding' : (c.stage === 'draft' ? 'draft' : 'awaiting')));
               const stL = ({settled:'Settled',closed:'No deal',bidding:'In bidding',draft:'Draft',awaiting:'Awaiting'})[stg]; %>
            <tr data-cat="<%= cat %>">
              <td><div class="cn"><a href="/cases/<%= c.id %>"><%= c.title %></a></div><div class="cp">MB-<%= c.id %> &middot; <%= c.other_email || 'no counterparty yet' %></div></td>
              <td><div class="amt"><%= settled && c.settled_value != null ? money(c.settled_value, c.currency) : money(c.amount, c.currency) %></div><div class="role"><%= mine ? 'Claimant' : 'Respondent' %><%= settled ? ' · settled' : '' %></div></td>
              <td><span class="fig"><% if (c.myLastBid != null) { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><%= money(c.myLastBid, c.currency) %><% } else { %><span class="ns">not set</span><% } %></span></td>
              <td><span class="pill <%= stg %>"><%= stL %></span></td>
              <td class="r"><% if (settled) { %><% if (!mine) { %><a class="btn go" href="/cases/<%= c.id %>">Pay</a><% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">View</a><% } %><% } else if (nodeal) { %><a class="btn ghost" href="/cases/<%= c.id %>">View</a><% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">Open</a><% if (stg === 'awaiting' && mine) { %><a class="btn link" href="/cases/<%= c.id %>#inviteBox">Resend</a><% } %><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="foot"><span id="cnt"><%= activeN %></span> shown &middot; <%= cases.length %> total</div>
  </div>
</div>

<script>
(function(){
  var tabs=document.querySelectorAll('.tab'),rows=document.querySelectorAll('tbody tr[data-cat]'),cnt=document.getElementById('cnt');
  function apply(f){var n=0;rows.forEach(function(r){var s=(f==='all'||r.dataset.cat===f);r.style.display=s?'':'none';if(s)n++;});if(cnt)cnt.textContent=n;}
  tabs.forEach(function(t){t.addEventListener('click',function(){tabs.forEach(function(x){x.classList.remove('on');});t.classList.add('on');apply(t.dataset.tab);});});
  apply('active');
})();
</script>
<% if (mineC.length) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {'MidBid case ID': c.id,'Debtor Company': c.title,'Debtor Email': c.other_email || '','Amount in dispute': c.amount,'Currency': c.currency,'MidBid status': c.stage,'Settled amount': c.settled_value == null ? '' : c.settled_value}; })) %>;
function downloadMine(){if(!MINE.length){alert('You have no cases of your own to download.');return;}var ws=XLSX.utils.json_to_sheet(MINE),wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'My cases');XLSX.writeFile(wb,'midbid-cases.xlsx');}
</script>
<% } %>
<%- include('partials/app-foot') %>

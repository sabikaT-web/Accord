<% var title="Cases"; var active=""; %>
<%
  // CASES / ledger — greige Glass Pop B. Role colour only on rows (gold = owed, blue = owe).
  const isNoDeal  = (c) => ['closed','declined'].includes(c.status);
  const activeN   = cases.filter(c => !['settled','declined','closed'].includes(c.status)).length;
  const settledN  = cases.filter(c => c.status === 'settled').length;
  const nodealN   = cases.filter(isNoDeal).length;
  const mineC     = cases.filter(c => c.claimant_id === me.id);
%>
<%
  // Shared APP SHELL (left sidebar) for all inside pages. Include this at the top of
  // a page, add the page style and a .content block, then include app-foot at the
  // end. Pass active (overview | analytics | account) and title. Uses res.locals me.
  // This file lives at the repo root; the boot step copies it into views/partials.
  const _u = (me && (me.company_name || me.username || me.name)) || 'Account';
  const _ini = _u.replace(/[^A-Za-z ]/g,'').split(' ').filter(Boolean).slice(0,2).map(s => s[0].toUpperCase()).join('') || 'M';
  const _act = (typeof active !== 'undefined') ? active : '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MidBid · <%= (typeof title !== 'undefined') ? title : 'MidBid' %></title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Hanken+Grotesk:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    /* greige base */
    --bg:#d8d4cc; --paper:#f7f3eb; --surface:#f7f3eb; --surface2:#f3efe6;
    --ink:#1a1814; --navy:#1a1814; --muted:#6a6358; --faint:#8f877a; --line:#ebe4d6;
    /* stage / accent colours remapped to the greige palette (same var names the pages read) */
    --cobalt:#3d5a80; --cobalt-deep:#2c4a6e; --cobsoft:#e8eef6;
    --green:#4d7c5a; --greend:#3c6349; --greensoft:#e8f0ea;
    --amber:#c27803; --ambersoft:#fef6e4;
    --gold:#c27803; --gold2:#e8a317; --gold-soft:#fef6e4; --gold-border:#e8d4a8; --gold-text:#8a5a12;
  }
  body{font-family:"Hanken Grotesk",system-ui,sans-serif;color:var(--ink);
    background:var(--bg);min-height:100vh;display:flex}
  .seam{position:fixed;top:0;left:0;right:0;height:2px;z-index:50;background:linear-gradient(90deg,#3d5a80,#4d7c5a 50%,#c27803)}

  /* Sidebar — light greige */
  .side{width:224px;flex:none;background:var(--surface);border-right:1px solid var(--line)}
  .side-in{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;overflow-y:auto}
  .side .brand{display:flex;align-items:center;gap:11px;padding:22px 20px 20px;border-bottom:1px solid var(--line)}
  .side .brand svg{width:30px;height:25px;flex:none;overflow:visible}
  .side .brand b{font:600 1.22rem/1 "Fraunces",Georgia,serif;color:var(--ink);letter-spacing:.004em}
  .side nav{flex:1;padding:16px 14px;display:flex;flex-direction:column;gap:2px}
  .side nav a{display:flex;align-items:center;gap:13px;padding:10px 13px;border-radius:9px;text-decoration:none;color:var(--muted);font:500 .875rem/1 "Hanken Grotesk",sans-serif;letter-spacing:.004em;border-left:2px solid transparent;transition:color .15s,background .15s}
  .side nav a svg{width:18px;height:18px;flex:none;opacity:.8}
  .side nav a:hover{color:var(--ink);background:var(--surface2)}
  .side nav a.on{color:var(--gold-text);background:var(--gold-soft);border-left-color:var(--gold)}
  .side nav a.on svg{opacity:1}
  .side .sep{height:1px;background:var(--line);margin:12px 14px}
  .side .who{display:flex;align-items:center;gap:11px;padding:16px 20px;border-top:1px solid var(--line)}
  .side .who .av{width:32px;height:32px;border-radius:50%;background:linear-gradient(145deg,var(--gold2),var(--gold));color:#fff;display:flex;align-items:center;justify-content:center;font:600 .74rem/1 "Spline Sans Mono",monospace;flex:none}
  .side .who .nm{font:500 .84rem/1.15 "Hanken Grotesk",sans-serif;color:var(--ink)}
  .side .who .rl{font:400 .7rem/1 "Spline Sans Mono",monospace;color:var(--muted);margin-top:3px;text-transform:capitalize}
  .side .who form{margin:0}

  .main{flex:1;min-width:0;display:flex;flex-direction:column}
  .topbar{display:flex;align-items:center;gap:14px;padding:14px 26px;border-bottom:1px solid var(--line);background:rgba(247,243,235,.6);backdrop-filter:blur(6px)}
  .search{flex:1;max-width:440px;position:relative}
  .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--faint)}
  .search input{width:100%;border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 14px 9px 36px;font:inherit;font-size:.86rem;color:var(--ink)}
  .search input:focus{outline:none;border-color:var(--gold)}
  .tb-sp{flex:1}
  .newc{font:600 .78rem/1 "Hanken Grotesk",sans-serif;padding:9px 15px;border-radius:9px;background:linear-gradient(145deg,var(--cobalt-deep),var(--cobalt));color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:7px;border:1px solid var(--cobalt)}
  .newc:hover{background:var(--cobalt-deep)}.newc svg{width:15px;height:15px}
  .exp{font:600 .74rem/1 "Spline Sans Mono",monospace;padding:9px 14px;border-radius:9px;border:1px solid var(--gold-border);background:var(--surface);color:var(--muted);cursor:pointer}
  .exp:hover{border-color:var(--gold);color:var(--gold-text)}

  .content{padding:22px 26px 40px;max-width:1240px;width:100%}
  .phead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:20px}
  .phead h1{font:600 1.75rem/1.1 "Fraunces",Georgia,serif;color:var(--navy);letter-spacing:-.01em}
  .phead p{color:var(--muted);font-size:.9rem;margin-top:6px}
  .phead .acts{display:flex;gap:8px;flex:none}

  @media(max-width:820px){
    .side{width:64px}.side .brand b,.side nav a .lbl,.side .who .nm,.side .who .rl{display:none}
    .side .brand{justify-content:center;padding:20px 0}.side nav a{justify-content:center;border-left:none}.side .who{justify-content:center}
    .search{display:none}
  }
</style>
</head>
<body>
<div class="seam"></div>

<aside class="side">
  <div class="side-in">
  <div class="brand">
    <svg viewBox="0 0 48 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs><clipPath id="mb-side-lens"><circle cx="18" cy="20" r="11"/></clipPath></defs>
      <g clip-path="url(#mb-side-lens)"><circle cx="30" cy="20" r="11" fill="#22c55e"/></g>
      <circle cx="18" cy="20" r="11" fill="none" stroke="#2563eb" stroke-width="2.4"/>
      <circle cx="30" cy="20" r="11" fill="none" stroke="#f59e0b" stroke-width="2.4"/>
      <circle cx="24" cy="3.4" r="2.3" fill="#2563eb"/><circle cx="24" cy="36.6" r="2.3" fill="#f59e0b"/>
    </svg>
    <b>MidBid</b>
  </div>
  <nav>
    <a href="/overview" class="<%= _act === 'overview' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span class="lbl">Overview</span></a>
    <a href="/analytics" class="<%= _act === 'analytics' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-6M22 20H2"/></svg><span class="lbl">Analytics</span></a>
    <div class="sep"></div>
    <a href="/account" class="<%= _act === 'account' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg><span class="lbl">My account</span></a>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <a href="/admin" class="<%= _act === 'admin' ? 'on' : '' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg><span class="lbl">Admin</span></a>
    <% } %>
    <a href="/logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="lbl">Log out</span></a>
  </nav>
  <div class="who"><div class="av"><%= _ini %></div><div><div class="nm"><%= _u %></div><div class="rl"><%= (me && me.account_type) ? me.account_type : 'individual' %></div></div></div>
  </div>
</aside>

<div class="main">


<style>
  /* Greige Glass Pop B — cases ledger */
  :root {
    --bg: #d8d4cc;
    --surface: #f7f3eb;
    --line: #ebe4d6;
    --ink: #1a1814;
    --ink2: #3a352c;
    --mut: #6a6358;
    --mut2: #8f877a;
    --blue: #3d5a80;
    --blue-deep: #2c4a6e;
    --blue-soft: #e8eef6;
    --blue-border: #b8c8dc;
    --gold: #c27803;
    --gold2: #e8a317;
    --gold-soft: #fef6e4;
    --gold-border: #e8d4a8;
    --gold-text: #8a5a12;
    --green: #4d7c5a;
    --green-deep: #3c6349;
    --green-soft: #e8f0ea;
    --green-border: #c3d8ca;
    --sans: "Plus Jakarta Sans", system-ui, sans-serif;
    --disp: "Fraunces", Georgia, serif;
    --mono: "IBM Plex Mono", "Spline Sans Mono", monospace;
  }
  .content, .topbar { font-family: var(--sans); }
  .phead h1 { font-family: var(--disp); font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
  .phead p { color: var(--mut); font-size: 0.9rem; }

  .tabs {
    display: flex; gap: 4px; border-bottom: 1px solid var(--line);
    margin-bottom: 14px; overflow-x: auto;
  }
  .tab {
    font: 600 0.82rem/1 var(--sans); color: var(--mut); background: none; border: none;
    border-bottom: 2px solid transparent; padding: 10px 14px; margin-bottom: -1px;
    cursor: pointer; white-space: nowrap; display: flex; align-items: center; gap: 7px;
  }
  .tab:hover { color: var(--ink); }
  .tab.on { color: var(--ink); border-bottom-color: var(--blue); }
  .tab .n {
    font: 700 0.64rem/1 var(--mono); background: #efe8d8; color: var(--mut);
    padding: 2px 7px; border-radius: 999px;
  }
  .tab.on .n { background: var(--blue-soft); color: var(--blue-deep); }

  .sheet {
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
    box-shadow: 0 12px 30px -24px rgba(40, 35, 25, 0.35);
  }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  thead th {
    text-align: left; font: 500 0.58rem/1 var(--mono); letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--mut2); padding: 11px 16px;
    border-bottom: 1px solid var(--line); background: #f3efe6; white-space: nowrap;
  }
  thead th.r { text-align: right; }
  tbody td {
    padding: 14px 16px; border-bottom: 1px solid var(--line);
    vertical-align: middle; white-space: nowrap;
  }
  tbody td.r { text-align: right; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: #f3efe6; }

  /* Role by colour only — claimant (owed) gold, respondent (owe) blue */
  tbody tr.role-claim { box-shadow: inset 3px 0 0 var(--gold); }
  tbody tr.role-resp { box-shadow: inset 3px 0 0 var(--blue); }
  tbody tr.role-claim:hover { background: rgba(254, 246, 228, 0.45); }
  tbody tr.role-resp:hover { background: rgba(232, 238, 246, 0.5); }

  .cn { font: 600 1rem/1.2 var(--disp); color: var(--ink); }
  .cn a { color: var(--ink); text-decoration: none; }
  .cn a:hover { color: var(--blue); }
  .cp { font: 400 0.74rem/1 var(--mono); color: var(--mut2); margin-top: 4px; }

  .amt {
    font: 600 0.95rem/1 var(--mono); color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  tr.role-claim .amt { color: var(--gold-text); }
  tr.role-resp .amt { color: var(--blue-deep); }

  .role {
    font: 600 0.64rem/1 var(--mono); margin-top: 4px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  tr.role-claim .role { color: var(--gold); }
  tr.role-resp .role { color: var(--blue); }

  .fig {
    font: 500 0.86rem/1 var(--mono); color: var(--ink);
    font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; gap: 6px;
  }
  .fig svg { width: 12px; height: 12px; color: var(--mut2); }
  .fig .ns { color: var(--mut2); font-style: italic; font-family: var(--disp); }

  .pill {
    font: 600 0.62rem/1 var(--mono); padding: 5px 10px; border-radius: 999px; white-space: nowrap;
  }
  .pill.bidding { background: var(--blue-soft); color: var(--blue-deep); border: 1px solid var(--blue-border); }
  .pill.awaiting, .pill.draft { background: var(--gold-soft); color: var(--gold-text); border: 1px solid var(--gold-border); }
  .pill.settled { background: var(--green-soft); color: var(--green-deep); border: 1px solid var(--green-border); }
  .pill.closed { background: #efe8d8; color: var(--mut); }

  /* Role overrides status pill tint slightly when active */
  tr.role-claim .pill.bidding,
  tr.role-claim .pill.awaiting,
  tr.role-claim .pill.draft {
    background: var(--gold-soft); color: var(--gold-text); border-color: var(--gold-border);
  }
  tr.role-resp .pill.bidding,
  tr.role-resp .pill.awaiting,
  tr.role-resp .pill.draft {
    background: var(--blue-soft); color: var(--blue-deep); border-color: var(--blue-border);
  }

  .btn {
    font: 700 0.7rem/1 var(--sans); padding: 7px 13px; border-radius: 8px;
    text-decoration: none; border: 1.5px solid transparent; display: inline-block;
  }
  .btn.go { background: var(--green); color: #fff; }
  .btn.go:hover { filter: brightness(1.05); }
  .btn.ghost {
    background: var(--surface); border-color: var(--line); color: var(--ink2);
  }
  .btn.ghost:hover { border-color: var(--mut2); }
  tr.role-claim .btn.ghost {
    border-color: var(--gold-border); color: var(--gold-text);
  }
  tr.role-claim .btn.ghost:hover {
    background: var(--gold-soft); border-color: var(--gold);
  }
  tr.role-resp .btn.ghost {
    border-color: var(--blue-border); color: var(--blue-deep);
  }
  tr.role-resp .btn.ghost:hover {
    background: var(--blue-soft); border-color: var(--blue);
  }
  .btn.link { color: var(--mut); padding: 7px 6px; }
  .btn.link:hover { color: var(--blue); }

  .foot {
    padding: 12px 16px; border-top: 1px solid var(--line);
    color: var(--mut); font-size: 0.8rem;
  }
  .empty { padding: 34px 16px; text-align: center; color: var(--mut); }
  .empty a { color: var(--blue); font-weight: 600; text-decoration: none; }
</style>

<div class="topbar">
  <div class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input type="text" placeholder="Search cases or counterparties…"></div>
  <div class="tb-sp"></div>
  <% if (mineC.length) { %><button type="button" class="exp" onclick="downloadMine()">&#8595; Export</button><% } %>
  <a class="newc" href="/cases/new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Open new case</a>
</div>

<div class="content">
  <div class="phead"><div><h1>Cases</h1><p>Your blind-bidding pipeline. Your figures stay private — only a settled amount is ever shared.</p></div></div>

  <div class="tabs">
    <button type="button" class="tab on" data-tab="active">Active <span class="n"><%= activeN %></span></button>
    <button type="button" class="tab" data-tab="settled">Settled <span class="n"><%= settledN %></span></button>
    <button type="button" class="tab" data-tab="nodeal">No deal <span class="n"><%= nodealN %></span></button>
    <button type="button" class="tab" data-tab="all">All <span class="n"><%= cases.length %></span></button>
  </div>

  <div class="sheet">
    <div class="scroll">
      <table>
        <thead><tr><th>Case / counterparty</th><th>Disputed amount</th><th>Your figure</th><th>Status</th><th class="r">Action</th></tr></thead>
        <tbody>
          <% if (cases.length === 0) { %><tr><td colspan="5"><div class="empty">No cases yet — <a href="/cases/new">open your first dispute →</a></div></td></tr><% } %>
          <% cases.forEach(function(c){
               const mine = c.claimant_id === me.id;
               const roleCls = mine ? 'claim' : 'resp';
               const settled = c.status === 'settled';
               const nodeal = ['closed','declined'].includes(c.status);
               const cat = settled ? 'settled' : (nodeal ? 'nodeal' : 'active');
               const stg = settled ? 'settled' : (nodeal ? 'closed' : (c.stage === 'bidding' ? 'bidding' : (c.stage === 'draft' ? 'draft' : 'awaiting')));
               const stL = ({settled:'Settled',closed:'No deal',bidding:'In bidding',draft:'Draft',awaiting:'Awaiting'})[stg]; %>
            <tr data-cat="<%= cat %>" class="role-<%= roleCls %>">
              <td>
                <div class="cn"><a href="/cases/<%= c.id %>"><%= c.title %></a></div>
                <div class="cp">MB-<%= c.id %> &middot; <%= c.other_email || 'no counterparty yet' %></div>
              </td>
              <td>
                <div class="amt"><%= settled && c.settled_value != null ? money(c.settled_value, c.currency) : money(c.amount, c.currency) %></div>
                <div class="role"><%= mine ? 'Claimant' : 'Respondent' %><%= settled ? ' · settled' : '' %></div>
              </td>
              <td>
                <span class="fig"><% if (c.myLastBid != null) { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><%= money(c.myLastBid, c.currency) %><% } else { %><span class="ns">not set</span><% } %></span>
              </td>
              <td><span class="pill <%= stg %>"><%= stL %></span></td>
              <td class="r">
                <% if (settled) { %>
                  <% if (!mine) { %><a class="btn go" href="/cases/<%= c.id %>">Pay</a>
                  <% } else { %><a class="btn ghost" href="/cases/<%= c.id %>">View</a><% } %>
                <% } else if (nodeal) { %>
                  <a class="btn ghost" href="/cases/<%= c.id %>">View</a>
                <% } else { %>
                  <a class="btn ghost" href="/cases/<%= c.id %>">Open</a>
                  <% if (stg === 'awaiting' && mine) { %><a class="btn link" href="/cases/<%= c.id %>#inviteBox">Resend</a><% } %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="foot"><span id="cnt"><%= activeN %></span> shown &middot; <%= cases.length %> total</div>
  </div>
</div>

<script>
(function(){
  var tabs=document.querySelectorAll('.tab'),rows=document.querySelectorAll('tbody tr[data-cat]'),cnt=document.getElementById('cnt');
  function apply(f){var n=0;rows.forEach(function(r){var s=(f==='all'||r.dataset.cat===f);r.style.display=s?'':'none';if(s)n++;});if(cnt)cnt.textContent=n;}
  tabs.forEach(function(t){t.addEventListener('click',function(){tabs.forEach(function(x){x.classList.remove('on');});t.classList.add('on');apply(t.dataset.tab);});});
  apply('active');
})();
</script>
<% if (mineC.length) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
var MINE = <%- JSON.stringify(mineC.map(function (c) { return {'MidBid case ID': c.id,'Debtor Company': c.title,'Debtor Email': c.other_email || '','Amount in dispute': c.amount,'Currency': c.currency,'MidBid status': c.stage,'Settled amount': c.settled_value == null ? '' : c.settled_value}; })) %>;
function downloadMine(){if(!MINE.length){alert('You have no cases of your own to download.');return;}var ws=XLSX.utils.json_to_sheet(MINE),wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'My cases');XLSX.writeFile(wb,'midbid-cases.xlsx');}
</script>
<% } %>

</div><!-- .main -->
</body>
</html>
